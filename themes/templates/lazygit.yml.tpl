git:
  overrideGpg: true
gui:
  expandFocusedSidePanel: true
  theme:
    activeBorderColor:
      - "{{ accent }}"
      - bold
    inactiveBorderColor:
      - "{{ color7 }}"
    optionsTextColor:
      - "{{ accent }}"
    selectedLineBgColor:
      - "{{ color0 }}"
    cherryPickedCommitBgColor:
      - "{{ color1 }}"
    cherryPickedCommitFgColor:
      - "{{ accent }}"
    unstagedChangesColor:
      - "{{ color1 }}"
    defaultFgColor:
      - "{{ foreground }}"
    searchingActiveBorderColor:
      - "{{ color3 }}"
