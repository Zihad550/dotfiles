{
  ////////////////////////
  // ai
  ///////////////////////
  "ssh_connections": [
    {
      "host": "devcontainer.devpod",
      "args": [],
      "projects": []
    }
  ],
  "cli_default_open_behavior": "new_window",
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "diff_view_style": "unified",
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    },
    "qwen-code": {
      "type": "registry",
    },
    "mistral-vibe": {
      "type": "registry",
    },
    "kimi": {
      "type": "registry",
    },
    "codebuddy-code": {
      "type": "registry",
    },
    "auggie": {
      "type": "registry",
    },
    "opencode": {
      "type": "registry",
    },
  },
  "agent": {
    "dock": "right",
    "default_profile": "ask",
    "inline_assistant_model": {
      "provider": "google",
      "model": "gemini-3-flash",
    },
    "commit_message_model": {
      "provider": "google",
      "model": "gemini-3-flash",
    },
    "default_model": {
      "enable_thinking": false,
      "provider": "google",
      "model": "gemini-3-flash-preview",
    },
    "model_parameters": [],
  },

  "context_servers": {
    "prisma-mcp": {
      "enabled": false,
      "settings": {},
    },
    "browser-tools-context-server": {
      "enabled": false,
      "settings": {},
    },
    "mcp-server-mui": {
      "enabled": false,
      "settings": {
        "preferred_theme": "",
        "component_filter": [""],
      },
    },
    "mcp-server-context7": {
      "enabled": false,
      "settings": {
        "default_minimum_tokens": "10000",
      },
    },
    // "MCP_DOCKER": {
    //   "source": "custom",
    //   "command": "docker",
    //   "args": ["mcp", "gateway", "run"]
    // },
    "shadcn": {
      "enabled": false,
      "command": "pnpx",
      "args": ["shadcn@latest", "mcp"],
    },
    "grep": {
      "enabled": false,
      "command": "",
      "args": ["https://mcp.grep.app"],
    },
    "playwright": {
      "enabled": false,
      "command": "pnpx",
      "args": ["@playwright/mcp@latest", "--extension"],
    },
    "chrome-devtools": {
      "enabled": false,
      "command": "pnpx",
      "args": ["chrome-devtools-mcp@latest"],
    },
  },

  ///////////////////////////
  // features
  ///////////////////////////
  "edit_predictions": {
    "provider": "zed",
    "mode": "eager",
  },
  "vim_mode": true,
  // "linked_edits": false,
  "soft_wrap": "editor_width",
  "double_click_in_multibuffer": "open",
  "autosave": "on_window_change",
  "extend_comment_on_newline": false,
  "inlay_hints": {
    "edit_debounce_ms": 0,
  },
  // "use_smartcase_search": true,
  // "use_multiline_search": true
  // search
  // "search": {
  //   "case_sensitive": true
  // },

  // "code_actions_on_format": {
  //   "source.organizeImports": true
  // },

  // "lsp_highlight_debounce": 10,

  // "lsp": {
  //   "biome": {
  //     "settings": {
  //       "require_config_file": true,
  //     },
  //   },
  // },

  // unstable
  "hide_mouse": "on_typing_and_action",

  /////////////////////
  // ui
  /////////////////////
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Mocha",
    "dark": "Catppuccin Mocha",
  },
  "tab_bar": {
    "show": false,
  },
  "theme": {
    "mode": "dark",
    "dark": "Kanagawa Wave - No Italics - custom",
    "light": "Lilac Light",
  },
  "ui_font_size": 16,
  "buffer_font_size": 16.5,
  "buffer_font_family": "JetBrains Mono",
  "relative_line_numbers": "enabled",
  "tabs": {
    "git_status": true,
    "file_icons": true,
    "show_diagnostics": "all",
  },
  "preview_tabs": {
    "enabled": true,
    "enable_keep_preview_on_code_navigation": true,
  },
  "project_panel": {
    "hide_hidden": false,
    "hide_gitignore": false,
    "dock": "right",
    "default_width": 280,
    "auto_fold_dirs": false,
    // "hide_root": true
  },
  "outline_panel": {
    "dock": "left",
  },
  "centered_layout": {
    "left_padding": 0.1,
    "right_padding": 0.1,
  },
  "minimap": {
    "show": "auto",
    "max_width_columns": 40,
    "current_line_highlight": "all",
  },

  ///////////////////////
