{
  ////////////////////////
  // ai
  ///////////////////////
  "language_models": {
    "openai_compatible": {
      "Z.ai": {
        "api_url": "https://api.z.ai/api/coding/paas/v4",
        "available_models": [
          {
            "name": "GLM-4.5",
            "display_name": null,
            "max_tokens": 128000,
            "max_output_tokens": 96000,
            "max_completion_tokens": 128000,
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": true,
              "prompt_cache_key": true,
            },
          },
          {
            "name": "GLM-4.5-Air",
            "display_name": null,
            "max_tokens": 128000,
            "max_output_tokens": 96000,
            "max_completion_tokens": 128000,
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": true,
              "prompt_cache_key": true,
            },
          },
          {
            "name": "GLM-4.5-X",
            "display_name": null,
            "max_tokens": 128000,
            "max_output_tokens": 96000,
            "max_completion_tokens": 128000,
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": true,
              "prompt_cache_key": true,
            },
          },
          {
            "name": "GLM-4.5-AirX",
            "display_name": null,
            "max_tokens": 128000,
            "max_output_tokens": 96000,
            "max_completion_tokens": 128000,
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": true,
              "prompt_cache_key": true,
            },
          },
          {
            "name": "GLM-4.5-Flash",
            "display_name": null,
            "max_tokens": 128000,
            "max_output_tokens": 96000,
            "max_completion_tokens": 128000,
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": true,
              "prompt_cache_key": true,
            },
          },
          {
            "name": "GLM-4-32B-0414-128K",
            "display_name": null,
            "max_tokens": 128000,
            "max_output_tokens": 16000,
            "max_completion_tokens": 128000,
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": true,
              "prompt_cache_key": true,
            },
          },
        ],
      },
    },
  },
  "agent": {
    "default_profile": "ask",
    "inline_assistant_model": {
      "provider": "google",
      "model": "gemini-3-flash-preview",
    },
    "default_model": {
      "provider": "google",
      "model": "gemini-2.5-flash",
    },
    "model_parameters": [],
  },
  "context_servers": {
    "prisma-mcp": {
      "enabled": false,
      "settings": {},
    },
    "browser-tools-context-server": {
      "enabled": false,
      "settings": {},
    },
    "mcp-server-mui": {
      "enabled": false,
      "settings": {
        "preferred_theme": "",
        "component_filter": [""],
      },
    },
    "mcp-server-context7": {
      "enabled": false,
      "settings": {
        "default_minimum_tokens": "10000",
      },
    },
    // "MCP_DOCKER": {
    //   "source": "custom",
    //   "command": "docker",
    //   "args": ["mcp", "gateway", "run"]
    // },
    "shadcn": {
      "enabled": false,
      "command": "pnpx",
      "args": ["shadcn@latest", "mcp"],
    },
    "grep": {
      // "url": "https://mcp.grep.app",
      "command": "",
      "args": ["https://mcp.grep.app"],
    },
    "playwright": {
      "enabled": false,
      "command": "pnpx",
      "args": ["@playwright/mcp@latest", "--extension"],
    },
    "chrome-devtools": {
      "enabled": false,
      "command": "pnpx",
      "args": ["chrome-devtools-mcp@latest"],
    },
  },

  ///////////////////////////
  // features
  ///////////////////////////
  "features": {
    "edit_prediction_provider": "zed",
  },
  "edit_predictions": {
    "mode": "eager",
  },
  "vim_mode": true,
  // "linked_edits": false,
  "soft_wrap": "editor_width",
  "double_click_in_multibuffer": "open",
  "autosave": "on_window_change",
  "extend_comment_on_newline": false,
  "inlay_hints": {
    "edit_debounce_ms": 0,
  },
  // "use_smartcase_search": true,
  // "use_multiline_search": true
  // search
  // "search": {
  //   "case_sensitive": true
  // },

  // "code_actions_on_format": {
  //   "source.organizeImports": true
  // },

  // "lsp_highlight_debounce": 10,

  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true,
      },
    },
  },

  // unstable
  "hide_mouse": "on_typing_and_movement",

  /////////////////////
  // ui
  /////////////////////
  "icon_theme": "Material Icon Theme",
  "tab_bar": {
    "show": false,
  },
  "theme": {
    "dark": "Kanagawa Wave",
    "light": "Noctis Lilac",
  },
  "ui_font_size": 16,
  "buffer_font_size": 16.5,
  "buffer_font_family": "JetBrains Mono",
  "relative_line_numbers": "enabled",
  "tabs": {
    "git_status": true,
    "file_icons": true,
    "show_diagnostics": "all",
  },
  "preview_tabs": {
    "enabled": true,
    "enable_keep_preview_on_code_navigation": true,
  },
  "project_panel": {
    "dock": "right",
    "default_width": 280,
    "auto_fold_dirs": false,
    // "hide_root": true
  },
  "outline_panel": {
    "dock": "left",
  },
  "centered_layout": {
    "left_padding": 0.1,
    "right_padding": 0,
  },
  "minimap": {
    "show": "auto",
    "max_width_columns": 40,
    "current_line_highlight": "all",
  },

  ///////////////////////
  // languages
  ////////////////////////
  "languages": {
    "Shell Script": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "shfmt",
          // Change `--indent 2` to match your preferred tab_size
          "arguments": ["--filename", "{buffer_path}", "--indent", "3"],
        },
      },
    },
  },

  //////////////////////////////
  // others
  //////////////////////////////
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },

  /////////////////////////////
  // theme overrides
  /////////////////////////////
  "theme_overrides": {
    "Kanagawa Wave": {
      "hint": "#8F96A0", // git blame

