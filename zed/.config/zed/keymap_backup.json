[
  // optional keybindings navigate docs with the same keys as ctrl+w + nav
  {
    "context": "Dock",
    "bindings": {
      "ctrl-w h": "workspace::ActivatePaneLeft",
      "ctrl-w l": "workspace::ActivatePaneRight",
      "ctrl-w k": "workspace::ActivatePaneUp",
      "ctrl-w j": "workspace::ActivatePaneDown"
    }
  },

  // others
  {
    "bindings": {
      "ctrl-b": "workspace::ToggleRightDock",
      "ctrl-j": "workspace::ToggleBottomDock",
      "ctrl-shift-b": "workspace::ToggleLeftDock",
      // selection with tab
      "tab": "menu::SelectNext",
      "shift-tab": "menu::SelectPrev",
      "ctrl-k l": "workspace::ToggleCenteredLayout"
    }
  },
  // switch suggestions
  {
    "context": "Editor && (showing_code_actions || showing_completions)",
    "bindings": {
      "up": "editor::ContextMenuPrev",
      "shift-tab": "editor::ContextMenuPrev",
      "ctrl-p": "editor::ContextMenuPrev",
      "down": "editor::ContextMenuNext",
      "tab": "editor::ContextMenuNext",
      "ctrl-n": "editor::ContextMenuNext",
      "pageup": "editor::ContextMenuFirst",
      "pagedown": "editor::ContextMenuLast"
    }
  },
  // terminal
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-n": "workspace::NewTerminal"
    }
  },
  // ******
  // **** vim
  // ****
  {
    "context": "Editor && VimControl && !VimWaiting && !menu",
    "bindings": {
      // center when scroll using ctrl-u and ctrl-d
      "ctrl-shift-u": "vim::ScrollUp",
      "ctrl-shift-d": "vim::ScrollDown",
      "ctrl-u": ["workspace::SendKeystrokes", "ctrl-shift-u z z"],
      "ctrl-d": ["workspace::SendKeystrokes", "ctrl-shift-d z z"]
    }
  },
  // center when search
  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual) && !VimWaiting && !menu",
    "bindings": {
      "ctrl-shift-n": "vim::MoveToNextMatch",
      "n": ["workspace::SendKeystrokes", "ctrl-shift-n z z"]
    }
  }

  // inline completionon
  // {
  //   "context": "Editor && inline_completion && !showing_completions",
  //   "bindings": {
  //     "right": "editor::AcceptInlineCompletion"
  //   }
  // }
]
