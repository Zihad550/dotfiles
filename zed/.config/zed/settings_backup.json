// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "context_servers": {
    "mcp-server-mui": {
      "source": "extension",
      "settings": {
        "preferred_theme": "",
        "component_filter": [""]
      }
    },
    "mcp-server-context7": {
      "source": "extension",
      "settings": {
        "default_minimum_tokens": "10000"
      }
    }
  },

  "agent": {
    "inline_assistant_model": {
      "provider": "google",
      "model": "gemini-2.5-flash"
    },
    "always_allow_tool_actions": true,
    "profiles": {
      "minimal": {
        "name": "Minimal",
        "tools": {
          "terminal": true,
          "read_file": true,
          "open": false,
          "list_directory": true,
          "grep": true,
          "find_path": true,
          "fetch": true,
          "diagnostics": true
        },
        "enable_all_context_servers": false,
        "context_servers": {
          "mcp-server-mui": {
            "tools": {
              "useMuiDocs": true,
              "fetchDocs": true
            }
          },
          "mcp-server-context7": {
            "tools": {
              "resolve-library-id": true,
              "get-library-docs": true
            }
          }
        }
      },
      "ask": {
        "name": "Ask",
        "tools": {
          "list_directory": true,
          "grep": true,
          "find_path": true,
          "fetch": true,
          "edit_file": false,
          "diagnostics": true,
          "delete_path": false,
          "create_directory": false,
          "copy_path": true
        },
        "enable_all_context_servers": true
      },
      "write": {
        "name": "Write",
        "tools": {
          "open": true,
          "read_file": true,
          "list_directory": true,
          "grep": true,
          "find_path": true,
          "fetch": true,
          "edit_file": true,
          "diagnostics": true,
          "delete_path": true,
          "create_directory": true,
          "copy_path": true
        },
        "enable_all_context_servers": true
      }
    },
    "play_sound_when_agent_done": true,
    "default_profile": "minimal",
    "default_model": {
      "provider": "google",
      "model": "gemini-2.5-pro"
    },
    "version": "2"
  },

  // "show_edit_predictions": false,
  "features": {
    "edit_prediction_provider": "zed"
  },
  "edit_predictions": {
    "mode": "subtle"
  },
  // "languages": {
  //   "TypeScript": {
  //     "show_edit_predictions": false
  //   },
  //   "Vue.js": {
  //     "show_edit_predictions": false
  //   }
  // },

  "icon_theme": "Material Icon Theme",

  "tab_bar": {
    "show": false
  },

  "theme": {
    "dark": "JetBrains New Dark",
    "light": "Catppuccin Mocha"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 16.5,
  "buffer_font_family": "JetBrains Mono",
  "relative_line_numbers": true,
  "tabs": {
    "git_status": true,
    "file_icons": true,
    "show_diagnostics": "all"
  },
  "preview_tabs": {
    "enabled": true,
    "enable_preview_from_code_navigation": true
  },
  "project_panel": {
    "dock": "right",
    "default_width": 280,
    "auto_fold_dirs": false
    // "hide_root": true
  },
  "outline_panel": {
    "dock": "left"
  },
  "completion_documentation_secondary_query_debounce": 0,
  // Whether to perform linked edits of associated ranges, if the language server supports it.
  // For example, when editing opening <html> tag, the contents of the closing </html> tag will be edited as well.
  // "linked_edits": false,
  // "soft_wrap": "bounded",
  "soft_wrap": "editor_width",
  "double_click_in_multibuffer": "open",
  "autosave": "on_window_change",
  "extend_comment_on_newline": false,
  // "use_smartcase_search": true,
  // "use_multiline_search": true
  // "centered_layout": {
  //   "left_padding": 0.1,
  //   "right_padding": 0.1
  // }

  // search
  // "search": {
  //   "case_sensitive": true
  // },

  // unstable
  "hide_mouse": "never",
  "code_actions_on_format": {
    "source.organizeImports": true
  },
  "languages": {
    "TSX": {
      "code_actions_on_format": {
        "source.organizeImports": true
      }
    },
    "Vue.js": {
      "code_actions_on_format": {
        "source.organizeImports": false
      }
    }
  }
}
