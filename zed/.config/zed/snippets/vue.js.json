{
  "Vue Component": {
    "prefix": "cc",
    "body": [
      "<script setup lang=\"ts\">",
      "$1",
      "</script>",
      "",
      "<template>",
      "    $2",
      "</template>"
    ]
  },
  "Comment Type/interfaces block": {
    "prefix": "ctb",
    "body": [
      "/*----------------------------------------------------------------------------*/",
      "/*                                                                            */",
      "/* TYPES/INTERFACES                                                           */",
      "/*                                                                            */",
      "/*----------------------------------------------------------------------------*/",
      "$0"
    ],
    "description": "Insert comment type block"
  },
  "comment VARIABLES block": {
    "prefix": "cdb",
    "body": [
      "/*----------------------------------------------------------------------------*/",
      "/*                                                                            */",
      "/* VARIABLES                                                                  */",
      "/*                                                                            */",
      "/*----------------------------------------------------------------------------*/",
      "$0"
    ],
    "description": "Insert variables type block"
  },
  "comment FUNCTIONS block": {
    "prefix": "cfb",
    "body": [
      "/*----------------------------------------------------------------------------*/",
      "/*                                                                            */",
      "/* FUNCTIONS                                                                  */",
      "/*                                                                            */",
      "/*----------------------------------------------------------------------------*/",
      "$0"
    ],
    "description": "Insert FUNCTIONS type block"
  }
}
