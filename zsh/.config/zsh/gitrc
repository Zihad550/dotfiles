#!/usr/env/bin bash
# Personal git + gh helpers.
# df-ti, df-tpr and df-tprr are scripts in ~/dotfiles/bin, so agents' non-interactive
# shells get them too; the short names below are for typing.
# alias gpsu='git push -u origin $(git rev-parse --abbrev-ref HEAD)' # push into current branch
# alias gs='git status'
# alias gss='git status --short'

# Stage everything, commit, and push the current branch, setting upstream.
gitpush() {
    if [ -z "$1" ]; then
        echo "Please provide a commit message."
        return 1
    fi

    branch=$(git symbolic-ref --short HEAD 2>/dev/null)

    if [ -z "$branch" ]; then
        echo "Not on a branch."
        return 1
    fi

    git add -A && git commit -m "$1" && git push -u origin "$branch"
}

alias_if_command git g git
alias_if_command git gaa 'git add --all'
alias_if_command git gcm 'git commit -m'
alias_if_command git gco 'git checkout'
alias_if_command git gl 'git pull'
alias_if_command git gp 'git push'
alias_if_command git grhh 'git reset --hard'
alias_if_command git gcl 'git clone'
alias_if_command git fpush 'gitpush "s"'
alias_if_command git grv 'git remote --verbose'

# ghq keeps clones in a GOPATH-style tree, so this intentionally shadows git clone.
alias_if_command ghq git-clone 'ghq get'
alias_if_command lazygit lg lazygit
alias_if_command gh gpr 'gh pr view --comments'
alias_if_command gh gi 'gh issue view --comments'
alias_if_command df-ti ti df-ti
alias_if_command df-tpr tpr df-tpr
alias_if_command df-tprr tprr df-tprr

if commands_available git gh; then
    alias gh-create-pub='git init && gh repo create --public --source=. --remote=origin && git push -u --all && gh browse'
    alias gh-create-pvt='git init && gh repo create --private --source=. --remote=origin && git push -u --all && gh browse'
fi
