#!/usr/env/bin bash
# Worktrunk (`wt`) aliases. Split out of aliasrc.

alias wtc="wt step commit"
alias wtp="wtc && gp"
alias wtl="wt list"
alias wts="wt switch"

# alias wts="wt list --format json | jq '.[].branch' | fzf | xargs -I {} wt switch {}"
wt-switch-active() {
    local branch
    branch=$(wt list --format json | jq -r '.[].branch' | fzf)
    [[ -n "$branch" ]] && wt switch "$branch"
}

# Park the current branch's work: stash (including untracked), go back to
# development, hand the branch to a worktree, then restore the stash there.
wtake() {
  local branch=$(git branch --show-current)
  [ -n "$branch" ] || { echo "not on a branch"; return 1; }
  local before=$(git rev-parse -q --verify refs/stash)
  git stash push -u -m "wtake: $branch" || return
  local after=$(git rev-parse -q --verify refs/stash)
  git switch development || return
  wt switch "$branch" || return
  [ "$before" != "$after" ] && git stash pop
}
