# Function to list directories and open the selected one in editor
# Regular function version for command line use
fzf_dir() {
    local dir
    dir=$(find ~ -maxdepth 6 -type d \( -name .local -o -name node_modules -o -name .git -o -name .obsidian-vault -o -name .var -o -name Cache -o -name cache -o -name .npm -o -name .nuget -o -name .cache -o -name Kiro -o -name .kiro -o -name .cursor -o -name Cypress -o -name cypress -o -name discord -o -name go -o -name obs-studio -o -name mpv -o -name transmission \) -prune -o -type d -print 2>/dev/null | sed "s|^$HOME/||" | sed "s|^$HOME$|~|" | fzf --bind 'ctrl-c:abort' --exit-0)

    # Check if fzf was cancelled or no selection was made
    if [[ -z $dir ]]; then
        return 1
    fi

    # Convert back to full path if it's a relative path
    if [[ "$dir" == "~" ]]; then
        echo "$HOME"
    elif [[ "$dir" != /* ]]; then
        echo "$HOME/$dir"
    else
        echo "$dir"
    fi
}

fzf_open_dir_func() {
    local editor=$1
    local dir
    dir=$(fzf_dir)

    # Check if fzf was cancelled or no selection was made
    if [[ -z $dir ]]; then
        return 1
    fi

    # If no editor parameter is provided, just cd into the directory
    if [[ -z $editor ]]; then
        echo "No editor provied"
        return 0
    fi

    # local base=$(basename $dir)
    # local address=$(hyprctl clients -j | jq -r --arg p "$base" '.[]|select((.class|test("\\b" + $p + "\\b";"i")) or (.title|test("\\b" + $p + "\\b";"i")))|.address' | head -n1)

    # if [[ -n $address ]]; then
    #    hyprctl dispatch focuswindow "address:$address" >/dev/null 2>&1
    #    return 0
    # fi

    case $editor in
    "code")
        uwsm-app -- code "$dir" && exit
        ;;
    "zed")
        # uwsm-app -- zeditor "$dir" && hyprctl dispatch focuscurrentorlast >/dev/null 2>&1 && exit
        uwsm-app -- zeditor "$dir"
        sleep 0.2
        hyprctl dispatch focuscurrentorlast >/dev/null 2>&1
        # local address

        # sleep 0.2
        # for i in {1..10}; do
        #    address=$(hyprctl activewindow -j | jq -r '.address')
        #    if [[ -n "$address" && "$address" != "null" ]]; then
        #       break
        #    fi
        #    sleep 0.2
        # done
        # hyprctl dispatch focuswindow "address:$address" >/dev/null 2>&1
        exit
        ;;
    "cursor")
        uwsm-app -- cursor "$dir" &
        disown && exit
        ;;
    "windsurf")
        uwsm-app -- windsurf "$dir" && exit
        ;;
    "kiro")
        uwsm-app -- kiro "$dir" && exit
        ;;
    "nautilus")
        uwsm-app -- nautilus "$dir" &
        disown && exit
        ;;
    "nvim")
        cd "$dir" && nvim .
        # Not adding exit here as you typically want to keep the terminal open with nvim
        ;;
    *)
        echo "Unsupported editor: $editor"
        echo "Supported editors: code, zed, nvim"
        return 1
        ;;
    esac
}

fzf_open_dir() {
    local dir
    dir=$(fzf_dir)

    if [[ -n "$ZSH_VERSION" ]]; then
        zle kill-whole-line
        [[ -z "$dir" ]] && {
            zle reset-prompt
            return 1
        }
        BUFFER="cd \"$dir\""
        zle accept-line
    else
        [[ -z "$dir" ]] && return 1
        # cd "$dir"
        builtin cd "$dir" && eza -lh --group-directories-first --icons=auto --color=auto
        pwd
    fi
}

zed_open_dir() {
    fzf_open_dir_func zed
}
fod() {
    fzf_open_dir_func nautilus
}

# run code
run() {
    if [ -z "$1" ]; then
        echo "Usage: run <filename>"
        echo "Supported extensions: .go, .js, .ts, .c, .cpp, .py"
        return 1
    fi

    local file="$1"
    if [ ! -f "$file" ]; then
        echo "Error: File '$file' not found."
        return 1
    fi

    local extension="${file##*.}"
    local basename="${file%.*}"

    case "$extension" in
    go)
        go run "$file"
        ;;
    js)
        bun run "$file"
        ;;
    ts)
        bun run "$file"
        ;;
    c)
        gcc "$file" -o "$basename" && ./"$basename"
        ;;
    cpp)
        g++ "$file" -o "$basename" && ./"$basename"
        ;;
    py)
        uv run "$file"
        ;;
    *)
        echo "Error: Unsupported file type '.$extension'."
        echo "Supported extensions: .go, .js, .ts, .c, .cpp, .py"
        return 1
        ;;
    esac
}

