gitpush() {
   if [ -z "$1" ]; then
      echo "Please provide a commit message."
      return 1
   fi

   branch=$(git symbolic-ref --short HEAD 2>/dev/null)

   if [ -z "$branch" ]; then
      echo "Not on a branch."
      return 1
   fi

   git add -A && git commit -m "$1" && git push -u origin "$branch"
}

