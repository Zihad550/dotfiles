# tailscale serve a local dev port over the tailnet; --https targets an
# HTTPS origin instead of HTTP. setup/common/setup-ts-serve installs the
# helper, so this runs without a password prompt.
ts-serve() {
    local port='' scheme=http helper=/usr/local/bin/ts-serve-helper
    while (($#)); do
        case "$1" in
        --https) scheme=https ;;
        *) port="$1" ;;
        esac
        shift
    done
    if [[ -z $port ]]; then
        echo 'usage: ts-serve PORT [--https]' >&2
        return 1
    fi
    if [[ -x $helper ]]; then
        sudo "$helper" "$port" "$scheme"
    else
        sudo tailscale serve --https="$port" "$scheme://localhost:$port"
    fi
}
