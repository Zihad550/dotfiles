      echo "Supported editors: code, zed, nvim"
      return 1
      ;;
   esac
}

# ZLE widget version for keybinding
fzf_open_dir() {
   local dir
   dir=$(fzf_dir)

   # Clear current line
   zle kill-whole-line

   # Check if fzf was cancelled or no selection was made
   if [[ -z $dir ]]; then
      zle reset-prompt
      return 1
   fi

   # Set the command line to cd command
   BUFFER="cd \"$dir\""
   zle accept-line
}

