scd() {
    # Same-named account on the remote unless SCD_REMOTE_USER says otherwise.
    local remote_user="${SCD_REMOTE_USER:-$USER}"
    local remote_dir="${PWD/#$HOME//home/$remote_user}"
    ssh -t "$@" "cd '$remote_dir' 2>/dev/null; exec \$SHELL"
}

