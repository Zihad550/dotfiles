# Function to list directories and open the selected one in editor
# Regular function version for command line use
fzf_dir() {
   local dir
   dir=$(find ~ -maxdepth 5 -type d \( -name .local -o -name node_modules -o -name .git -o -name .obsidian-vault -o -name .var -o -name Cache -o -name cache -o -name .npm -o -name .nuget -o -name .cache -o -name Kiro -o -name .kiro -o -name .cursor -o -name Cypress -o -name cypress -o -name discord -o -name go -o -name obs-studio -o -name mpv -o -name transmission \) -prune -o -type d -print 2>/dev/null | sed "s|^$HOME/||" | sed "s|^$HOME$|~|" | fzf --bind 'ctrl-c:abort' --exit-0)

   # Check if fzf was cancelled or no selection was made
   if [[ -z $dir ]]; then
      return 1
   fi

   # Convert back to full path if it's a relative path
   if [[ "$dir" == "~" ]]; then
      echo "$HOME"
   elif [[ "$dir" != /* ]]; then
      echo "$HOME/$dir"
   else
      echo "$dir"
   fi
}

fzf_open_dir_func() {
   local editor=$1
