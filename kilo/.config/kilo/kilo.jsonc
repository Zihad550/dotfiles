{
  "$schema": "https://app.kilo.ai/config.json",
  "plugin": [
    // "superpowers@git+https://github.com/obra/superpowers.git",
    "@warp-dot-dev/opencode-warp",
  ],
  "permission": {
    "bash": {
      "pnpm run build *": "allow",
      "tail *": "allow",
      "pnpm run lint *": "allow",
      "git log *": "allow",
      "head *": "allow",
      "mise run lint": "allow",
      "npm run check": "allow",
      "npm run typecheck": "allow",
      "npm run check *": "allow",
      "npm run typecheck *": "allow",
      "git status": "allow",
    },
  },
}
