#!/usr/bin/env bash
# Name a Claude tab after the latest /work-start in its session:
#   /work-start <n>     -> "<position>:working #<n>"
#   /work-start pr <n>  -> "<position>:fixing requested changes #<issue> !<n>"
# The PR's issue comes from its jd-<issue> branch; without one, "#<issue>" is
# left out.
#
# Herdr invokes this per event with HERDR_PLUGIN_EVENT_JSON, HERDR_BIN_PATH and
# HERDR_PLUGIN_STATE_DIR set. Caller-controlled: CLAUDE_PROJECTS_DIR (default
# ~/.claude/projects).

set -uo pipefail

herdr=${HERDR_BIN_PATH:-herdr}
state_dir=${HERDR_PLUGIN_STATE_DIR:?}
claude_projects=${CLAUDE_PROJECTS_DIR:-$HOME/.claude/projects}

mkdir -p "$state_dir"
exec 9>"$state_dir/plugin.lock"
flock 9

state_path() {
    printf '%s/%s' "$state_dir" "${1//[^A-Za-z0-9]/-}"
}

# Herdr labels a fresh tab with its position until someone renames it, so that
# and a label this plugin wrote are the two it may take over. Anything else
# was typed by hand and is left alone.
rename_owned() {
    local tab_id=$1 current=$2 number=$3 desired=$4
    local state mine

    state=$(state_path "$tab_id")
    mine=$(cat "$state" 2>/dev/null)
    [[ $current == "$number" || $current == "$mine" || $current =~ ^[0-9]+$ ]] || return 0
    [[ $desired == "$current" ]] && return 0
    "$herdr" tab rename "$tab_id" "$desired" >/dev/null 2>&1 || return 0
    printf '%s' "$desired" >"$state"
}

renumber_workspace() {
    local workspace_id=$1 tabs tab_id current number position work

    [[ -n $workspace_id && $workspace_id != null ]] || return 0
    tabs=$("$herdr" tab list --workspace "$workspace_id" 2>/dev/null) || return 0
    while IFS=$'\t' read -r tab_id current number position; do
        work=$(cat "$(state_path "$tab_id").work" 2>/dev/null)
        [[ -n $work ]] || continue
        rename_owned "$tab_id" "$current" "$number" "$position:$work"
    done < <(jq -r '.result.tabs | to_entries[] |
        [.value.tab_id, (.value.label // ""), (.value.number // 0), (.key + 1)] | @tsv' <<<"$tabs")
}

# Tab topology events have no pane to inspect. Their job is to keep the
# positional prefix current for labels already named.
event_type=$(jq -r 'first(.. | objects | .type? | select(. != null)) // ""' \
    <<<"${HERDR_PLUGIN_EVENT_JSON:-}" 2>/dev/null)
if [[ $event_type == tab_created || $event_type == tab_closed || $event_type == tab_moved ]]; then
    workspace_id=$(jq -r 'first(.. | objects | .workspace_id? | select(. != null)) //
        first(.. | objects | .tab?.workspace_id? | select(. != null)) // ""' \
        <<<"${HERDR_PLUGIN_EVENT_JSON:-}" 2>/dev/null)
    renumber_workspace "$workspace_id"
    exit 0
fi

# Event shapes nest the pane differently per event, so take the first pane_id
# anywhere in the payload rather than guessing the wrapper.
pane_id=$(jq -r 'first(.. | objects | select(has("pane_id")) | .pane_id)' \
    <<<"${HERDR_PLUGIN_EVENT_JSON:-}" 2>/dev/null)
[[ -n $pane_id && $pane_id != null ]] || exit 0

pane=$("$herdr" pane get "$pane_id" 2>/dev/null) || exit 0
IFS=$'\t' read -r tab_id workspace_id agent thread cwd < <(jq -r '.result.pane |
    [(.tab_id // "-"), (.workspace_id // "-"), (.agent // "-"),
     (.agent_session.value // "-"), (.foreground_cwd // .cwd // "-")] | @tsv' <<<"$pane")
[[ $tab_id != - ]] || exit 0

tab=$("$herdr" tab get "$tab_id" 2>/dev/null) || exit 0
IFS=$'\t' read -r panes number current < <(jq -r '.result.tab |
    [(.pane_count // 0), (.number // 0), (.label // "")] | @tsv' <<<"$tab")

# A shared tab has no one pane to be named after.
[[ $panes == 1 ]] || exit 0

state=$(state_path "$tab_id")

work=
transcript=
[[ $agent == claude && $thread != - && -d $claude_projects ]] &&
    transcript=$(find "$claude_projects" -type f -name "$thread.jsonl" -print -quit 2>/dev/null)
if [[ -r $transcript ]]; then
    args=$(jq -r 'select(.type == "user") | .message.content | strings
        | capture("<command-name>/work-start</command-name>\\s*<command-args>(?<a>[^<]*)</command-args>").a' \
        "$transcript" 2>/dev/null | tail -n1)
    if [[ $args =~ ^[[:space:]]*pr[[:space:]#!]*([0-9]+) || $args =~ /pulls?/([0-9]+) ]]; then
        pr=${BASH_REMATCH[1]}
        branch=
        [[ $cwd != - ]] && branch=$(git -C "$cwd" branch --show-current 2>/dev/null)
        work="fixing requested changes"
        [[ $branch =~ ^jd-([0-9]+)([-/]|$) ]] && work+=" #${BASH_REMATCH[1]}"
        work+=" !$pr"
    elif [[ $args =~ ^[[:space:]]*#?([0-9]+) ]]; then
        work="working #${BASH_REMATCH[1]}"
    fi
fi

if [[ -n $work ]]; then
    printf '%s' "$work" >"$state.work"
    renumber_workspace "$workspace_id"
    exit 0
fi

# The agent left, or a later session in the pane never ran /work-start: hand
# the label back to herdr.
[[ -e $state.work || -z $agent || $agent == - ]] || exit 0
tabs=$("$herdr" tab list --workspace "$workspace_id" 2>/dev/null) || tabs=
position=$(jq -r --arg tab_id "$tab_id" '.result.tabs | to_entries[] |
    select(.value.tab_id == $tab_id) | (.key + 1)' <<<"$tabs" 2>/dev/null)
rename_owned "$tab_id" "$current" "$number" "${position:-$number}"
rm -f "$state.work"
