{
  "version": 1,
  "layouts": {
    "HDMI-A-1+eDP-1": {
      "default": "vertical",
      "variants": {
        "vertical": {
          "monitors": [
            {
              "output": "HDMI-A-1",
              "mode": "1920x1080@75",
              "position": "0x0",
              "scale": "1",
              "transform": 1,
              "disabled": false,
              "reserved_area": {
                "top": 340,
                "right": 0,
                "bottom": 40,
                "left": 0
              }
            },
            {
              "output": "eDP-1",
              "mode": "preferred",
              "position": "0x1920",
              "scale": "1",
              "transform": 0,
              "disabled": false
            }
          ]
        },
        "horizontal": {
          "monitors": [
            {
              "output": "HDMI-A-1",
              "mode": "1920x1080@75.2",
              "position": "0x0",
              "scale": "1",
              "transform": 0,
              "disabled": false,
              "reserved_area": {
                "top": 0,
                "right": 0,
                "bottom": 0,
                "left": 0
              }
            },
            {
              "output": "eDP-1",
              "mode": "preferred",
              "position": "0x1080",
              "scale": "1",
              "transform": 0,
              "disabled": false
            }
          ]
        },
        "hdmi-only": {
          "monitors": [
            {
              "output": "HDMI-A-1",
              "mode": "1920x1080@75",
              "position": "0x0",
              "scale": "1",
              "transform": 1,
              "disabled": false,
              "reserved_area": {
                "top": 340,
                "right": 0,
                "bottom": 40,
                "left": 0
              }
            },
            {
              "output": "eDP-1",
              "disabled": true
            }
          ]
        }
      }
    },
    "eDP-1": {
      "default": "solo",
      "variants": {
        "solo": {
          "monitors": [
            {
              "output": "eDP-1",
              "mode": "preferred",
              "position": "0x0",
              "scale": "1",
              "transform": 0,
              "disabled": false
            }
          ]
        }
      }
    }
  }
}
