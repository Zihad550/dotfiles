{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(mise run *)",
      "Bash(git * main)",
      "Bash(* --version)",
      "Bash(* --help *)",
      "Bash(pnpm exec *)",
      "Bash(echo \"exit=$?\")"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git commit *)"
    ]
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "effortLevel": "high",
  "voice": {
    "enabled": true,
    "mode": "tap"
  },
  "theme": "dark"
}
