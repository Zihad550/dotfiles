{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "theme": "dark",
  "effortLevel": "high",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(mise run *)",
      "Bash(git * main)",
      "Bash(* --version)",
      "Bash(* --help *)",
      "Bash(pnpm exec *)",
      "Bash(echo \"exit=$?\")"
    ],
    "deny": ["Bash(git push *)", "Bash(git commit *)"]
  },
  "voice": {
    "enabled": true,
    "mode": "tap"
  }
}
