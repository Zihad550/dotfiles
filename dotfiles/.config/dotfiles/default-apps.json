{
  "roles": [
    {
      "key": "browser",
      "name": "System Browser",
      "description": "Open web links and SUPER+B",
      "xdg": "default-web-browser"
    },
    {
      "key": "directory-handler",
      "name": "System Directory Handler",
      "description": "Open directories for other applications",
      "xdg": "inode/directory"
    },
    {
      "key": "file-manager",
      "name": "Preferred File Manager",
      "description": "Browse a directory with SUPER+F"
    },
    {
      "key": "ai",
      "name": "Default AI App",
      "description": "Open an AI assistant with SUPER+A",
      "fallbacks": [
        "claude-desktop",
        "claude-web",
        "chatgpt-desktop",
        "chatgpt-web"
      ]
    }
  ],
