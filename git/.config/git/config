[alias]
    ; add
	ap = add --patch
	; diff
	ds = diff --staged
    ; status
    st = status -s
    sta = status
    ; config
    conf = config --global --edit
    puf = push --force-with-lease
    pu = push -u
    ; git commit -am msg, add Automatically stage modified and deleted tracked files, It does NOT stage: New untracked files
    ci = commit
    co = checkout
    sw = switch
    ; switch back to the last commit discarding all changes. But it doesn't deletes any staged changes.
    cod = checkout .
    ; remove staged changes to unstaged, HEAD = last commit i checked out
    rh = reset HEAD
    ; create branch
    br = branch
    bra = branch -a
    ; if you want to undo use, git rebase --abort
    pr = pull --rebase
    mff = merge --ff-only - ; merge the last checked branch with the current branch and don't create any merge commit.
    ; add the changes you just made to the last commit, since this small changes don't need a full commit, commit -> do more work -> amment/finished,
    ; NEVER AMEND PUSHED COMMITS!
    ; It modifies the commit history
    amend = commit -a --amend --no-edit
    ; add everything to staging
    aa = add -A
    ; removes all untracked files and directories
    cdf = clean -df
    ; worktree
    wta = worktree add
    wtl = worktree list
    wtr = worktree remove
    ; submodule
    smu = submodule update --init --recursive
    sms = submodule status
    sma = submodule add
