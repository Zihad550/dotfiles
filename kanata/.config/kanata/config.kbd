
(defcfg
  process-unmapped-keys yes
)

(defsrc
  caps a s d f r h j k l ;
)
(defvar
  tap-time 160
  hold-time 130
  a-hold-time 145
  j-hold-time 106
  k-hold-time 93
  f-hold-time 140
  d-hold-time 93
  built-in-hold-time 140
)

;; configs for external Eyboard
(defalias
  ;; CapsLock: tap for escape, hold for navigation layer
  escnav (tap-hold $tap-time $hold-time esc (layer-while-held navigation))
  ;; r: tap for r, hold for navigation layer
  rnav (tap-hold $tap-time $hold-time r (layer-while-held navigation))
  a (tap-hold $tap-time $a-hold-time a lmet)
  s (tap-hold $tap-time $hold-time s lalt)
  d (tap-hold $tap-time $d-hold-time d lsft)
  f (tap-hold $tap-time $f-hold-time f lctl)
  j (tap-hold $tap-time $j-hold-time j rctl)
  k (tap-hold $tap-time $k-hold-time k rsft)
  l (tap-hold $tap-time $hold-time l ralt)
  ; (tap-hold $tap-time $hold-time ; rmet)
)

(deflayer base
  @escnav @a @s @d @f @rnav h @j @k @l @;
)

;; Navigation layer - hjkl become arrow keys
(deflayer navigation
  _       _  _  _  _  _ left down up right _
)
