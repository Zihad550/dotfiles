(defcfg
  process-unmapped-keys yes
)

(deflocalkeys-linux mstp 166)

(defsrc
  tab  q w e r t y u i o p
  caps a s d f g h j k l ;
       z x c v b n m , . /
  esc spc ret bspc del
)
(defalias
  ;; Space: tap for space, hold for navigation layer
  spcnav (tap-hold $tap-time $layer-hold-time spc (layer-while-held navigation))
  entsym (tap-hold $tap-time $layer-hold-time ret (layer-while-held symbols))
  escmedia (tap-hold $tap-time $layer-hold-time esc (layer-while-held media))
  tabmouse (tap-hold $tap-time $layer-hold-time tab (layer-while-held mouse))
  mouseleft (movemouse-accel-left 10 1000 1 15)
  mousedown (movemouse-accel-down 10 1000 1 15)
  mouseup (movemouse-accel-up 10 1000 1 15)
  mouseright (movemouse-accel-right 10 1000 1 15)
  wheelleft (mwheel-left 50 120)
  wheeldown (mwheel-down 50 120)
  wheelup (mwheel-up 50 120)
  wheelright (mwheel-right 50 120)
  a (tap-hold $tap-time $a-hold-time a lmet)
  s (tap-hold $tap-time $hold-time s lalt)
  d (tap-hold $tap-time $d-hold-time d lsft)
  f (tap-hold $tap-time $f-hold-time f lctl)
  j (tap-hold $tap-time $j-hold-time j rctl)
  k (tap-hold $tap-time $k-hold-time k rsft)
  l (tap-hold $tap-time $hold-time l ralt)
  ; (tap-hold $tap-time $hold-time ; rmet)
  b (tap-hold $tap-time $hold-time b bspc)
  ;; Navigation numpad keys keep the home row modifiers on hold
  na (tap-hold $tap-time $a-hold-time ; lmet)
  ns (tap-hold $tap-time $hold-time 4 lalt)
  nd (tap-hold $tap-time $d-hold-time 5 lsft)
  nf (tap-hold $tap-time $f-hold-time 6 lctl)
)

(deflayer base
  @tabmouse q  w  e r t y u i o p
  esc @a @s @d    @f    g h @j    @k    @l @;
          z  x  c     v     @b n m , . /
  @escmedia @spcnav @entsym bspc del
)

;; Each layer pins the other layers' trigger keys to plain keys, so the layer
;; held first decides the next key and layers never stack (issue #155).

;; Navigation - hold Space. Right hand: arrows and editing.
;; Left hand: Miryoku-style numpad, 0 on G.
(deflayer navigation
  .   [   7 8 9 ] del  bspc pgdn pgup prnt
  -   @na @ns @nd @nf 0 left down up   right ret
      grv 1 2 3 \ end  home ins  _     _
  esc _ ret _ _
)

;; Miryoku Symbols on the left hand, with direct right-hand modifiers.
(deflayer symbols
  S-- S-[ S-7 S-8 S-9 S-] XX XX XX XX XX
  S-9 S-; S-4 S-5 S-6 S-= XX rsft rctl ralt rmet
      S-grv S-1 S-2 S-3 S-\ XX XX XX XX XX
  S-9 S-0 _ bspc del
)

;; Miryoku Media: keyboard-firmware RGB, power and Bluetooth slots are unused.
(deflayer media
  tab _ _ _ r _ XX XX XX XX XX
  esc lmet lalt lctl lsft XX XX prev vold volu next
      _ _ _ _ _ XX _ XX XX XX
  _ spc mstp pp mute
)

;; Miryoku Mouse: clipboard row, pointer row, wheel row, then button thumbs.
(deflayer mouse
  _ _ _ _ r _ C-S-z C-v C-c C-x C-z
  esc lmet lalt lctl lsft XX XX @mouseleft @mousedown @mouseup @mouseright
      _ _ _ _ _ XX @wheelleft @wheeldown @wheelup @wheelright
  esc spc mrgt mlft mmid
)
