#!/usr/bin/env bash

DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"

# Non-interactive post-install tasks only. This runs via run_step (stdin
# /dev/null, stdout -> log), so it must NOT prompt. The reboot confirmation and
# the user-facing reminders live at the end of init, after ui_done frees the
# terminal.

tldr --update

"$DOTFILES_DIR/bin/df-default-app" set browser chromium
"$DOTFILES_DIR/bin/df-default-app" set directory-handler nautilus
"$DOTFILES_DIR/bin/df-default-app" set file-manager yazi

# setup snapper
run_step "snapper config update" "$DOTFILES_DIR/setup/common/setup-snapper"

# Test if AppArmor is correctly enabled.
echo "Is app armor enabled: $(aa-enabled 2>/dev/null || echo 'unknown')"
