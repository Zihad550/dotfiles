#!/usr/bin/env bash

# arch-devbox: the arch-workstation desktop, stripped to web development.
# See README.md — it is the canonical copy of what this directory owns and why.
#
# The one thing README.md does not cover is why the step *list* below is not
# shared with ../arch-workstation/init the way everything else is. It is a copy,
# and adding a step there does not add it here. Kept a copy on purpose — the two
# instead of mise-packages, plus sshd/ufw-base/no-sleep/tuned that only exist
# here) that sharing one would mean inventing a step-manifest format to express
# the differences, which is more machinery than two 40-line lists are worth. If
# you add a step to arch-workstation's init, decide here whether this box wants it.

set -eEo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
ARCH_DEVBOX_DIR="$DOTFILES_DIR/setup/arch-devbox"
# Shared implementation lives next door; we only override the package lists.
ARCH_WORKSTATION_DIR="$DOTFILES_DIR/setup/arch-workstation"

# Own state dir, so the done-* guards (zsh-shell, apparmor) and the install log
# never collide with an arch-workstation run on the same machine.
export ARCH_SETUP_STATE_DIR="$HOME/.local/state/arch-devbox-setup"
mkdir -p "$ARCH_SETUP_STATE_DIR"
export LOG_FILE="$ARCH_SETUP_STATE_DIR/install.log"

# Consumed by utils/logging and preflight: what to call ourselves in errors, and
# what "Retry installation" should re-exec.
export ARCH_SETUP_NAME="arch-devbox"
export ARCH_SETUP_INIT="$ARCH_DEVBOX_DIR/init"

# shellcheck source=../arch-workstation/utils/logging
source "$ARCH_WORKSTATION_DIR/utils/logging"
# shellcheck source=../arch-workstation/utils/state
source "$ARCH_WORKSTATION_DIR/utils/state"
# shellcheck source=../common/hw-detect
source "$DOTFILES_DIR/setup/common/hw-detect"

CURRENT_STEP="init"

# logging (sourced above) owns the ERR/INT/TERM/EXIT traps. It calls
# on_exit_extra (if defined) last, so we drop the temporary passwordless-sudo
# rule here.
on_exit_extra() {
    "$DOTFILES_DIR/setup/common/setup-first-run-sudo" --remove 2>/dev/null
}

# Bootstrap gum so the install UI works from step 1 (silent no-op if already present).
ensure_gum || true

export ARCH_SETUP_START_EPOCH=$(date +%s)

"$ARCH_WORKSTATION_DIR/preflight"

# Passwordless access for the noisy root commands used throughout setup, so
# they never prompt mid-install. Self-removes via the cleanup trap.
"$DOTFILES_DIR/setup/common/setup-first-run-sudo"

ui_header "ARCH DEVBOX SETUP" "$(date '+%Y-%m-%d %H:%M:%S')"

run_step "system upgrade + stow" sudo pacman -Syu --noconfirm stow

# additional application icons
CURRENT_STEP="application icons"
mkdir -p "$HOME/.local/share/applications"
# Replace a stale real dir (e.g. created by an older buggy run) so ln can place
# the symlink at the exact target instead of nesting inside it.
[[ -d "$HOME/.local/share/applications/icons" && ! -L "$HOME/.local/share/applications/icons" ]] &&
    rm -rf "$HOME/.local/share/applications/icons"
ln -snf "$DOTFILES_DIR/setup/applications/icons" "$HOME/.local/share/applications/icons"

run_step "stow base" "$DOTFILES_DIR/scripts/stow/stow-base"
# backgrounds are not decoration here: df-theme-set reads
# ~/.config/backgrounds/<theme>.* and warns if the theme has no wallpaper.
run_step "stow backgrounds" "$DOTFILES_DIR/scripts/stow/stow-backgrounds"
run_step "stow hyprland" "$DOTFILES_DIR/scripts/stow/stow-hyprland"
run_step "idle ladder timings" "$DOTFILES_DIR/setup/common/setup-idle-ladder" \
    "$DOTFILES_DIR/setup/arch-devbox/idle.json"

run_step "theme" "$ARCH_WORKSTATION_DIR/theme"
run_step "gnome-theme" "$ARCH_WORKSTATION_DIR/gnome-theme"

# The omarchy repo is required, not optional: worktrunk, opencode, claude-code,
# tea and quickshell all come from it.
run_step "omarchy repos" "$ARCH_WORKSTATION_DIR/setup-omarchy-repos"
run_step "mise" "$ARCH_DEVBOX_DIR/setup-mise"
run_step "yay" "$ARCH_DEVBOX_DIR/setup-yay"

# flatpak dropped — its only dev-relevant apps were MongoDB Compass and
# Beekeeper Studio. Two lines turn it back on, and both are needed: this one
# installs flatpak and adds the flathub remote, and the "flatpak packages" step
# further down installs from it. Running the second without the first is
# `flatpak install` against a missing command.
# run_step "flatpak" "$ARCH_WORKSTATION_DIR/setup-packages/setup-flatpak"

# The CLI toolkit, fonts, coreutils replacements, and gcc come from the devbox
# package base. The client workstation no longer uses it.
run_step "pacman base" "$DOTFILES_DIR/setup/common/packages/pacman-base"
run_step "pacman apps" "$ARCH_DEVBOX_DIR/packages/pacman-apps"
# Before the devbox AUR list, not after: makepkg may fetch an AUR package's
# validpgpkeys with `gpg --recv-keys`, and dirmngr's own resolver cannot follow
# this box's DNS path. See setup/common/setup-dirmngr.
run_step "dirmngr resolver" "$DOTFILES_DIR/setup/common/setup-dirmngr"
run_step "devbox yay packages" "$ARCH_DEVBOX_DIR/packages/yay-packages"
# Off with setup-flatpak above, not independently of it — the shared list has
# live install lines, so leaving this on with flatpak uninstalled failed the
# step and dropped the run into the retry UI.
# run_step "flatpak packages" "$DOTFILES_DIR/setup/common/packages/flatpak-packages"
run_step "mise packages" "$DOTFILES_DIR/setup/common/packages/mise-dev-packages"


run_step "hyprland" "$ARCH_WORKSTATION_DIR/setup-packages/setup-hyprland"
# Shared with arch-workstation, not overridden: the shell is identical on both
# targets, so its runtime dependencies are too.
run_step "quickshell packages" "$DOTFILES_DIR/setup/common/packages/quickshell-packages"
run_step "network page validation" "$DOTFILES_DIR/setup/common/setup-network-page"

# Rootless -- this box runs AI harnesses against text pulled off the internet.
# See ../common/setup-rootless-docker and README.md "docker".
run_step "docker" "$DOTFILES_DIR/setup/common/setup-rootless-docker"

# sshd before the firewall: once setup-ufw runs, sshd over the tailnet is the
# only remote access path, and Arch does not enable sshd itself.
run_step "sshd" "$ARCH_DEVBOX_DIR/setup-sshd"

# Deny-all baseline only. The tailnet hole and the VLAN-isolation rules come
# from ./setup-tailscale and ./setup-ufw, which must be run by hand
# after this — setup-tailscale is interactive (a login URL) and run_step gives
# steps stdin /dev/null, and setup-ufw needs tailscale0 to already exist.
# NOT ../arch-workstation/setup-packages/setup-ufw: that one denies all inbound
# traffic, while this box must accept SSH over the tailnet.
run_step "ufw baseline" "$ARCH_DEVBOX_DIR/setup-ufw-base"

# syncthing dropped — file sync, not development.

# Guard zsh: usermod -s is non-idempotent (records a change every run).
CURRENT_STEP="zsh"
if is_done zsh-shell; then
    ui_skip "zsh shell already configured"
else
    run_step "zsh" "$ARCH_WORKSTATION_DIR/setup-packages/setup-zsh"
    mark_done zsh-shell
fi

# Guard apparmor: the sed appends `lsm=...` to GRUB_CMDLINE_LINUX_DEFAULT,
# which would duplicate on rerun.
CURRENT_STEP="apparmor"
if is_done apparmor; then
    ui_skip "apparmor already configured"
else
    run_step "apparmor" "$ARCH_WORKSTATION_DIR/setup-packages/setup-apparmor"
    mark_done apparmor
fi

run_step "kanata" "$ARCH_WORKSTATION_DIR/setup-packages/setup-kanata"
run_step "herdr" "$DOTFILES_DIR/setup/common/setup-herdr"
run_step "skills" "$DOTFILES_DIR/setup/common/setup-skills"

# setup-github-cli intentionally not run — needs `gh auth login` first.
# Run manually after login: ~/dotfiles/bin/df-arch-devbox-post-install

# setup-voxtype intentionally not run — uncomment to enable.
# run_step "voxtype" "$ARCH_WORKSTATION_DIR/setup-packages/setup-voxtype"

run_step "go packages" "$DOTFILES_DIR/setup/common/packages/go-packages"
run_step "shell completions" "$DOTFILES_DIR/bin/df-gen-completions"

# Guard keyring: writes secret files, has built-in --check but re-running is wasteful.
CURRENT_STEP="keyring"
if "$ARCH_WORKSTATION_DIR/keyring" --check >/dev/null 2>&1; then
    ui_skip "keyring already exists"
else
    run_step "keyring" "$ARCH_WORKSTATION_DIR/keyring"
fi

# System-wide QoL tweaks (sysctl, sudoers, systemd timeouts).
run_step "file watchers" "$ARCH_DEVBOX_DIR/setup-file-watchers"
# The Session Lock authenticates against its own PAM service; without this it
# rejects every password.
run_step "lock pam" "$ARCH_WORKSTATION_DIR/setup-packages/setup-lock-pam"
run_step "ssh flakiness" "$ARCH_WORKSTATION_DIR/setup-packages/setup-ssh-flakiness"
# Passwordless `ts-serve` (zsh aliasrc) via a validating root wrapper.
run_step "ts-serve sudo rule" "$DOTFILES_DIR/setup/common/setup-ts-serve"
run_step "fast shutdown" "$ARCH_WORKSTATION_DIR/setup-packages/setup-fast-shutdown"

# Power management, one branch each. TLP and tuned drive the same sysfs knobs
# and neither yields, so the if/else is what keeps them mutually exclusive —
# setup-tuned also checks for tlp.service itself, in case one was added by hand.
# On the laptop side auto-cpufreq is the alternative to TLP; edit here to switch.
if is_laptop; then
    run_step "tlp (laptop)" "$ARCH_WORKSTATION_DIR/setup-packages/setup-tlp"
    # run_step "auto-cpufreq (laptop)" "$ARCH_WORKSTATION_DIR/setup-packages/setup-auto-cpufreq"
    run_step "bluetooth (laptop)" "$ARCH_WORKSTATION_DIR/setup-packages/setup-bluetooth"
    run_step "wifi powersave (laptop)" "$ARCH_WORKSTATION_DIR/setup-packages/setup-wifi-powersave"
else
    ui_skip "not a laptop — skipping tlp/auto-cpufreq/bluetooth/wifi-powersave"
    run_step "tuned (desktop)" env TUNED_ON_TLP=skip "$ARCH_DEVBOX_DIR/setup-tuned"
fi

# arch-workstation also makes ~/.obsidian-vault; obsidian is culled here.
CURRENT_STEP="useful directories"
mkdir -p ~/dev

run_step "greeter" "$DOTFILES_DIR/setup/common/setup-greeter"

# Apply the system lockout policy after SDDM has installed its PAM service.
run_step "system authentication lockout" "$ARCH_WORKSTATION_DIR/setup-packages/setup-sudo-tries"

run_step "post-install" "$ARCH_DEVBOX_DIR/post-install"

touch "$ARCH_SETUP_STATE_DIR/.initialized"
ui_done "arch-devbox setup completed"

# Interactive wrap-up. ui_done has stopped the live log panel, so the terminal
# is free again. These must run here (not inside post-install, which run_step
# executes with stdin /dev/null and stdout redirected to the log).
echo
echo "Next steps — the firewall is deny-all until you run these:"
echo "  0. $ARCH_DEVBOX_DIR/setup-ufw-lan     # optional: ssh in from one LAN machine"
echo "     (skip it if you are staying at this keyboard until the tailnet is up."
echo "      It only covers the gap: right now nothing can reach this box at all,"
echo "      and step 2 deletes the hole again)"
echo "  1. $ARCH_DEVBOX_DIR/setup-tailscale   # join the tailnet, open tailscale0"
echo "  2. $ARCH_DEVBOX_DIR/setup-ufw         # tailnet-only + VLAN isolation"
echo "     (in that order — setup-ufw refuses to run before the tailnet is up,"
echo "      since afterwards the tailnet is the only remote way in. If you got"
echo "      here over the LAN, reconnect over the tailnet before running it)"
echo "  3. $ARCH_DEVBOX_DIR/harden-ssh        # key-only sshd, off port 22"
echo "     (after ssh-copy-id from the laptop — it refuses without a key."
echo "      Tailscale SSH is off; sshd is the tailnet access path. The port"
echo "      move is optional, so SSH_PORT=keep is valid.)"
echo
echo "Then:"
echo "  • After 'gh auth login', run: ~/dotfiles/bin/df-arch-devbox-post-install"
echo "    (configures GitHub CLI; completions + go tools already ran during setup)"
echo "  • AI CLIs already installed by 'ai tools' — several need a login on"
echo "    first run (claude, opencode, gemini, kilo)."
echo

if [[ -e /dev/tty ]]; then
    restart=false
    if command -v gum &>/dev/null; then
        gum confirm "Restart now?" </dev/tty && restart=true
    else
        read -r -p "Do you want to restart? [y/N] " response </dev/tty
        [[ "$response" =~ ^([yY][eE][sS]|[yY])$ ]] && restart=true
    fi

    # Reboot races the EXIT trap: `shutdown -r now` returns at once and the
    # kernel kills us before on_exit_extra's `rm` lands, leaving the temporary
    # sudoers rule on disk. So tear it down explicitly before shutting down.
    if [[ "$restart" == true ]]; then
        on_exit_extra
        sudo shutdown -r now
    fi
fi
