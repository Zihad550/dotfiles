#!/usr/bin/env bash

# makepkg needs the complete base-devel group to build AUR packages.

# shellcheck source=../common/pacman-lib
. "$(dirname "${BASH_SOURCE[0]}")/../common/pacman-lib"

pacman_install base-devel

if command -v yay &>/dev/null; then
    echo "yay already installed ($(command -v yay)); skipping."
    exit 0
fi

pacman_install yay
