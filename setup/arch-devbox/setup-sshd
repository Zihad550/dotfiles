#!/usr/bin/env bash

# Arch ships openssh but does NOT enable sshd.service — unlike Ubuntu Server,
# where ubuntu-devbox could assume it was already running.
#
# This matters more than it looks: setup-ufw-lan's rule is what lets you drive
# the rest of the setup from your laptop, and after setup-ufw sshd over the
# tailnet is the fallback for a broken Tailscale SSH ACL. Without a listener
# either one is a recovery path that only *reads* as one.
#
# Non-interactive and idempotent, so both init and setup-ufw-lan run it — the
# latter because a box that skipped init has no listener, and the rule it is
# about to write would be worthless. Hardening is deliberately NOT applied
# here — see the note at the end.

set -e

sudo pacman -S --noconfirm --needed openssh

if systemctl is-enabled sshd.service &>/dev/null; then
    echo "sshd.service already enabled"
else
    sudo systemctl enable sshd.service
fi

# Not fatal: init runs this under `set -e`, and abandoning the whole install
# before gdm over a recoverable sshd failure is the wrong trade. Callers who do
# care re-check is-active afterwards — setup-ufw-lan before it opens the hole,
# setup-ufw at the end of its run.
sudo systemctl start sshd.service ||
    echo "warn: sshd failed to start — the LAN break-glass rule would have no listener"

echo "sshd listening: $(systemctl is-active sshd.service)"

# Hardening is ./harden-ssh, run by hand afterwards. Not from here, because
# disabling password auth before a key is installed leaves sshd accepting
# nobody — and by the time harden-ssh runs, setup-ufw has already deleted the
# LAN hole, so the only thing left is the physical keyboard. harden-ssh refuses
# to run until ~/.ssh/authorized_keys has a key.
#
# It also moves sshd off 22, which is not cosmetic here: `tailscale up --ssh`
# makes tailscaled intercept port 22 on the tailnet IP, so sshd on 22 is
# unreachable from the only network this box answers on.
