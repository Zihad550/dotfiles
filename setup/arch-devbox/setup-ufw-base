#!/usr/bin/env bash

# Non-interactive firewall baseline, run from init: deny-all-in, allow-all-out.
# setup-ufw-lan and setup-ufw layer the real holes on top, run by hand after.
# See "## order" and "## firewall" in ./README.md for the full design.

set -e

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../common/ufw-lib
. "$HERE/../common/ufw-lib"

ufw_bootstrap
ufw_commit

sudo ufw status verbose
