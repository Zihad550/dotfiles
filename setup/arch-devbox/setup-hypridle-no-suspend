#!/usr/bin/env bash

# Idle-only half of ./setup-no-sleep: points hypridle at hypridle.conf (no
# suspend listener) without masking sleep.target, so manual suspend
# (SUPER+CTRL+S, `systemctl suspend`) keeps working while idle timeouts no
# longer trigger it. See ../common/setup-hypridle-no-suspend and README.md
# "staying awake".

set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"

exec "$(dirname "${BASH_SOURCE[0]}")/../common/setup-hypridle-no-suspend" \
    "$DOTFILES_DIR/setup/arch-devbox/hypridle.conf"
