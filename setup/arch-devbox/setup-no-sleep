#!/usr/bin/env bash

# Keep this box awake and reachable. See ../common/setup-no-sleep and
# README.md "staying awake".
#
# On a laptop this means the battery runs flat instead of suspending — the
# intended trade for a machine you reach over the tailnet.

set -euo pipefail

# arch-hyprland's shared hypridle.conf keeps its suspend listener, which the
# laptop wants. Point hypridle at this box's config instead.
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"
export NO_SLEEP_HYPRIDLE_CONF="$DOTFILES_DIR/setup/arch-devbox/hypridle.conf"

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$HERE/../common/setup-no-sleep" "$@"
