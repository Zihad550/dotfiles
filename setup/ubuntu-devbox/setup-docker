#!/usr/bin/env bash

# The devcontainer gets docker from the docker-in-docker:4 feature with
# moby:false, i.e. Docker CE, and a `usermod -aG docker` in postCreateCommand.
# Neither is in devcontainer/install.sh, so this is the bare-metal equivalent.
#
# Deliberately no `newgrp docker` (unlike ubuntu-server/setup-docker) -- it
# spawns an interactive subshell, which stalls a scripted run. The group takes
# effect on next login, which init already tells you to do.

if ! command -v docker &>/dev/null; then
    curl -fsSL https://get.docker.com -o /tmp/get-docker.sh
    sudo sh /tmp/get-docker.sh
    rm -f /tmp/get-docker.sh
fi

sudo groupadd -f docker
sudo usermod -aG docker "$USER"

echo "docker installed; group membership applies after you log back in"
