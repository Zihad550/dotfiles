#!/usr/bin/env bash

# Same package set as setup/devcontainer/install.sh, minus the container-only
# bits. Bare metal, so PPAs are fine here (setup/ubuntu-server/minimal avoids
# add-apt-repository because it targets LXC).

sudo apt update -y
sudo apt upgrade -y

sudo apt install -y \
    stow \
    zsh \
    fzf \
    trash-cli \
    bubblewrap \
    socat \
    git-delta \
    starship \
    rsync \
    pass \
    jq \
    less \
    git-delta \
    atuin \
    lazygit \
    tmux

# clis for interacting with git providers
sudo apt install -y \
    gh \
    tea

#  alternatives to core packages
sudo apt install -y \
    ripgrep \
    bat \
    eza \
    zoxide \
    fd-find \
    du-dust \
    procs \
    btm \
    tealdeer

# install languages and dev tools
sudo apt install -y \
    gcc

# yazi and dependencies
sudo apt install -y \
    yazi \
    ffmpeg \
    unar \
    jq \
    poppler-utils \
    imagemagick \
    fd-find \
    ripgrep

# ubuntu ships bat as batcat to avoid a name clash with bacula-console
mkdir -p ~/.local/bin && ln -snf /usr/bin/batcat ~/.local/bin/bat

# mise
sudo add-apt-repository -y ppa:jdxcode/mise
sudo apt update -y
sudo apt install -y mise

# neovim
sudo add-apt-repository -y ppa:neovim-ppa/unstable
sudo apt update -y
sudo apt install -y \
    make \
    gcc \
    ripgrep \
    fd-find \
    tree-sitter-cli \
    unzip \
    git \
    xclip \
    neovim
