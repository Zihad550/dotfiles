#!/usr/bin/env bash

# Named `init` so setup/boot.sh can dispatch to it: ./boot.sh ubuntu-devbox
#
# Run in this order:
#   1. ./init              <- you are here (packages + dotfiles + tools)
#   2. ./setup-ufw         <- deny inbound before anything else. Ubuntu ships ufw
#                             installed but inactive, so until this runs sshd is
#                             open to the whole LAN. tailscale0 does not need to
#                             exist yet: the rule names the interface and starts
#                             matching when it appears.
#   3. ./setup-tailscale   <- reachable over the tailnet. Needs outbound only,
#                             which ufw already allows.
#   4. ./harden-ssh        <- key-only sshd on a random port. Last, and only
#                             once a key login is confirmed: it needs setup-ufw's
#                             break-glass rule to already exist so it can mirror
#                             that rule onto the new port.
#
# Then, independently of each other and in any order:
#   ./encrypt-data-disk <dev>  <- LUKS on a data disk, TPM2-unlocked
#   ./setup-root-autounlock    <- unattended boot for an encrypted root
#
# Those two touch different disks and neither needs the other: encrypt-data-disk
# enrolls its own disk into the TPM, and setup-root-autounlock only ever acts on
# the root device the installer encrypted.
#
# Root-disk encryption itself is NOT installable from here; it is a checkbox in
# the Ubuntu installer. See README.md.

set -e

SETUP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Derived from SETUP_DIR rather than the arch inits' `${DOTFILES_DIR:-$HOME/dotfiles}`,
# so the repo still works when it is not checked out at ~/dotfiles.
DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$SETUP_DIR/../.." && pwd)}"

"$SETUP_DIR/packages"
"$SETUP_DIR/setup-docker"
"$SETUP_DIR/stow"

# No wrapper for setup-no-sleep: this box sets none of its variables, so the
# shared script is called directly. setup-tuned does have one.
#
# Order: reachability first, power savings second.
"$DOTFILES_DIR/setup/common/setup-no-sleep"

# shellcheck source=../common/hw-detect
source "$DOTFILES_DIR/setup/common/hw-detect"
if is_laptop; then
    echo "note: laptop detected — skipping setup-tuned; use tlp instead"
else
    TUNED_ON_TLP=skip "$SETUP_DIR/setup-tuned"
fi

mise trust
"$SETUP_DIR/tools"

sudo chsh -s "$(which zsh)" "$USER"

echo
echo "next:"
echo "  $SETUP_DIR/setup-ufw"
echo "  $SETUP_DIR/setup-tailscale"
echo "  $SETUP_DIR/harden-ssh                # after a key login is confirmed"
echo "  $SETUP_DIR/encrypt-data-disk <dev>   # optional"
echo "  $SETUP_DIR/setup-root-autounlock     # optional, encrypted root only"
echo
echo "now logout and log back in"
