#!/usr/bin/env bash

# LAN_SSH_SRC to an address, a CIDR, or `none` to skip the prompt. With no
# terminal and no LAN_SSH_SRC it falls back to the whole detected subnet.
#
# Unlike ../arch-devbox, the LAN hole this opens is permanent: it is this box's
# break-glass path for when tailscaled is the thing that broke. The prompt and
# the ufw helpers are shared with that box -- see ../common/ufw-lib.

set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../common/ufw-lib
. "$HERE/../common/ufw-lib"

LAN_MENU_QUESTION="How should this machine be reachable over the LAN?"
LAN_MENU_INTRO="  Tailscale is the way you will actually use it. This rule only exists
  as the way back in when tailscaled is the thing that broke."
LAN_MENU_CHOICE3="  3) no LAN access     -- tailnet only; a keyboard attached to this
                          machine becomes the only recovery path.
                          Needs the tailnet already up."
LAN_MENU_NO_TAILNET="  the tailnet is not up, so there would be no way in at all.
  run ./setup-tailscale first, then re-run this and pick 3."

resolve_lan_src

set -e

ufw_bootstrap

# The whole tailnet, every port. This is what makes per-port dev server rules
# unnecessary -- a new app on :3000 is reachable with no firewall change.
sudo ufw allow in on tailscale0 comment 'tailnet'

if [ "$LAN_SSH_SRC" = "none" ]; then
    echo
    echo "WARNING: no LAN ssh rule. If tailscaled fails to come up, the only way"
    echo "         back in is a keyboard attached to this machine."
else
    sudo ufw allow from "$LAN_SSH_SRC" to any app OpenSSH comment 'lan break-glass'
    case "$LAN_SSH_SRC" in
    */*) ;;
    *)
        echo
        echo "NOTE: ssh is restricted to $LAN_SSH_SRC. Give that machine a DHCP"
        echo "      reservation -- if its address changes you lose this path."
        ;;
    esac
fi

ufw_commit

echo
sudo ufw status verbose
