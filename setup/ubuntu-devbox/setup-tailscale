#!/usr/bin/env bash

# Join the tailnet. See ../common/setup-tailscale for what this does and why;
# this file only says what is true about *this* box.
#
#   TS_AUTHKEY=tskey-auth-...  ./setup-tailscale     # unattended
#   ./setup-tailscale                                # prints a URL to open
#   TS_HOSTNAME=devbox         ./setup-tailscale     # override the tailnet name
#
# Where this box differs from ../arch-devbox: tailscale comes from the curl
# installer, and ./setup-ufw runs before this and owns the tailscale0 rule.
#
# On the sshd note in the shared script: this box keeps a permanent LAN ssh
# hole, so the way back in when tailscaled is what broke is ssh from the LAN --
# not the console.

set -euo pipefail

if ! command -v tailscale &>/dev/null; then
    curl -fsSL https://tailscale.com/install.sh | sh
fi

# ./setup-ufw runs before this one and already allows everything arriving on
# tailscale0. It can do that before tailscaled exists because the rule names the
# interface -- it simply starts matching once tailscale0 appears. If you ran
# this first anyway, ssh over the tailnet stays dropped until you run setup-ufw.
export TS_TAILNET_UFW_RULE=0

export TS_NEXT="harden sshd once you have confirmed key login works:
  ./harden-ssh      # key-only, no root, random port"

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$HERE/../common/setup-tailscale" "$@"
