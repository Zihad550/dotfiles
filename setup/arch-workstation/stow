#!/usr/bin/env bash

set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
cd "$DOTFILES_DIR"

stow ghostty
stow kanata
stow zsh
stow zed
mkdir -p "$HOME/.local/share/zed/extensions"
ln -snf "$HOME/.config/zed/backup/extensions/index.json" \
    "$HOME/.local/share/zed/extensions/index.json"
stow starship
"$DOTFILES_DIR/setup/common/voxtype/seed-config"
stow procs
stow atuin
stow dotfiles

# Herdr keeps sessions and sockets beside its config, so stow only the file.
mkdir -p "$HOME/.config/herdr"
ln -snf "$DOTFILES_DIR/herdr/.config/herdr/config.toml" \
    "$HOME/.config/herdr/config.toml"

# Only layers/ is managed; the rest of ~/.config/devvm is devvm's state.
mkdir -p "$HOME/.config/devvm"
if [[ -d "$HOME/.config/devvm/layers" && ! -L "$HOME/.config/devvm/layers" ]]; then
    echo "warning: ~/.config/devvm/layers is a real folder; move its layers into $DOTFILES_DIR/devvm and rerun" >&2
else
    ln -snf "$DOTFILES_DIR/devvm/.config/devvm/layers" "$HOME/.config/devvm/layers"
fi

rm -rf "$HOME/.bashrc"
stow bash
