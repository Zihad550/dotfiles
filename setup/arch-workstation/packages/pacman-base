#!/usr/bin/env bash

# Local desktop and remote-access tools. Development runtimes, container
# engines, source-control frontends, and coding agents belong on the devbox.
# Helium's AUR build dependencies and Zed's package dependencies are declared
# separately with those client applications.

# shellcheck source=../../common/pacman-lib
. "$(dirname "${BASH_SOURCE[0]}")/../../common/pacman-lib"

pacman_install \
    openssh \
    tailscale \
    curl \
    less \
    jq \
    fzf \
    man-db \
    man-pages \
    starship \
    gum \
    atuin \
    pastel \
    7zip trash-cli \
    rsync \
    github-cli \
    herdr

sudo systemctl enable --now tailscaled.service

pacman_install \
    ttf-jetbrains-mono \
    ttf-hack-nerd \
    noto-fonts \
    ttf-nerd-fonts-symbols-mono \
    noto-fonts-emoji \
    ttf-dejavu

pacman_install \
    zoxide \
    eza \
    ripgrep \
    bat \
    fd \
    dust \
    procs \
    bottom \
    tealdeer
