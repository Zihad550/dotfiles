#!/usr/bin/env bash

# Graphical applications for the client workstation. Editors stay local so
# they can connect to a devbox; build tools and language runtimes do not.

#  core, desktop-only
# xournalpp - pdf editor
# dosfstools - fat32 support
sudo pacman -S --noconfirm \
    xournalpp \
    dosfstools \
    rclone \
    veracrypt \
    pass

# xorg-xhost \      # needed for running timeshift

# install apps
# converseen - convert and optimize img
# swappy slurp grim - screenshot
# blueberry - bluetooth
# libqalculate, cliphist and wl-clipboard are in
#   ../../common/packages/quickshell-packages --
#   they are quickshell's runtime dependencies (calculator, clipboard provider,
#   wl-copy) and arch-devbox needs the same set.
sudo pacman -S --noconfirm \
    zed \
    neovim \
    transmission-gtk \
    ghostty \
    obs-studio \
    discord \
    obsidian \
    mpv \
    converseen \
    swappy slurp grim
# gemini

# install gnome apps
# gnome-keyring, libsecret and seahorse are NOT optional: setup-hyprland
# enables gcr-ssh-agent.service, which is how ssh keys get unlocked here.
sudo pacman -S --noconfirm \
    nautilus \
    nautilus-image-converter \
    gnome-disk-utility \
    gnome-font-viewer \
    gnome-keyring libsecret seahorse

