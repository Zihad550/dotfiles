#!/usr/bin/env bash

# Sanity checks before running an Arch setup. Shared by arch-workstation and
# arch-devbox — the caller names itself via ARCH_SETUP_NAME.
# Each check that fails offers a y/N bypass. Plain bash on purpose: this runs
# before init installs gum, and checks the pacman that install needs.

SETUP_NAME="${ARCH_SETUP_NAME:-arch-workstation}"

abort() {
    echo "✗ $SETUP_NAME setup requires: $1" >&2
    read -rp "Proceed anyway? [y/N] " ans
    [[ "$ans" =~ ^[yY] ]] || exit 1
}

# Must be an Arch distro
[[ -f /etc/arch-release ]] || abort "Arch Linux"

# Must not be running as root
(( EUID != 0 )) || abort "running as user (not root)"

# Must be x86_64
[[ "$(uname -m)" == "x86_64" ]] || abort "x86_64 CPU"

# pacman must exist
command -v pacman &>/dev/null || abort "pacman"

# user must be in wheel group (needed for sudo throughout setup)
groups | grep -qw wheel || abort "user in wheel group"
