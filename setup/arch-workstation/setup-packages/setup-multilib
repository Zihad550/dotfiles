#!/usr/bin/env bash
set -euo pipefail

# DOTFILES_PACMAN_CONF defaults to /etc/pacman.conf.
pacman_config="${DOTFILES_PACMAN_CONF:-/etc/pacman.conf}"
repositories=$(pacman-conf --config "$pacman_config" --repo-list)

if grep -qx multilib <<<"$repositories"; then
    echo "Multilib is already enabled."
else
    sudo cp --preserve=all -- "$pacman_config" "$pacman_config.multilib.bak"
    printf '\n[multilib]\nInclude = /etc/pacman.d/mirrorlist\n' |
        sudo tee -a "$pacman_config" >/dev/null
    echo "Enabled multilib; backup saved to $pacman_config.multilib.bak."
fi

# Refreshing databases alone would risk partial upgrades before Steam installs.
sudo pacman --config "$pacman_config" -Syu --noconfirm
