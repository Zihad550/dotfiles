#!/usr/bin/env bash

# base-devel is required for makepkg to build AUR packages (debugedit,
# fakeroot, make, gcc, etc.). Install before yay so AUR builds work.
sudo pacman -S --noconfirm --needed base-devel

if command -v yay &>/dev/null; then
    echo "yay already installed ($(command -v yay)); skipping."
    exit 0
fi

# yay is in the official 'extra' repo, so install it directly — no AUR clone +
# makepkg. This avoids makepkg's internal `sudo pacman -U` prompting for a
# password mid-build (matches how omarchy installs it).
sudo pacman -S --noconfirm --needed yay
