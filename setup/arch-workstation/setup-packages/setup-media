#!/usr/bin/env bash
set -euo pipefail

# Match Omarchy's video associations without replacing other MIME defaults.
for mime in video/mp4 video/x-msvideo video/x-matroska video/x-flv \
    video/x-ms-wmv video/mpeg video/ogg video/webm video/quicktime \
    video/3gpp video/3gpp2 video/x-ms-asf video/x-ogm+ogg \
    video/x-theora+ogg application/ogg; do
    xdg-mime default mpv.desktop "$mime"
done
