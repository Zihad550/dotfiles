#!/usr/bin/env bash

# Make browser policy dirs writable so df-theme-set-browser can update them.
sudo mkdir -p /etc/chromium/policies/managed
sudo chmod a+rw /etc/chromium/policies/managed
if command -v google-chrome-stable &>/dev/null || command -v google-chrome &>/dev/null; then
   sudo mkdir -p /etc/opt/chrome/policies/managed
   sudo chmod a+rw /etc/opt/chrome/policies/managed
fi
if command -v microsoft-edge-stable &>/dev/null; then
   sudo mkdir -p /etc/opt/edge/policies/managed
   sudo chmod a+rw /etc/opt/edge/policies/managed
fi
if command -v brave &>/dev/null || command -v brave-origin &>/dev/null; then
   sudo mkdir -p /etc/brave/policies/managed
   sudo chmod a+rw /etc/brave/policies/managed
fi

# Index only (a few KB); the default theme is built in, so a failed clone
# just means the picker retries later.
~/dotfiles/bin/df-theme-fetch --sync || echo "Theme pack not cloned; the theme picker will retry."

# Use new theme system - generates configs from colors.toml + sets default theme
~/dotfiles/bin/df-theme-set default
