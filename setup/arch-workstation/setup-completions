#!/usr/bin/env bash

set -euo pipefail

completion_dir="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/site-functions"
mkdir -p "$completion_dir"
herdr completion zsh >"$completion_dir/_herdr"

rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/.zcompdump" \
    "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/.zcompdump.zwc"
