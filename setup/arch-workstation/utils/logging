#!/usr/bin/env bash

# Ported from omarchy's install helpers (presentation.sh + logging.sh +
# errors.sh). Same model: commands run in the FOREGROUND writing to a log file,
# while a backgrounded viewer continuously redraws the tail of that log under
# the logo. No per-step gum spinner — progress is the rolling log panel.
# The UI is gum-only; init installs gum right after preflight. Only the error
# and interrupt handlers keep a plain path, since they can fire before that.
# start_lane/join_lane run a step list in the background instead; see
# setup/arch-devbox/README.md "background lane".

ARCH_SETUP_STATE_DIR="${ARCH_SETUP_STATE_DIR:-$HOME/.local/state/arch-setup}"
LOG_FILE="${LOG_FILE:-$ARCH_SETUP_STATE_DIR/install.log}"
mkdir -p "$ARCH_SETUP_STATE_DIR"
touch "$LOG_FILE"

# Which installer is sourcing us. arch-devbox reuses this file verbatim, so the
# name in error messages and the "Retry" target must not be hardcoded.
ARCH_SETUP_NAME="${ARCH_SETUP_NAME:-arch-workstation}"
ARCH_SETUP_INIT="${ARCH_SETUP_INIT:-${ARCH_WORKSTATION_DIR:-}/init}"

_ts() { date '+%Y-%m-%d %H:%M:%S'; }
_is_tty() { [[ -t 1 ]]; }

# Cursor is hidden while the viewer runs; restore it on the way out.
show_cursor() { printf '\033[?25h'; }
_show_cursor() { show_cursor; }

# --- presentation (omarchy presentation.sh) -----------------------------
# Terminal size from /dev/tty (works direct, sourced, or piped).
if [[ -e /dev/tty ]]; then
    TERM_SIZE=$(stty size 2>/dev/null </dev/tty || true)
    if [[ -n "$TERM_SIZE" ]]; then
        export TERM_HEIGHT=$(echo "$TERM_SIZE" | cut -d' ' -f1)
        export TERM_WIDTH=$(echo "$TERM_SIZE" | cut -d' ' -f2)
    else
        export TERM_WIDTH=80 TERM_HEIGHT=24
    fi
else
    export TERM_WIDTH=80 TERM_HEIGHT=24
fi

export LOGO_PATH="${ARCH_WORKSTATION_DIR:-}/logo.txt"
export LOGO_WIDTH=$(awk '{ if (length > max) max = length } END { print max+0 }' "$LOGO_PATH" 2>/dev/null || echo 0)
export LOGO_HEIGHT=$(wc -l <"$LOGO_PATH" 2>/dev/null || echo 0)

export PADDING_LEFT=$(((TERM_WIDTH - LOGO_WIDTH) / 2))
((PADDING_LEFT < 0)) && PADDING_LEFT=0
export PADDING_LEFT_SPACES=$(printf "%*s" "$PADDING_LEFT" "")

# Tokyo Night theme for gum widgets (omarchy values).
export GUM_CONFIRM_PROMPT_FOREGROUND="6"
export GUM_CONFIRM_SELECTED_FOREGROUND="0"
export GUM_CONFIRM_SELECTED_BACKGROUND="2"
export GUM_CONFIRM_UNSELECTED_FOREGROUND="7"
export GUM_CONFIRM_UNSELECTED_BACKGROUND="0"
_PAD="0 0 0 $PADDING_LEFT"
export GUM_CHOOSE_PADDING="$_PAD"
export GUM_FILTER_PADDING="$_PAD"
export GUM_INPUT_PADDING="$_PAD"
export GUM_SPIN_PADDING="$_PAD"
export GUM_TABLE_PADDING="$_PAD"
export GUM_CONFIRM_PADDING="$_PAD"
unset _PAD

clear_logo() {
    printf "\033[H\033[2J" # clear screen, cursor to top-left
    if [[ -f "$LOGO_PATH" ]]; then
        gum style --foreground 2 --padding "1 0 0 $PADDING_LEFT" "$(<"$LOGO_PATH")"
    fi
}

# --- background log viewer (omarchy logging.sh) -------------------------
start_log_output() {
    local ANSI_SAVE_CURSOR="\033[s"
    local ANSI_RESTORE_CURSOR="\033[u"
    local ANSI_CLEAR_LINE="\033[2K"
    local ANSI_HIDE_CURSOR="\033[?25l"
    local ANSI_RESET="\033[0m"
    local ANSI_GRAY="\033[90m"

    printf "$ANSI_SAVE_CURSOR"
    printf "$ANSI_HIDE_CURSOR"

    (
        local log_lines=19 # plus one lane status line
        local max_line_width=$((LOGO_WIDTH - 4))
        ((max_line_width < 20)) && max_line_width=$((TERM_WIDTH - 4))

        while true; do
            mapfile -t current_lines < <(tail -n $log_lines "$LOG_FILE" 2>/dev/null)

            output=""
            for ((i = 0; i < log_lines; i++)); do
                line="${current_lines[i]:-}"
                if ((${#line} > max_line_width)); then
                    line="${line:0:$max_line_width}..."
                fi
                if [[ -n "$line" ]]; then
                    output+="${ANSI_CLEAR_LINE}${ANSI_GRAY}${PADDING_LEFT_SPACES}  → ${line}${ANSI_RESET}\n"
                else
                    output+="${ANSI_CLEAR_LINE}${PADDING_LEFT_SPACES}\n"
                fi
            done

            status=""
            for marker in "$LANE_DIR"/*; do
                [[ -e "$marker" ]] || continue
                lane="${marker##*/}"
                last=$(tail -n 1 "$(_lane_log "$lane")" 2>/dev/null)
                status="⇄ $lane: ${last##*$'\r'}" # last frame of a progress bar
                break
            done
            if ((${#status} > max_line_width)); then
                status="${status:0:$max_line_width}..."
            fi
            output+="${ANSI_CLEAR_LINE}${ANSI_GRAY}${PADDING_LEFT_SPACES}  ${status}${ANSI_RESET}\n"

            printf "${ANSI_RESTORE_CURSOR}%b" "$output"
            sleep 0.1
        done
    ) &
    monitor_pid=$!
}

stop_log_output() {
    if [[ -n "${monitor_pid:-}" ]]; then
        kill "$monitor_pid" 2>/dev/null || true
        wait "$monitor_pid" 2>/dev/null || true
        unset monitor_pid
    fi
}

# --- header / footer ----------------------------------------------------
# ui_header "title" "subtitle" — logo + banner, then start the live log panel.
ui_header() {
    local title="$1" sub="$2"
    export ARCH_SETUP_START_EPOCH="${ARCH_SETUP_START_EPOCH:-$(date +%s)}"
    echo "[$(_ts)] $title — $sub" >>"$LOG_FILE"

    if _is_tty; then
        clear_logo
        gum style --foreground 3 --padding "1 0 0 $PADDING_LEFT" "$title"
        echo
        start_log_output
    fi
}

# ui_done "message" — stop the panel, restore cursor, print summary box.
ui_done() {
    local msg="${1:-Installation complete!}"
    stop_log_output
    show_cursor

    local elapsed_line=""
    if [[ -n "${ARCH_SETUP_START_EPOCH:-}" ]]; then
        local now=$(date +%s)
        local secs=$((now - ARCH_SETUP_START_EPOCH))
        elapsed_line="Installed in $((secs / 60))m $((secs % 60))s"
        echo "[$(_ts)] Total time: $elapsed_line" >>"$LOG_FILE"
    fi
    echo "[$(_ts)] $msg" >>"$LOG_FILE"

    gum style --border rounded --padding "1 2" \
        --border-foreground 2 --foreground 2 "✓ $msg" ${elapsed_line:+"$elapsed_line"}
}

# ui_skip "message" — log only; the panel surfaces it (no direct terminal write
# so the redraw region stays intact).
ui_skip() {
    echo "[$(_ts)] skip: $1" >>"$LOG_FILE"
}

# --- run a step (omarchy run_logged) ------------------------------------
# run_step "name" command [args...] — runs FOREGROUND, output to the log only.
# Under `set -e` a failure aborts straight into the ERR trap (catch_errors).
run_step() {
    local name="$1"
    shift
    export CURRENT_STEP="$name"

    echo "[$(_ts)] Starting: $name" >>"$LOG_FILE"
    "$@" </dev/null >>"$LOG_FILE" 2>&1
    local rc=$?
    if ((rc == 0)); then
        echo "[$(_ts)] Completed: $name" >>"$LOG_FILE"
    else
        echo "[$(_ts)] Failed: $name (exit $rc)" >>"$LOG_FILE"
    fi
    return $rc
}

# --- background lanes ---------------------------------------------------
LANE_DIR="$ARCH_SETUP_STATE_DIR/lanes" # one marker per running lane, for the panel
rm -rf "$LANE_DIR"
mkdir -p "$LANE_DIR"
declare -A LANE_PIDS=()

_lane_log() { echo "$ARCH_SETUP_STATE_DIR/install-$1.log"; }

# start_lane "name" fn [args...] — run fn's run_steps concurrently, logging to
# install-<name>.log. A failure surfaces at join_lane.
start_lane() {
    local name="$1" log
    shift
    log=$(_lane_log "$name")
    echo "[$(_ts)] Started lane: $name (log: $log)" >>"$LOG_FILE"
    touch "$LANE_DIR/$name"
    (
        # errtrace carries the ERR trap in here; without this a failing lane
        # step would open a second error screen over the main one.
        trap - ERR
        LOG_FILE="$log"
        "$@"
    ) </dev/null >>"$log" 2>&1 &
    LANE_PIDS[$name]=$!
}

# join_lane "name" — wait for the lane; its failure fails the install here.
join_lane() {
    local name="$1" log rc=0
    log=$(_lane_log "$name")
    CURRENT_STEP="$name lane"
    wait "${LANE_PIDS[$name]}" || rc=$?
    unset 'LANE_PIDS[$name]'
    rm -f "$LANE_DIR/$name"
    if ((rc == 0)); then
        echo "[$(_ts)] Joined lane: $name" >>"$LOG_FILE"
        return 0
    fi
    # The error screen tails LOG_FILE, so copy the lane's failure into it.
    CURRENT_STEP="$name lane: $(sed -n 's/^\[[^]]*\] Starting: //p' "$log" | tail -n 1)"
    {
        echo "[$(_ts)] Failed: $name lane (exit $rc). Last lines of $log:"
        tail -n 20 "$log"
    } >>"$LOG_FILE"
    return "$rc"
}

# Stop first so the process can't spawn a child we then miss.
_kill_tree() {
    local child
    kill -STOP "$1" 2>/dev/null || return 0
    for child in $(pgrep -P "$1" || true); do
        _kill_tree "$child"
    done
    kill -TERM "$1" 2>/dev/null || true
    kill -CONT "$1" 2>/dev/null || true
}

# Lanes ignore SIGINT (bash does that to background jobs in scripts), and
# killing only the subshell would orphan the mise/npm it is running.
kill_lanes() {
    local name
    for name in "${!LANE_PIDS[@]}"; do
        _kill_tree "${LANE_PIDS[$name]}"
        rm -f "$LANE_DIR/$name"
    done
    LANE_PIDS=()
}

# --- error handling (omarchy errors.sh) ---------------------------------
ERROR_HANDLING=false

# Show the tail of the install log on the error screen.
show_log_tail() {
    [[ -f "$LOG_FILE" ]] || return 0
    local log_lines=$((TERM_HEIGHT - LOGO_HEIGHT - 12))
    ((log_lines < 5)) && log_lines=15
    local max_line_width=$((LOGO_WIDTH - 4))
    ((max_line_width < 20)) && max_line_width=$((TERM_WIDTH - 4))

    tail -n "$log_lines" "$LOG_FILE" | while IFS= read -r line; do
        ((${#line} > max_line_width)) && line="${line:0:$max_line_width}..."
        gum style "$line"
    done
    echo
}

# Save/restore the real terminal stdout/stderr (defensive, matches omarchy).
save_original_outputs() { exec 3>&1 4>&2; }
restore_outputs() {
    if [[ -e /proc/self/fd/3 ]] && [[ -e /proc/self/fd/4 ]]; then
        exec 1>&3 2>&4
    fi
}

catch_errors() {
    local exit_code=$?
    trap - ERR # no re-entrancy: nothing inside here should retrigger us
    [[ "$ERROR_HANDLING" == "true" ]] && return
    ERROR_HANDLING=true

    stop_log_output
    kill_lanes
    restore_outputs
    show_cursor

    if _is_tty && command -v gum &>/dev/null; then
        clear_logo
        gum style --foreground 1 --padding "1 0 1 $PADDING_LEFT" "$ARCH_SETUP_NAME setup stopped!"
        show_log_tail
        gum style "Step '${CURRENT_STEP:-?}' halted with exit code $exit_code."
        gum style "Full log: $LOG_FILE"
        echo
        while true; do
            local choice
            choice=$(gum choose "Retry installation" "View full log" "Show last 30 lines" "Exit" \
                --header "What would you like to do?" --height 6 --padding "1 $PADDING_LEFT" 2>/dev/null || echo "Exit")
            case "$choice" in
                # exec replaces this process image outright, so the EXIT trap
                # (and thus on_exit_extra) never runs for it — same race as the
                # shutdown -r now case below. Run the hook by hand first.
                "Retry installation")
                    declare -F on_exit_extra >/dev/null && on_exit_extra
                    exec "${ARCH_SETUP_INIT:?}"
                    ;;
                "View full log") command -v less &>/dev/null && less "$LOG_FILE" || tail "$LOG_FILE" ;;
                "Show last 30 lines") tail -30 "$LOG_FILE" ;;
                "Exit" | "") exit "$exit_code" ;;
            esac
        done
    else
        echo "FAILED at step: ${CURRENT_STEP:-?} (exit $exit_code)" >&2
        tail -30 "$LOG_FILE" >&2
        exit "$exit_code"
    fi
}

# Invoked on SIGINT/SIGTERM.
ui_interrupted() {
    ERROR_HANDLING=true # this is the report; exit_handler must not add a failure screen
    stop_log_output
    kill_lanes
    show_cursor
    echo "[$(_ts)] Interrupted at step: ${CURRENT_STEP:-?}" >>"$LOG_FILE"
    if _is_tty && command -v gum &>/dev/null; then
        echo
        gum style --foreground 3 --border thick --padding "1 2" --border-foreground 3 \
            "⚠ Interrupted at step: ${CURRENT_STEP:-?}"
    else
        echo "Interrupted at step: ${CURRENT_STEP:-?}" >&2
    fi
    exit 130
}

# Ensures cleanup on any exit; runs the optional on_exit_extra hook last so the
# sourcing script can tear down its own resources (e.g. sudo keep-alive).
exit_handler() {
    local exit_code=$?
    trap - ERR # we're exiting; don't let anything below retrigger catch_errors
    if ((exit_code != 0)) && [[ "$ERROR_HANDLING" != "true" ]]; then
        catch_errors
    else
        stop_log_output
        kill_lanes
        show_cursor
    fi
    if declare -F on_exit_extra >/dev/null; then
        on_exit_extra || true
    fi
    return 0
}

trap catch_errors ERR
trap ui_interrupted INT TERM
trap exit_handler EXIT
save_original_outputs
