{
  "name": "Dev setup",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  // "image": "mcr.microsoft.com/devcontainers/javascript-node",

  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    // "ghcr.io/w3cj/devcontainer-features/firewall:latest": {
    //   "githubIps": true,
    //   "claudeCode": true,
    // },
  },

  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  "forwardPorts": [
    3000, 3001, 3002, 3003, 3004, 3005, 3006, 3007, 3008, 3009, 4173, 4174,
    4175, 5175, 5176, 5177, 5178, 5179, 5180, 6175, 8000, 9000,
  ],
  "otherPortsAttributes": { "onAutoForward": "silent" },
  // Use 'postCreateCommand' to run commands after the container is created.
  // "postCreateCommand": "pnpm i",
  // Configure tool-specific properties.
  // "customizations": {},
  // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  // "remoteUser": "root"
  // "workspaceMount": "source=/home/jehad/test/devcontainers-features,target=/workspace,type=bind",
  // "workspaceFolder": "/workspace",
  // "customizations": {
  //   "vscode": {
  //     "settings": {},
  //     "extensions": []
  //   }
  // },
  // "remoteUser": "node",

  // "dotfiles": {
  //   "repository": "https://github.com/Zihad550/dotfiles.git",
  //   "targetPath": "~/setup/devcontainer",
  //   "installCommand": "install.sh",
  // },
  "mounts": [
    "source=${localEnv:HOME}/dotfiles,target=/home/vscode/dotfiles,type=bind",
    "source=${localEnv:HOME}/dev-0,target=/home/vscode/dev-0,type=bind",
  ],
  "postCreateCommand": "bash ~/dotfiles/setup/devcontainer-2/install.sh",
}
