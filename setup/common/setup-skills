#!/usr/bin/env bash

# Installs every agent skill via the `skills` CLI (vercel-labs/skills), for all
# agents, on any machine. Replaces manually cloning github.com/Zihad550/.agents:
# the CLI owns ~/.agents as its global skill store, this file is the only thing
# that needs to live in dotfiles. See docs/adr/ for the ADR, if one exists.
#
# Idempotent: re-running re-syncs the same skills. To add a skill, add a line
# here. To add a custom skill with no upstream repo, add it under
# skills/<name>/SKILL.md in github.com/Zihad550/skills and list it in the
# "our own skills" block below.

set -e

AGENTS=(claude-code cursor codex pi kilo)

mise use -g npm:skills
eval "$(mise activate bash)"

######## third-party skills
skills add JuliusBrussee/caveman --skill caveman caveman-commit caveman-compress caveman-review -g --agent "${AGENTS[@]}" -y
skills add vercel-labs/skills --skill find-skills -g --agent "${AGENTS[@]}" -y
skills add herdrdev/herdr --skill herdr -g --agent "${AGENTS[@]}" -y
skills add giuseppe-trisciuoglio/developer-kit --skill shadcn-ui -g --agent "${AGENTS[@]}" -y
skills add anthropics/skills --skill webapp-testing -g --agent "${AGENTS[@]}" -y
skills add max-sixty/worktrunk --skill worktrunk -g --agent "${AGENTS[@]}" -y
skills add mattpocock/skills -g --agent cursor codex pi kilo -y

######## our own skills, no upstream repo — sourced from github.com/Zihad550/skills
skills add https://github.com/Zihad550/skills \
  --skill draft-tea-command-for-issue-create gh-create-issue gh-get-issue mise simplify \
          tea-create-issue tea-get-issue tea-plan-issue template-skill \
  -g --agent "${AGENTS[@]}" -y

