#!/usr/bin/env bash

# Synchronize agent skills through the `skills` CLI on every target.
# OWN_SKILLS_SOURCE defaults to Zihad550/skills; a local checkout works too.
# See devvm/README.md for VM skill ownership.

set -e

skill_options=()
case "${1:-}" in
  '') install_mods=1 ;;
  --skills-only) install_mods=0; skill_options=(--copy) ;;
  *) echo 'usage: setup/common/setup-skills [--skills-only]' >&2; exit 64 ;;
esac
(($# <= 1)) || exit 64
OWN_SKILLS_SOURCE="${OWN_SKILLS_SOURCE:-Zihad550/skills}"

DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
AGENTS=(claude-code cursor codex)
AGENTS_WITHOUT_PLUGIN=(cursor codex)

mise use -g npm:skills
eval "$(mise activate bash)"

######## third-party skills
# skills add JuliusBrussee/caveman --skill caveman caveman-commit caveman-compress caveman-review -g --agent "${AGENTS[@]}" -y
skills add JuliusBrussee/caveman --skill caveman-commit -g --agent "${AGENTS[@]}" -y "${skill_options[@]}"
skills add vercel-labs/skills --skill find-skills -g --agent "${AGENTS[@]}" -y "${skill_options[@]}"
skills add herdrdev/herdr --skill herdr -g --agent "${AGENTS[@]}" -y "${skill_options[@]}"
# The app embeds plain Markdown; skills requires frontmatter to discover it.
(
  herdr_skill_dir=$(mktemp -d)
  trap 'rm -rf "$herdr_skill_dir"' EXIT
  mkdir -p "$herdr_skill_dir/herdr-app"
  curl -fLsS --connect-timeout 10 --max-time 60 \
    https://raw.githubusercontent.com/herdrdev/herdr-app/master/src/SKILL.md \
    -o "$herdr_skill_dir/upstream.md"
  {
    cat <<'HEADER'
---
name: herdr-app
description: Control the Herdr desktop app and customize its layouts, keybindings, settings, and mods. Use hc for terminal and agent orchestration.
---

HEADER
    cat "$herdr_skill_dir/upstream.md"
  } > "$herdr_skill_dir/herdr-app/SKILL.md"
  skills add "$herdr_skill_dir" --skill herdr-app -g --agent "${AGENTS[@]}" -y --copy
)
skills add giuseppe-trisciuoglio/developer-kit --skill shadcn-ui -g --agent "${AGENTS[@]}" -y "${skill_options[@]}"
skills add microsoft/playwright-cli --skill playwright-cli -g --agent "${AGENTS[@]}" -y "${skill_options[@]}"
skills add max-sixty/worktrunk --skill worktrunk -g --agent "${AGENTS[@]}" -y "${skill_options[@]}"
skills add mattpocock/skills -g --agent "${AGENTS_WITHOUT_PLUGIN[@]}" -y "${skill_options[@]}"

# cursor skills
# how -> learn something about codebase, "how does X work?"
# why -> Companion to the how skill. how answers what the code does and how it works. why answers what forces led to its shape.
# blast-radius -> Companion to how and why. how tells you what the code does. why tells you why it's shaped that way. Blast radius tells you what it breaks somewhere else.
skills add https://github.com/cursor/plugins --full-depth --skill unslop deslop typescript-best-practices how why blast-radius  -g --agent "${AGENTS[@]}" -y "${skill_options[@]}"


######## our own skills, no upstream repo — sourced from github.com/Zihad550/skills
skills add "$OWN_SKILLS_SOURCE" \
  --skill codex-handoff convex-clerk-project-setup draft-gt-command-for-issue-create gh-get-issue grill-visual-hierarchy gt-create-issue \
          gt-get-issue gt-plan-issue linear-add-task mise quick-question ralph-loop ralph-loop-implement reflect ship-skill simplify summarize template-skill \
          work-backend-qa work-branch-name-gen work-draft-reply work-pr-info work-ship work-start work-wrap-up \
  -g --agent "${AGENTS[@]}" -y "${skill_options[@]}"

######## our own Claude Code mods, read in place from claude/.claude/mods
if ((install_mods)) && command -v claude >/dev/null 2>&1; then
  claude plugin marketplace add "$DOTFILES_DIR/claude/.claude/mods"
  claude plugin install drafts@dotfiles-mods --scope user
  claude plugin install lazy-diff@dotfiles-mods --scope user
elif ((install_mods)); then
  echo "setup-skills: claude not found, skipping Claude Code mods" >&2
fi

