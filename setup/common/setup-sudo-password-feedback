#!/usr/bin/env bash

# Show one asterisk for each character typed at a sudo password prompt.
#
# Caller contract:
#   DF_SUDOERS_DIR=<path>   sudoers drop-in directory; default /etc/sudoers.d

set -euo pipefail

SUDOERS_DIR="${DF_SUDOERS_DIR:-/etc/sudoers.d}"
SUDOERS_FILE="$SUDOERS_DIR/password-feedback"

command -v visudo >/dev/null 2>&1 || {
    echo "sudo password feedback: visudo is required" >&2
    exit 1
}

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

cat >"$tmp" <<'EOF'
# Managed by dotfiles setup/common/setup-sudo-password-feedback.
Defaults pwfeedback
EOF

visudo -cqf "$tmp"

if [[ $SUDOERS_DIR == /etc/sudoers.d ]]; then
    sudo install -o root -g root -m 440 "$tmp" "$SUDOERS_FILE"
else
    install -Dm 440 "$tmp" "$SUDOERS_FILE"
fi

echo "sudo password feedback enabled"
