#!/usr/bin/env bash

# Configure the one account and session that the pinned Greeter remembers.
# Keep this after the boot and Greeter installers: login policy must not change
# until those installations have succeeded.

set -euo pipefail

GREETER_ROOT="${DF_GREETER_ROOT:-/}"
MANAGED_AUTOLOGIN_MARKER="# Managed by dotfiles setup/common/greeter/login-policy"

root_path() {
	local path="$1"
	if [[ $GREETER_ROOT == / ]]; then
		printf '%s\n' "$path"
	else
		printf '%s%s\n' "${GREETER_ROOT%/}" "$path"
	fi
}

as_root() {
	if [[ $GREETER_ROOT == / ]]; then
		sudo "$@"
	else
		"$@"
	fi
}

die() {
	echo "Greeter: $*" >&2
	exit 1
}

passwd_record() {
	local user="$1"
	getent passwd "$user" 2>/dev/null |
		awk -F: -v name="$user" '$1 == name { print; exit }'
}

validate_account() {
	local user="$1" record uid

	case "$user" in
	'' | *[!A-Za-z0-9_.-]*)
		die "unsafe Greeter account name: $user"
		;;
	esac

	record="$(passwd_record "$user" || true)"
	[[ -n $record ]] || die "Greeter account does not exist: $user"
	IFS=: read -r _ _ uid _ _ _ _ <<<"$record"
	[[ $uid =~ ^[0-9]+$ ]] || die "Greeter account has an invalid UID: $user"
	(( uid != 0 )) || die "the Greeter account must not be root: $user"

	printf '%s\n' "$user"
}

human_accounts() {
	getent passwd 2>/dev/null |
		awk -F: '$3 >= 1000 && $3 < 65534 && $7 !~ /\/(nologin|false)$/ { print $1 }'
}

select_greeter_session() {
	local session_dir session
	session_dir="$(root_path /usr/share/wayland-sessions)"

	for session in omarchy.desktop hyprland-uwsm.desktop hyprland.desktop; do
		if [[ -f "$session_dir/$session" ]]; then
			printf '%s\n' "$session"
			return
		fi
	done

	die "no supported Wayland session found in $session_dir"
}

select_greeter_user() {
	local explicit="${GREETER_USER:-}" sudo_user="${SUDO_USER:-}"
	local invoking record
	local -a accounts=()

	if [[ -n $explicit ]]; then
		validate_account "$explicit"
		return
	fi

	# sudo preserves the human account in SUDO_USER while id -un becomes root.
	if [[ -n $sudo_user && $sudo_user != root ]]; then
		validate_account "$sudo_user"
		return
	fi

	invoking="$(id -un)"
	if [[ -n $invoking && $invoking != root ]]; then
		validate_account "$invoking"
		return
	fi

	mapfile -t accounts < <(human_accounts)
	if (( ${#accounts[@]} > 1 )); then
		die "ambiguous Greeter account: specify GREETER_USER on a multi-user system"
	fi
	[[ $invoking == root ]] && die "refusing to configure the Greeter as root"

	# A non-root invoking account that disappeared between id and getent is a
	# missing account, not a reason to guess from the passwd database.
	record="$(passwd_record "$invoking" || true)"
	[[ -n $record ]] || die "Greeter account does not exist: $invoking"
	die "no non-root Greeter account was selected"
}

has_effective_crypttab() {
	local crypttab
	crypttab="$(root_path /etc/crypttab)"
	[[ -f $crypttab ]] || return 1
	as_root awk '!/^[[:space:]]*(#|$)/ { found = 1; exit } END { exit !found }' "$crypttab"
}

has_encrypted_root() {
	local root_source root_type cmdline

	# A fixture root has no meaningful mount table, so use the live system only
	# when this script is pointed at the real root.
	if [[ $GREETER_ROOT == / ]]; then
		root_source="$(findmnt -n -o SOURCE / 2>/dev/null || true)"
		if [[ $root_source == /dev/mapper/* ]]; then
			return 0
		fi
		if [[ -n $root_source ]]; then
			root_type="$(lsblk -no TYPE "$root_source" 2>/dev/null | head -n1 || true)"
			[[ $root_type == crypt ]] && return 0
		fi
	fi

	cmdline="$(root_path /proc/cmdline)"
	[[ -r $cmdline ]] || return 1
	grep -Eq '(^|[[:space:]])(cryptdevice|rd\.luks\.(uuid|name))=' "$cmdline"
}

should_enable_autologin() {
	has_effective_crypttab || has_encrypted_root
}

remove_managed_autologin() {
	local autologin_file="$1"
	[[ -f $autologin_file ]] || return 0
	[[ $(head -n1 "$autologin_file") == "$MANAGED_AUTOLOGIN_MARKER" ]] || return 0
	as_root rm -f "$autologin_file"
}

write_managed_file() {
	local target="$1" content="$2" temporary
	temporary="$(mktemp)"
	printf '%s\n' "$content" >"$temporary"
	if ! as_root install -m 644 "$temporary" "$target"; then
		rm -f "$temporary"
		return 1
	fi
	rm -f "$temporary"
}

configure_login_policy() {
	local selected session state_dir state_file config_dir remember_file autologin_file
	selected="$(select_greeter_user)"
	session="$(select_greeter_session)"

	config_dir="$(root_path /etc/sddm.conf.d)"
	state_dir="$(root_path /var/lib/sddm)"
	remember_file="$config_dir/99-omarchy-login.conf"
	autologin_file="$config_dir/autologin.conf"
	state_file="$state_dir/state.conf"

	as_root install -d -m 755 "$config_dir" "$state_dir"
	write_managed_file "$remember_file" '[Users]
RememberLastUser=true
RememberLastSession=true'
	write_managed_file "$state_file" "[Last]
Session=$session
User=$selected"
	as_root chown -R sddm:sddm "$state_dir"

	if should_enable_autologin; then
		write_managed_file "$autologin_file" "$MANAGED_AUTOLOGIN_MARKER
[Autologin]
User=$selected
Session=$session"
	else
		remove_managed_autologin "$autologin_file"
	fi
}

case "${1:-}" in
	--select)
	[[ $# == 1 ]] || die "usage: login-policy [--select]"
	select_greeter_user
	;;
	'')
		configure_login_policy
	;;
	*)
		die "usage: login-policy [--select]"
	;;
esac
