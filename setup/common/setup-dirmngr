#!/usr/bin/env bash

# Point gpg's dirmngr at the system resolver, so key imports survive this box's
# DNS path.
#
# Two separate faults sit behind gpg's one vague error, and the second is why
# the default keyserver below is plaintext hkp on port 80 rather than hkps. See
# "gpg key imports: two faults behind one message" in ../arch-devbox/README.md,
# the only box that runs this.
#
# Not interchangeable with ../arch-devbox/setup-dns: that changes which resolver
# answers, this changes who asks. Either can be why gpg fails.
#
# Note the default here is a real override, not an assertion: Arch's gnupg
# already defaults to hkps://keyserver.ubuntu.com -- the broken one. In
# `gpgconf --list-options dirmngr | grep '^keyserver'`, field 8 is that
# compiled-in default and field 10 is what is actually in effect.
#
# hkps://keys.openpgp.org is the worse fallback, for an unrelated reason: it
# serves keys whose owner never verified their email with no user IDs at all,
# and gpg rejects those outright -- "no user ID", 0 imported.
#
#   ./setup-dirmngr                                             # default keyserver
#   DIRMNGR_KEYSERVER=hkps://keyserver.ubuntu.com ./setup-dirmngr

set -euo pipefail

KEYSERVER="${DIRMNGR_KEYSERVER:-hkp://keyserver.ubuntu.com:80}"

# Adds a line unless its keyword is already configured. Leaving an existing
# setting alone rather than overwriting it is the point: a hand-picked keyserver
# survives a re-run, and the script stays idempotent under init's retry.
ensure_option() {
    local conf="$1" keyword="$2" line="$3" sudo_cmd="${4:-}"

    if $sudo_cmd grep -qE "^[[:space:]]*${keyword}([[:space:]]|\$)" "$conf" 2>/dev/null; then
        echo "  $keyword: already set in $conf, left alone"
        return
    fi

    echo "$line" | $sudo_cmd tee -a "$conf" >/dev/null
    echo "  $keyword: added to $conf"
}

# --- the user keyring: what makepkg/yay actually use -------------------------

USER_GNUPGHOME="${GNUPGHOME:-$HOME/.gnupg}"
USER_CONF="$USER_GNUPGHOME/dirmngr.conf"

# gpg refuses to use a home directory group- or world-readable, and creates it
# with 700 itself; match that when we are the ones creating it.
mkdir -p "$USER_GNUPGHOME"
chmod 700 "$USER_GNUPGHOME"
touch "$USER_CONF"
chmod 600 "$USER_CONF"

echo "user keyring ($USER_GNUPGHOME):"
ensure_option "$USER_CONF" "standard-resolver" "standard-resolver"
ensure_option "$USER_CONF" "keyserver" "keyserver $KEYSERVER"

# --- pacman's keyring: a different gnupg home entirely -----------------------

PACMAN_GNUPGHOME=/etc/pacman.d/gnupg
if [[ -d "$PACMAN_GNUPGHOME" ]]; then
    PACMAN_CONF="$PACMAN_GNUPGHOME/dirmngr.conf"
    sudo touch "$PACMAN_CONF"
    echo "pacman keyring ($PACMAN_GNUPGHOME):"
    # No keyserver line here — pacman picks its own, and overriding what
    # pacman-key was initialised with is not this script's business.
    ensure_option "$PACMAN_CONF" "standard-resolver" "standard-resolver" sudo
    # Each gnupg home runs its own dirmngr, so each needs its own kill.
    sudo gpgconf --homedir "$PACMAN_GNUPGHOME" --kill dirmngr 2>/dev/null || true
else
    echo "pacman keyring: $PACMAN_GNUPGHOME not present, skipped"
fi

# A running dirmngr reads its config once, at startup, and gpg will happily
# reuse the daemon that is already up. Without this the change lands on disk and
# does nothing until the next reboot.
gpgconf --kill dirmngr 2>/dev/null || true

echo
echo "keyserver: $KEYSERVER"
echo
echo "verify with:  gpg --keyserver $KEYSERVER --recv-keys BE677C1989D35EAB2C5F26C9351601AD01D6378E"
