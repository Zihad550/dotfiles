#!/usr/bin/env bash

# Validate the commands used by the Network Page after package installation.
# This script is read-only. In particular, it never enables, disables, starts,
# stops, or selects a networking backend.

set -u

# The status helper calls the repository-owned command-presence helper.
# Include the checked-out runtime bin directory while validating, even when this
# script is launched by an installer whose interactive shell PATH is not loaded.
DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
export PATH="$DOTFILES_DIR/bin:$PATH"

required_commands=(
    nmcli
    df-cmd-present
    ip
    ping
    awk
    iw
    curl
    jq
)

# QR sharing is intentionally opt-in. The Network Page keeps all other
# controls available when qrencode is absent and disables only that action.
optional_commands=(
    qrencode
)

missing=()
for command_name in "${required_commands[@]}"; do
    command -v "$command_name" >/dev/null 2>&1 || missing+=("$command_name")
done

if ((${#missing[@]} > 0)); then
    printf 'Network Page: missing commands: %s\n' "${missing[*]}" >&2
    printf 'Install the shared Quickshell package set before using network controls.\n' >&2
else
    printf 'Network Page: required commands are available.\n'
fi

optional_missing=()
for command_name in "${optional_commands[@]}"; do
    command -v "$command_name" >/dev/null 2>&1 || optional_missing+=("$command_name")
done

if ((${#optional_missing[@]} > 0)); then
    printf 'Network Page: optional commands missing: %s (QR sharing is disabled).\n' \
        "${optional_missing[*]}" >&2
else
    printf 'Network Page: optional QR-sharing commands are available.\n'
fi

if ! command -v nmcli >/dev/null 2>&1; then
    printf 'Network Page: NetworkManager is unavailable because nmcli is missing.\n' >&2
elif [[ "$(LC_ALL=C nmcli -t -f RUNNING general 2>/dev/null || true)" == "running" ]]; then
    printf 'Network Page: NetworkManager is running.\n'
else
    printf 'Network Page: NetworkManager is not running; the Page will show an actionable unavailable state.\n' >&2
fi

exit 0
