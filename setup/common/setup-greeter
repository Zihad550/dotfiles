#!/usr/bin/env bash

# Install the pinned Greeter and Boot Branding, then retire the GDM this repo
# used to install.
# See README.md "Greeter".

set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
GREETER_DIR="$DOTFILES_DIR/setup/common/greeter"
BOOT_BRANDING_DIR="$DOTFILES_DIR/setup/common/boot-branding"

# These are explicit rather than relying on SDDM's transitive dependencies:
# the Greeter launches a Wayland compositor, loads Qt6 QML, and decodes PNGs.
sudo pacman -S --noconfirm --needed \
	sddm plymouth imagemagick qt6-wayland qt6-declarative qt6-imageformats \
	ttf-jetbrains-mono-nerd

# Boot changes are validated and rebuilt before the display-manager alias is
# changed. A failed rebuild therefore never activates a custom Greeter.
"$BOOT_BRANDING_DIR/validate"
"$BOOT_BRANDING_DIR/apply"

# Validate and stage the replacement before changing the display-manager alias.
# A broken Greeter must never be the first thing enabled on a box.
"$GREETER_DIR/validate"
"$GREETER_DIR/apply"

# Account selection and login policy are deliberately last among the Greeter
# files. Boot Branding and the Greeter must be installed before login changes.
"$GREETER_DIR/login-policy"

if systemctl is-enabled gdm.service &>/dev/null; then
	sudo systemctl disable gdm.service
fi

# --force because the display-manager.service alias may still point at gdm —
# including at a gdm unit an interrupted run already removed, which plain
# `enable` refuses to replace and which no re-run could then repair. Enabling
# is idempotent, so there is nothing to guard.
sudo systemctl enable --force sddm.service

# SDDM must not try to own the session's desktop keyring through PAM. The
# session creates the passwordless default keyring and gcr-ssh-agent owns SSH
# credentials after login; these hooks belong to GDM's login-keyring flow.
if [[ -f /etc/pam.d/sddm ]]; then
	sudo sed -i '/-auth.*pam_gnome_keyring\.so/d' /etc/pam.d/sddm
	sudo sed -i '/-password.*pam_gnome_keyring\.so/d' /etc/pam.d/sddm
fi

# Not fatal: the Greeter is already switched by this point, and aborting the
# whole install over a package pacman declines to remove is the wrong trade.
if pacman -Qq gdm &>/dev/null; then
	sudo pacman -Rs --noconfirm gdm ||
		echo "warn: gdm not removed — sddm is enabled, so remove it by hand"
fi
