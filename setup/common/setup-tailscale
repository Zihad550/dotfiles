#!/usr/bin/env bash

# Join the tailnet, so the box is reachable over ssh from anywhere without
# exposing anything to the public internet.
#
# Shared by setup/ubuntu-devbox and setup/arch-devbox. Do not run this file
# directly; run the wrapper in the target's own directory, which installs
# tailscale the way that distro does it, sets the variables below and execs
# this:
#
#   TS_AUTHKEY=tskey-auth-...  ./setup-tailscale     # unattended
#   ./setup-tailscale                                # prints a URL to open
#
# Hostname on the tailnet defaults to the machine hostname; override with
#   TS_HOSTNAME=devbox ./setup-tailscale
#
# ─── what the wrapper configures ─────────────────────────────────────────────
#   TS_TAILNET_UFW_RULE  `1`  open `in on tailscale0` here, because the target's
#                             firewall is deny-all by the time this runs and the
#                             tailnet rule does not exist yet.
#                        `0`  the target's setup-ufw runs BEFORE this and has
#                             already written that rule. It can do that before
#                             tailscaled exists because the rule names the
#                             interface -- it starts matching once tailscale0
#                             appears.
#   TS_NEXT              what to print at the end: which script to run next on
#                        this box, and any warning that belongs with it.
#
# The install itself is not configured here, it is simply done by the wrapper
# before it execs this -- `pacman -S tailscale` and the curl installer have
# nothing in common to parameterise.

set -euo pipefail

TS_TAILNET_UFW_RULE="${TS_TAILNET_UFW_RULE:-0}"
TS_NEXT="${TS_NEXT:-}"

# hostnamectl on systemd boxes; `hostname -s` needs inetutils, which Arch's base
# does not have. uname -n is the last resort. Strip any domain either way --
# `hostname -s` already has, hostnamectl has not.
TS_HOSTNAME="${TS_HOSTNAME:-$(hostnamectl --static 2>/dev/null ||
    hostname -s 2>/dev/null || uname -n)}"
TS_HOSTNAME="${TS_HOSTNAME%%.*}"
TS_AUTHKEY="${TS_AUTHKEY:-}"

# Tailscale SSH: tailnet identity + ACLs replace ~/.ssh/authorized_keys for
# connections arriving over the tailnet.
#
# Off by default, deliberately. These boxes reach sshd directly over the tailnet
# (`ssh user@<tailnet-ip>`), and ufw's `allow in on tailscale0` is what makes
# that work. Turning --ssh on changes who answers port 22 of the tailnet IP:
# tailscaled takes it in userspace, before the host stack, and sshd is shadowed
# there. That is a different access model with a different failure mode -- a
# tailnet ACL with no `ssh` section locks you out -- not an addition to this one.
#
# TS_SSH=1 opts in. If you do, note ./harden-ssh's port move stops being
# optional: sshd has to listen somewhere other than 22 to be reachable at all.
TS_SSH="${TS_SSH:-0}"

sudo systemctl enable --now tailscaled

# ─── firewall ────────────────────────────────────────────────────────────────
# Everything arriving over the tailnet lands on tailscale0 from 100.64.0.0/10.
# On a deny-all box, ssh over tailscale is dropped without this rule. Order
# matters: open the interface before `tailscale up`, not after.
if [ "$TS_TAILNET_UFW_RULE" = "1" ] && command -v ufw &>/dev/null; then
    sudo ufw allow in on tailscale0 comment 'tailnet'
    sudo ufw reload
fi

# ─── join the tailnet ────────────────────────────────────────────────────────
# --operator lets this user run tailscale commands without sudo. The quickshell
# bar's Tailscale toggle (quickshell/.../scripts/tailscale-toggle.sh) depends on
# it: there is no terminal behind that menu row to type a sudo password into, so
# without --operator every toggle falls through to a pkexec prompt.
up_args=(--hostname "$TS_HOSTNAME")
[ "$TS_SSH" = "1" ] && up_args+=(--ssh)
[ -n "$TS_AUTHKEY" ] && up_args+=(--authkey "$TS_AUTHKEY")

echo "running: tailscale up ${up_args[*]}"
if ! sudo tailscale up "${up_args[@]}"; then
    echo
    echo "tailscale up failed."
    echo "  - if you are already connected over the tailnet, re-run with:"
    echo "      sudo tailscale up ${up_args[*]} --accept-risk=lose-ssh"
    [ "$TS_SSH" = "1" ] &&
        echo "  - if --ssh was rejected, your tailnet ACL needs an ssh section"
    exit 1
fi

echo
tailscale status
echo
echo "tailnet ip: $(tailscale ip -4)"

# `tailscale up --ssh` succeeds even when the tailnet ACL has no ssh section --
# the join works, then every ssh connection is refused. Silent failure on a
# headless box, so say it out loud rather than only on the error path.
if [ "$TS_SSH" = "1" ]; then
    echo
    echo "tailscale ssh is enabled on this node. It does nothing until your"
    echo "tailnet ACL grants it (https://login.tailscale.com/admin/acls):"
    echo '  "ssh": [{'
    echo '    "action": "accept",'
    echo '    "src":    ["autogroup:member"],'
    echo '    "dst":    ["autogroup:self"],'
    echo "    \"users\":  [\"autogroup:nonroot\", \"$USER\"]"
    echo '  }]'
    echo
    echo "test from your laptop before relying on it:  ssh $USER@$TS_HOSTNAME"
else
    # Said out loud because the two models are indistinguishable until one
    # breaks: with --ssh off, nothing intercepts 22 and the box is only
    # reachable if sshd is actually running.
    echo
    echo "tailscale ssh is OFF -- remote access is sshd over the tailnet:"
    echo "  ssh $USER@$TS_HOSTNAME"
    echo "That needs sshd enabled (./setup-sshd) and a key installed"
    echo "(ssh-copy-id from your laptop). No tailnet ACL ssh section is involved."
fi

if [ -n "$TS_NEXT" ]; then
    echo
    echo "$TS_NEXT"
fi
