#!/usr/bin/env bash
set -euo pipefail

echo "Removing Snapper config for /home..."
if sudo snapper list-configs | grep -qE '^[[:space:]]*home[[:space:]]'; then
    sudo snapper -c home delete-config
    echo "Removed Snapper 'home' config."
else
    echo "Snapper 'home' config does not exist; skipping."
fi

echo
echo "Current root Snapper config:"
sudo snapper -c root get-config

# set-config, not sed on the config file directly, so this step only needs
# NOPASSWD on the snapper binary — not on cp/sed too. See init's sudoers rule.
echo
echo "Updating root Snapper retention settings..."
sudo snapper -c root set-config \
    NUMBER_LIMIT=20 \
    NUMBER_LIMIT_IMPORTANT=5 \
    TIMELINE_LIMIT_HOURLY=3 \
    TIMELINE_LIMIT_DAILY=5 \
    TIMELINE_LIMIT_WEEKLY=0 \
    TIMELINE_LIMIT_MONTHLY=0 \
    TIMELINE_LIMIT_QUARTERLY=0 \
    TIMELINE_LIMIT_YEARLY=0

echo
echo "Current Snapper configs:"
sudo snapper list-configs

echo
echo "Updated root Snapper config:"
sudo snapper -c root get-config

echo
echo "Done."
