#!/usr/bin/env bash

set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"

# `setup-herdr` is also called directly by headless profiles, before the full
# shared skill sync. Keep its one dependency here so the standalone path is
# complete and non-interactive.
mise use -g npm:skills

if command -v pacman &>/dev/null; then
    if ! pacman -Q herdr &>/dev/null; then
        echo "Herdr must be installed by the shared Arch pacman package list" >&2
        exit 1
    fi
else
    mise use -g github:herdrdev/herdr
fi

eval "$(mise activate bash)"

######## install integrations
"$DOTFILES_DIR/setup/common/setup-herdr-integrations"

######## link local plugins
# `plugin link` points herdr at each working tree, so plugins track the repo
# with no install or build step. Re-linking an already-linked plugin is a no-op.
herdr plugin link "$DOTFILES_DIR/herdr-plugins/tab-namer"
herdr plugin link "$DOTFILES_DIR/herdr-plugins/sidebar-index"

##### install skill
skills add herdrdev/herdr --skill herdr -g --agent claude-code cursor pi kilo -y
