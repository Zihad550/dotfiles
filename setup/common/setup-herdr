#!/usr/bin/env bash

set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"

# `setup-herdr` is also called directly by headless profiles, before the full
# shared skill sync. Keep its one dependency here so the standalone path is
# complete and non-interactive.
mise use -g npm:skills

if command -v pacman &>/dev/null; then
    if ! pacman -Q herdr &>/dev/null; then
        echo "Herdr must be installed by the shared Arch pacman package list" >&2
        exit 1
    fi
else
    mise use -g github:herdrdev/herdr
fi

eval "$(mise activate bash)"

######## install integrations
# Not `command -v` alone: mise keeps shims for tools that are no longer active,
# and those resolve with nothing behind them.
has_command() {
    local path
    path="$(command -v "$1")" || return 1
    [[ "$path" != */mise/shims/* ]] || mise which "$1" &>/dev/null
}

# install_integration <integration> <agent command>
install_integration() {
    if has_command "$2"; then
        herdr integration install "$1"
    else
        echo "skip: herdr $1 integration — $2 is not installed"
    fi
}

install_integration pi pi
install_integration omp omp
install_integration claude claude
install_integration codex codex
install_integration opencode opencode
install_integration kilo kilo
# install_integration cursor cursor-agent
# herdr integration install copilot
# herdr integration install devin
# herdr integration install droid
# herdr integration install kimi
# herdr integration install hermes
# herdr integration install qodercli
# herdr integration install mastracode
# herdr integration install antigravity-cli
# herdr integration install grok

######## link local plugins
# `plugin link` points herdr at each working tree, so plugins track the repo
# with no install or build step. Re-linking an already-linked plugin is a no-op.
herdr plugin link "$DOTFILES_DIR/herdr-plugins/tab-namer"
herdr plugin link "$DOTFILES_DIR/herdr-plugins/sidebar-index"

##### install skill
skills add herdrdev/herdr --skill herdr -g --agent claude-code cursor pi kilo -y
