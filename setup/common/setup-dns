#!/usr/bin/env bash

# Point systemd-resolved at explicit upstream DNS servers via a drop-in.
# Shared implementation; per-box wrappers set the variables below and exec
# this.
#
#   DNS_SERVERS=<space-separated>   required, e.g. "1.1.1.1 1.0.0.1"
#   DNS_DOMAINS=<value>             optional; default "~." (route every lookup
#                                    through DNS_SERVERS). See the comment
#                                    below before changing it.
#   DNS_DROPIN_NAME=<name>          optional; default "10-dns-override".
#                                    Becomes /etc/systemd/resolved.conf.d/<name>.conf
#   DNS_REASON=<text>               optional; goes in the file's header comment
#   DNS_FORCE=1                     optional; write the drop-in even when the
#                                    preflight below says it will break MagicDNS
#
# Why a drop-in and not editing resolved.conf directly: same reasoning as the
# sysctl.d and logind.conf.d files elsewhere in this repo — one file per
# concern, safe to remove without hand-editing a shared config, and immune to
# a package update overwriting it.

set -euo pipefail

DNS_SERVERS="${DNS_SERVERS:?set DNS_SERVERS (see the per-box wrapper)}"
DOMAINS="${DNS_DOMAINS:-~.}"
DROPIN_NAME="${DNS_DROPIN_NAME:-10-dns-override}"
REASON="${DNS_REASON:-}"
FORCE="${DNS_FORCE:-0}"

if ! systemctl cat systemd-resolved.service &>/dev/null; then
    echo "error: systemd-resolved not found — this script only knows how to" >&2
    echo "       drive that resolver. Set DNS by hand for whatever this box uses." >&2
    exit 1
fi

# ─── preflight: who actually answers a lookup on this box ────────────────────
# Two independent things decide that, and this script is only correct when they
# agree:
#
#   * /etc/nsswitch.conf. With `resolve` on the `hosts:` line, glibc calls
#     systemd-resolved over D-Bus and /etc/resolv.conf is never read.
#   * /etc/resolv.conf. Everything that does not use glibc's resolver — Go
#     binaries, containers, tailscaled's own probe — reads this file.
#
# The failure this refuses to walk into is the state where they disagree:
# resolved is in the nsswitch path (so the drop-in below is what answers glibc
# lookups) while /etc/resolv.conf is owned by something else. tailscaled probes
# that file, concludes resolved is not in charge, and falls back to "direct"
# mode -- it overwrites /etc/resolv.conf with 100.100.100.100 and registers
# nothing with resolved. Look for `dns: using "direct" mode` in
# `journalctl -u tailscaled`.
#
# Nothing then routes the tailnet suffix to MagicDNS, and `Domains=~.` below
# hands *.ts.net to DNS_SERVERS, which has never heard of your tailnet. Tailnet
# IPs keep working, tailnet names stop, and no error is printed anywhere. On a
# box reached over the tailnet that is a bad way to find out.
#
# The fix is to make resolved own /etc/resolv.conf too, which is also what
# makes tailscaled pick its resolved manager and register 100.100.100.100 on
# the tailscale0 link. Split-DNS then resolves this correctly on its own:
# resolved routes by most-specific match, so `~pumpkinseed-cat.ts.net` on
# tailscale0 beats the `~.` written below and both resolvers get what they
# want.
resolv_target="$(readlink -f /etc/resolv.conf 2>/dev/null || true)"
resolv_is_stub=0
[[ "$resolv_target" == /run/systemd/resolve/stub-resolv.conf ]] && resolv_is_stub=1

nsswitch_uses_resolved=0
grep -qE '^hosts:.*\bresolve\b' /etc/nsswitch.conf 2>/dev/null && nsswitch_uses_resolved=1

if [[ "$resolv_is_stub" == 0 && "$nsswitch_uses_resolved" == 1 ]]; then
    echo >&2
    echo "error: this box resolves through two resolvers that do not agree." >&2
    echo >&2
    echo "  /etc/nsswitch.conf sends glibc lookups to systemd-resolved, so the" >&2
    echo "  drop-in this script writes is what answers them. But /etc/resolv.conf" >&2
    echo "  is owned by something else (${resolv_target:-<none>})," >&2
    if grep -q 'generated by tailscale' /etc/resolv.conf 2>/dev/null; then
        echo "  and that something is tailscaled in \"direct\" mode -- the fallback it" >&2
        echo "  takes when it decides resolved is not in charge. It has registered" >&2
        echo "  nothing with resolved, so MagicDNS answers no glibc lookup at all." >&2
    else
        echo "  which is what makes tailscaled fall back to \"direct\" mode and stop" >&2
        echo "  registering MagicDNS with resolved." >&2
    fi
    echo >&2
    echo "  Writing Domains=$DOMAINS on top of that would send *.ts.net to" >&2
    echo "  $DNS_SERVERS, and tailnet names would silently stop resolving." >&2
    echo >&2
    echo "  Hand /etc/resolv.conf to resolved first:" >&2
    if systemctl is-active NetworkManager.service &>/dev/null; then
        echo "    printf '[main]\\ndns=systemd-resolved\\n' | sudo tee /etc/NetworkManager/conf.d/dns.conf" >&2
        echo "    sudo systemctl restart NetworkManager" >&2
    fi
    echo "    sudo ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf" >&2
    echo "    sudo systemctl restart tailscaled" >&2
    echo >&2
    echo "  Then re-run this. Confirm it took with:" >&2
    echo "    journalctl -u tailscaled -b | grep 'dns: using'   # want: resolved" >&2
    echo "    resolvectl status tailscale0                      # want: 100.100.100.100" >&2
    echo >&2
    echo "  DNS_FORCE=1 writes the drop-in anyway, if this box has no tailnet" >&2
    echo "  names to lose." >&2
    [[ "$FORCE" == "1" ]] || exit 1
    echo "DNS_FORCE=1 -- proceeding anyway." >&2
    echo >&2
fi

DROPIN_DIR=/etc/systemd/resolved.conf.d
sudo mkdir -p "$DROPIN_DIR"

{
    echo "# Written by setup/common/setup-dns."
    [[ -n "$REASON" ]] && echo "# $REASON"
    echo "[Resolve]"
    echo "DNS=$DNS_SERVERS"
    # Without this, a per-link resolver handed out by DHCP can stay authoritative
    # for lookups even with DNS= set above — resolved's split-DNS routing is
    # additive, not a replacement. "~." makes DNS_SERVERS the resolver for every
    # domain, which is the point when the DHCP-provided one is what we're routing
    # around in the first place.
    echo "Domains=$DOMAINS"
} | sudo tee "$DROPIN_DIR/$DROPIN_NAME.conf" >/dev/null

sudo systemctl restart systemd-resolved

# ─── put back what the restart just threw away ───────────────────────────────
# Every per-link DNS registration resolved holds lives in its memory and nowhere
# else, so restarting it discards the lot -- including the tailscale0 link
# tailscaled registered when it came up. tailscaled does not watch resolved and
# will not re-push on its own, so without this the restart above silently costs
# you MagicDNS until the next tailscaled restart or reboot.
#
# Toggling accept-dns is what makes it re-push. `systemctl restart tailscaled`
# also would, and is the fallback below, but it takes tailscale0 down with it
# and drops every tailnet connection -- including the ssh session this script is
# likely running in. The toggle leaves WireGuard alone.
#
# Read CorpDNS first: accept-dns=false is a deliberate choice on some boxes, and
# toggling blind would turn it on. Nothing to re-push in that case anyway.
if systemctl is-active tailscaled.service &>/dev/null; then
    if tailscale debug prefs 2>/dev/null | tr -d '[:space:]' | grep -q '"CorpDNS":true'; then
        echo
        echo "re-registering tailscale's DNS config with resolved..."
        if ! (sudo tailscale set --accept-dns=false &&
            sudo tailscale set --accept-dns=true); then
            echo
            echo "warn: could not re-apply tailscale's DNS config, and the resolved"
            echo "      restart above dropped it. Tailnet names will not resolve"
            echo "      until you run (this drops tailnet connections):"
            echo "        sudo systemctl restart tailscaled"
        fi
    fi
fi

# The remaining half of the preflight's concern. Here resolved is NOT in the
# nsswitch path, so nothing above is being silently overridden -- the drop-in is
# simply dead weight, because glibc reads /etc/resolv.conf and that file belongs
# to someone else.
if [[ "$resolv_is_stub" == 0 ]]; then
    echo
    echo "warn: /etc/resolv.conf does not point at systemd-resolved's stub"
    echo "      resolver (found: ${resolv_target:-<none>}), and resolved is not"
    echo "      on the hosts: line in /etc/nsswitch.conf either. DNS_SERVERS is"
    echo "      configured but nothing on this box consults it."
    echo "      Fix with:  sudo ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf"
fi

echo
echo "DNS servers: $DNS_SERVERS"
echo
echo "verify with:  resolvectl status"
echo "              resolvectl status tailscale0   # 100.100.100.100, if on a tailnet"
