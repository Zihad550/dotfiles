#!/usr/bin/env bash

# Point systemd-resolved at explicit upstream DNS servers via a drop-in, and
# hand /etc/resolv.conf to resolved so MagicDNS keeps working. Box Wrappers set
# one of the first two variables below and execute this Shared Setup Script.
#
#   DNS_CONFIG_FILE=<path>          install this tracked drop-in verbatim
#   DNS_SERVERS=<space-separated>   generate a drop-in instead; wins when set
#   DNS_DOMAINS=<value>             domains routed through DNS_SERVERS;
#                                    default "~." (every lookup)
#   DNS_DROPIN_NAME=<name>          optional; default "10-dns-override".
#                                    Becomes /etc/systemd/resolved.conf.d/<name>.conf
#   DNS_REASON=<text>               generated drop-in header comment; default empty
#
# See README.md "DNS and MagicDNS" for the drop-in, handoff and ordering.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="${DNS_CONFIG_FILE:-}"
DNS_SERVERS="${DNS_SERVERS:-}"
if [[ -z "$CONFIG_FILE" && -z "$DNS_SERVERS" ]]; then
    echo "error: set DNS_CONFIG_FILE or DNS_SERVERS (see the per-box wrapper)" >&2
    exit 1
fi
DOMAINS="${DNS_DOMAINS:-~.}"
DROPIN_NAME="${DNS_DROPIN_NAME:-10-dns-override}"
REASON="${DNS_REASON:-}"

STUB=/run/systemd/resolve/stub-resolv.conf
DROPIN="/etc/systemd/resolved.conf.d/$DROPIN_NAME.conf"
NM_CONF=/etc/NetworkManager/conf.d/dns.conf

if ! systemctl cat systemd-resolved.service &>/dev/null; then
    echo "error: systemd-resolved not found — this script only knows how to" >&2
    echo "       drive that resolver. Set DNS by hand for whatever this box uses." >&2
    exit 1
fi

dropin_source="$CONFIG_FILE"
if [[ -n "$DNS_SERVERS" ]]; then
    dropin_source="$(mktemp)"
    trap 'rm -f "$dropin_source"' EXIT
    {
        echo "# Written by setup/common/setup-dns."
        [[ -n "$REASON" ]] && echo "# $REASON"
        echo "[Resolve]"
        echo "DNS=$DNS_SERVERS"
        echo "Domains=$DOMAINS"
    } >"$dropin_source"
fi

# Installs $1 at $2, then runs the rest as its activation. A retry sees the file
# unchanged and skips activation, so a failed one must stop with the command.
install_and_activate() {
    local src="$1" dst="$2"
    shift 2
    sudo cmp -s "$src" "$dst" && return 0
    sudo install -Dm644 -o root -g root "$src" "$dst"
    if ! "$@"; then
        echo "error: installed $dst, but its activation failed. Run:" >&2
        echo "         $*" >&2
        exit 1
    fi
}

if command -v tailscale >/dev/null && systemctl is-active tailscaled.service &>/dev/null; then
    sudo tailscale set --accept-dns=false
fi

# Configuration first, resolv.conf last: the stub must never answer before
# resolved has its upstream servers.
sudo systemctl enable --now systemd-resolved
install_and_activate "$dropin_source" "$DROPIN" sudo systemctl restart systemd-resolved

if systemctl cat NetworkManager.service &>/dev/null; then
    nm_activate=(true)
    if systemctl is-active NetworkManager.service &>/dev/null; then
        nm_activate=(sudo systemctl reload NetworkManager)
    fi
    install_and_activate "$SCRIPT_DIR/networkmanager-dns.conf" "$NM_CONF" "${nm_activate[@]}"
fi

if [[ "$(readlink -f /etc/resolv.conf 2>/dev/null || true)" != "$STUB" ]]; then
    sudo ln -sfn "$STUB" /etc/resolv.conf
fi

echo
echo "DNS configuration: $DROPIN"
echo
echo "verify with:  resolvectl status"
echo "Add a Tailscale DNS domain with: df-tailscale-dns"
