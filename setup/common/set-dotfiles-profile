#!/usr/bin/env bash

set -euo pipefail

profile="${1:-}"

case "$profile" in
    arch-devbox|arch-workstation) ;;
    *)
        echo "usage: $0 {arch-devbox|arch-workstation}" >&2
        exit 2
        ;;
esac

profile_dir="${XDG_CONFIG_HOME:-$HOME/.config}/uwsm/env.d"
profile_file="$profile_dir/10-dotfiles-profile"

mkdir -p "$profile_dir"
temp_file=$(mktemp "$profile_dir/.10-dotfiles-profile.XXXXXX")
trap 'rm -f "$temp_file"' EXIT

printf 'export DOTFILES_PROFILE=%s\n' "$profile" >"$temp_file"
chmod 644 "$temp_file"
mv "$temp_file" "$profile_file"
trap - EXIT
