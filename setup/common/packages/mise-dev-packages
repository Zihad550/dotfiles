#!/usr/bin/env bash

set -e

runtimes=(node@24 node go pnpm uv)
agents=(claude opencode gemini)
agent_tools=(npm:skills npm:@playwright/cli)
diff_tools=(aqua:modem-dev/hunk)

# One install call downloads everything in parallel (npm: tools wait for node).
# Not fatal here: a failed tool fails again in its group's `mise use` below,
# after the groups before it are recorded. node@24 and node share a call so
# both versions stay configured.
mise install "${runtimes[@]}" "${agents[@]}" "${agent_tools[@]}" "${diff_tools[@]}" || true

mise use -g "${runtimes[@]}"
mise use -g "${agents[@]}"
mise use -g "${agent_tools[@]}"
mise use -g "${diff_tools[@]}"


