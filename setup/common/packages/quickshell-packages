#!/usr/bin/env bash

# The core runtime packages for the quickshell config in
# quickshell/.config/quickshell. Optional feature packages are documented
# separately below so a minimal install does not pull them in.
#
# Shared: arch-workstation and arch-devbox both run this, so a dependency added to
# a QML module gets declared once here rather than in two package lists.
#
# Deliberately NOT here, because they are owned by a layer underneath and would
# be installed even with the shell removed:
#   hyprland          # hyprctl, behind Quickshell.Hyprland (setup-hyprland)
#   brightnessctl     # the OSD and Idle Ladder drive it directly, so it stays
#                     # in setup-hyprland
#   ttf-nerd-fonts-symbols-mono  # the bar's one nerd glyph (packages/pacman-packages)
#   tailscale         # TailscaleService — installed by ../../*/setup-tailscale
#   pavucontrol nautilus ghostty zed  # apps the menus launch, not the shell
#
# quickshell comes from the omarchy repo, not official Arch: setup-omarchy-repos
# must have run before this.

# shellcheck source=../pacman-lib
. "$(dirname "${BASH_SOURCE[0]}")/../pacman-lib"

# quickshell - the bar, notification daemon, OSD, launcher and Session Lock
#     (one shared shell: quickshell/.config/quickshell/dotfiles)
# ttf-fira-code - every Theme.qml fontFamily in that shell; every label renders in
#     the fallback font without it
# libqalculate - qalc, behind the launcher's calculator (launcher/lib/calc.js)
# cliphist - clipboard history, behind the launcher's clipboard provider
#     (launcher/lib/clipboard.js). Needs `wl-paste --watch cliphist store`
#     running to have any history to read — started from
#     hypr/.config/hypr/lua/autostart.lua.

# wl-clipboard - wl-copy (launcher copy actions) and the wl-paste watcher above
# libnotify - notify-send. The shell's NotificationDaemon.qml is what displays
#     these; the bin/df-* scripts send them too.
# playerctl - OsdService.qml's media keys (play-pause/next/previous + status)
# qt6-imageformats - webp decoding for the Session Lock's wallpaper
#     (lock/LockSurface.qml draws ~/.config/theme/background, and the shipped
#     backgrounds are webp). Qt renders the theme background colour instead
#     without it, which looks deliberate rather than broken -- so its absence
#     shows up as a missing wallpaper, not as an error.
pacman_install \
    quickshell \
    ttf-fira-code \
    libqalculate \
    cliphist \
    wl-clipboard \
    libnotify \
    playerctl \
    qt6-imageformats
