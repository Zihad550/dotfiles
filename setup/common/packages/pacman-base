#!/usr/bin/env bash

# The pacman set that is identical on every arch target: the CLI toolkit, the
# fonts, the coreutils replacements and the compiler.
#
# Shared by arch-workstation and arch-devbox — both run this, then their own
# ./pacman-apps for the parts that actually differ (browsers, editors, media,
# gnome extras). Adding a CLI tool here reaches both machines; that is the
# point. Before this split the two lists were maintained by hand and had
# already drifted (setup/ubuntu-devbox/packages, a third copy of the same
# toolkit, dropped aichat/worktrunk/lazydocker while both arch lists kept them).
#
# NOTE: opencode, worktrunk, tea and claude-code come from the omarchy repo,
# not official Arch. `setup-omarchy-repos` must run before this.

#  core
# gum - shell script UI, also drives the installer
# aichat - commit msg generation for worktrunk
# git-delta - diff viewer
# atuin - see command history
# pastel - color generation tool
# 7zip - archives
# worktrunk - git worktree made simple
# opencode - ai tui
# tea - gh equivalent for forgejo instance
# bubblewrap socat - needed for claude code sandboxing
sudo pacman -S --noconfirm \
    curl \
    git \
    less \
    jq \
    fzf \
    man-db \
    man-pages \
    starship \
    gum \
    aichat \
    git-delta \
    atuin \
    pastel \
    lazydocker \
    lazygit \
    7zip trash-cli \
    github-cli \
    shellcheck shfmt \
    opencode \
    worktrunk \
    tea \
    rsync \
    bubblewrap socat \
    claude-code \
    ghq \
    mkcert

# net-tools \       # deprecated, ip/ss cover it
# mise \            # installed by setup-packages/setup-mise
# mission-center \
# atac \            # terminal api client
# termdown \        # terminal counter

# fonts
sudo pacman -S --noconfirm \
    ttf-jetbrains-mono \
    ttf-hack-nerd \
    noto-fonts \
    ttf-nerd-fonts-symbols-mono \
    noto-fonts-emoji \
    ttf-dejavu
# ttf-fira-code lives in ./quickshell-packages -- it is quickshell's Theme.qml
# fontFamily, so it belongs with the shell rather than being optional here.

#  alternatives to core packages
# zoxide - cd, eza - ls, ripgrep - grep, bat - cat, bottom - htop, fd - find, dust - du, procs - ps, tealdeer - tldr
sudo pacman -S --noconfirm \
    zoxide \
    eza \
    ripgrep \
    bat \
    fd \
    dust \
    procs \
    bottom \
    tealdeer

# install languages and dev tools
sudo pacman -S --noconfirm gcc
