#!/usr/bin/env bash

# The Arch devbox CLI toolkit, fonts, coreutils replacements, and compiler.
# The client workstation has its own package base so changes here do not put
# development tools on the laptop.
#
# NOTE: worktrunk, tea and herdr come from the omarchy repo, not official
# Arch. `setup-omarchy-repos` must run before this. claude and opencode are
# not here: mise-dev-packages installs them.

# shellcheck source=../pacman-lib
. "$(dirname "${BASH_SOURCE[0]}")/../pacman-lib"

#  core
# gum - shell script UI, also drives the installer
# git-delta - diff viewer
# atuin - see command history
# pastel - color generation tool
# 7zip - archives
# worktrunk - git worktree made simple
# tea - gh equivalent for forgejo instance
# bubblewrap socat - needed for claude code sandboxing

pacman_install \
    curl \
    git \
    less \
    jq \
    fzf \
    man-db \
    man-pages \
    starship \
    gum \
    git-delta \
    atuin \
    pastel \
    lazydocker \
    lazygit \
    7zip trash-cli \
    github-cli \
    shellcheck shfmt \
    worktrunk \
    tea \
    rsync \
    bubblewrap socat \
    herdr \
    ghq \
    mkcert

# Retire user-level Herdr installs after pacman has put the replacement in
# /usr/bin. Otherwise ~/.local/bin wins on PATH and hides pacman's version.
rm -f "$HOME/.local/bin/herdr"
if command -v mise &>/dev/null && mise ls herdr 2>/dev/null | grep -q herdr; then
    mise unuse -g herdr &>/dev/null || true
    mise uninstall -a herdr &>/dev/null || true
fi
rm -rf "$HOME/.local/share/mise/installs/herdr" "$HOME/.local/share/mise/shims/herdr"

# net-tools \       # deprecated, ip/ss cover it
# mission-center \
# atac \            # terminal api client
# termdown \        # terminal counter

# fonts
pacman_install \
    ttf-jetbrains-mono \
    ttf-hack-nerd \
    noto-fonts \
    ttf-nerd-fonts-symbols-mono \
    noto-fonts-emoji \
    ttf-dejavu
# ttf-fira-code lives in ./quickshell-packages -- it is quickshell's Theme.qml
# fontFamily, so it belongs with the shell rather than being optional here.

#  alternatives to core packages
# zoxide - cd, eza - ls, ripgrep - grep, bat - cat, bottom - htop, fd - find, dust - du, procs - ps, tealdeer - tldr
pacman_install \
    zoxide \
    eza \
    ripgrep \
    bat \
    fd \
    dust \
    procs \
    bottom \
    tealdeer

# install languages and dev tools
pacman_install gcc
