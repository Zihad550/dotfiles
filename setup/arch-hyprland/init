#!/usr/bin/env bash

set -eEo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"
ARCH_HYPR_DIR="$DOTFILES_DIR/setup/arch-hyprland"

export ARCH_SETUP_STATE_DIR="$HOME/.local/state/arch-setup"
mkdir -p "$ARCH_SETUP_STATE_DIR"
export LOG_FILE="$ARCH_SETUP_STATE_DIR/install.log"

# shellcheck source=utils/logging
source "$ARCH_HYPR_DIR/utils/logging"
# shellcheck source=utils/state
source "$ARCH_HYPR_DIR/utils/state"
# shellcheck source=utils/hw-detect
source "$ARCH_HYPR_DIR/utils/hw-detect"

CURRENT_STEP="init"

# logging (sourced above) owns the ERR/INT/TERM/EXIT traps, exactly like
# omarchy's errors.sh. It calls on_exit_extra (if defined) last, so we drop the
# temporary passwordless-sudo rule here.
on_exit_extra() {
    [[ -f /etc/sudoers.d/arch-setup-first-run ]] &&
        sudo /usr/bin/rm -f /etc/sudoers.d/arch-setup-first-run 2>/dev/null
}

# Bootstrap gum so the install UI works from step 1 (silent no-op if already present).
ensure_gum || true

export ARCH_SETUP_START_EPOCH=$(date +%s)

"$ARCH_HYPR_DIR/preflight"

# Passwordless access for the noisy root commands used throughout setup, so
# they never prompt mid-install. Self-removes via the cleanup trap. (Mirrors
# omarchy's preflight/first-run-mode.sh.)
sudo tee /etc/sudoers.d/arch-setup-first-run >/dev/null <<EOF
Cmnd_Alias ARCH_SETUP_CLEANUP = /usr/bin/rm -f /etc/sudoers.d/arch-setup-first-run
$USER ALL=(ALL) NOPASSWD: /usr/bin/systemctl
$USER ALL=(ALL) NOPASSWD: /usr/bin/ufw
$USER ALL=(ALL) NOPASSWD: ARCH_SETUP_CLEANUP
EOF
sudo chmod 440 /etc/sudoers.d/arch-setup-first-run

ui_header "ARCH HYPRLAND SETUP" "$(date '+%Y-%m-%d %H:%M:%S')"

run_step "system upgrade + stow" sudo pacman -Syu --noconfirm stow

# additional application icons
CURRENT_STEP="application icons"
mkdir -p "$HOME/.local/share/applications"
# Replace a stale real dir (e.g. created by an older buggy run) so ln can place
# the symlink at the exact target instead of nesting inside it.
[[ -d "$HOME/.local/share/applications/icons" && ! -L "$HOME/.local/share/applications/icons" ]] &&
    rm -rf "$HOME/.local/share/applications/icons"
ln -snf "$DOTFILES_DIR/setup/applications/icons" "$HOME/.local/share/applications/icons"

run_step "stow base" "$DOTFILES_DIR/scripts/stow/stow-base"
run_step "stow backgrounds" "$DOTFILES_DIR/scripts/stow/stow-backgrounds"
run_step "stow hyprland" "$DOTFILES_DIR/scripts/stow/stow-hyprland"

run_step "theme" "$ARCH_HYPR_DIR/theme"
run_step "gnome-theme" "$ARCH_HYPR_DIR/gnome-theme"

# package managers
run_step "omarchy repos" "$ARCH_HYPR_DIR/setup-omarchy-repos"
run_step "flatpak" "$ARCH_HYPR_DIR/setup-packages/setup-flatpak"
run_step "mise" "$ARCH_HYPR_DIR/setup-packages/setup-mise"
run_step "yay" "$ARCH_HYPR_DIR/setup-packages/setup-yay"

# packages
run_step "pacman packages" "$ARCH_HYPR_DIR/packages/pacman-packages"
run_step "yay packages" "$ARCH_HYPR_DIR/packages/yay-packages"
run_step "flatpak packages" "$ARCH_HYPR_DIR/packages/flatpak-packages"
run_step "mise packages" "$ARCH_HYPR_DIR/packages/mise-packages"

run_step "hyprland" "$ARCH_HYPR_DIR/setup-packages/setup-hyprland"
run_step "walker" "$ARCH_HYPR_DIR/setup-packages/setup-walker"

run_step "docker" "$ARCH_HYPR_DIR/setup-packages/setup-docker"
run_step "syncthing" "$ARCH_HYPR_DIR/setup-packages/setup-syncthing"
run_step "ufw" "$ARCH_HYPR_DIR/setup-packages/setup-ufw"

# Guard zsh: usermod -s is non-idempotent (records a change every run).
CURRENT_STEP="zsh"
if is_done zsh-shell; then
    ui_skip "zsh shell already configured"
else
    run_step "zsh" "$ARCH_HYPR_DIR/setup-packages/setup-zsh"
    mark_done zsh-shell
fi

# Guard apparmor: the sed appends `lsm=...` to GRUB_CMDLINE_LINUX_DEFAULT,
# which would duplicate on rerun.
CURRENT_STEP="apparmor"
if is_done apparmor; then
    ui_skip "apparmor already configured"
else
    run_step "apparmor" "$ARCH_HYPR_DIR/setup-packages/setup-apparmor"
    mark_done apparmor
fi

run_step "kanata" "$ARCH_HYPR_DIR/setup-packages/setup-kanata"

# setup-github-cli intentionally not run — needs `gh auth login` first.
# Run manually after login: ~/dotfiles/setup/arch-hyprland/setup-packages/setup-github-cli

# setup-voxtype intentionally not run — uncomment to enable.
# run_step "voxtype" "$ARCH_HYPR_DIR/setup-packages/setup-voxtype"

run_step "additional packages" "$ARCH_HYPR_DIR/packages/additional-packages"
run_step "go packages" "$ARCH_HYPR_DIR/packages/go-packages"
run_step "shell completions" "$DOTFILES_DIR/bin/df-gen-completions"

# Guard keyring: writes secret files, has built-in --check but re-running is wasteful.
CURRENT_STEP="keyring"
if "$ARCH_HYPR_DIR/keyring" --check >/dev/null 2>&1; then
    ui_skip "keyring already exists"
else
    run_step "keyring" "$ARCH_HYPR_DIR/keyring"
fi

# System-wide QoL tweaks (sysctl, sudoers, systemd timeouts).
run_step "file watchers" "$ARCH_HYPR_DIR/setup-packages/setup-file-watchers"
# run_step "sudo tries" "$ARCH_HYPR_DIR/setup-packages/setup-sudo-tries"
run_step "ssh flakiness" "$ARCH_HYPR_DIR/setup-packages/setup-ssh-flakiness"
run_step "fast shutdown" "$ARCH_HYPR_DIR/setup-packages/setup-fast-shutdown"

# Laptop-only power management. TLP chosen; auto-cpufreq is the alternative
# (mutually exclusive — don't run both). Edit here to switch.
if is_laptop; then
    run_step "tlp (laptop)" "$ARCH_HYPR_DIR/setup-packages/setup-tlp"
    # run_step "auto-cpufreq (laptop)" "$ARCH_HYPR_DIR/setup-packages/setup-auto-cpufreq"
    run_step "bluetooth (laptop)" "$ARCH_HYPR_DIR/setup-packages/setup-bluetooth"
    run_step "wifi powersave (laptop)" "$ARCH_HYPR_DIR/setup-packages/setup-wifi-powersave"
else
    ui_skip "not a laptop — skipping tlp/auto-cpufreq/bluetooth/wifi-powersave"
fi

CURRENT_STEP="useful directories"
mkdir -p ~/dev ~/dev-0 ~/.obsidian-vault

# gdm: install is idempotent via --needed; enable only if not enabled.
CURRENT_STEP="gdm"
# Output goes to the log only — direct terminal writes would corrupt the live
# log panel that the background viewer is redrawing.
sudo pacman -S --noconfirm --needed gdm >>"$LOG_FILE" 2>&1
if systemctl is-enabled gdm.service &>/dev/null; then
    ui_skip "gdm.service already enabled"
else
    sudo systemctl enable gdm.service >>"$LOG_FILE" 2>&1
fi

run_step "post-install" "$ARCH_HYPR_DIR/post-install"

touch "$ARCH_SETUP_STATE_DIR/.initialized"
ui_done "arch-hyprland setup completed"
