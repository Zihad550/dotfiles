#!/usr/bin/env bash

#  core
# xorg-xhost - needed for running timeshift
# xournalpp - pdf editor
# gum - shell script
# dosfstools - fat32 support
sudo pacman -S --noconfirm \
   curl \
   git \
   less \
   jq \
   pass \
   fzf \
   man-db \
   man-pages \
   starship \
   xorg-xhost \
   mission-center \
   xournalpp \
   zellij \
   gum \
   dosfstools \
   rclone \
   veracrypt \
   net-tools

# fonts
sudo pacman -S --noconfirm \
   ttf-jetbrains-mono \
   ttf-hack-nerd \
   noto-fonts
# sudo pacman -S --noconfirm ttf-fira-code
# sudo pacman -S --noconfirm ttf-nerd-fonts-symbols-mono

#  alternatives to core packages
# zoxide - cd, eza - ls, ripgrep - grep, bat - cat, bottom - htop, fd - find, dust - du, procs - ps, tealdeer - tldr
sudo pacman -S --noconfirm \
   zoxide \
   eza \
   ripgrep \
   bat \
   bottom \
   fd \
   dust \
   procs \
   tealdeer

# tuis
# atuin - see command history
# pastel - color generation tool
# atac - terminal api client
# termdown - terminal counter
# yazi 7zip - terminal file browser
# resvg - tui svg renderer
sudo pacman -S --noconfirm \
   atuin \
   pastel \
   lazydocker \
   lazygit \
   yazi 7zip trash-cli resvg
# atac
# termdown

# install languages and dev tools
sudo pacman -S --noconfirm gcc github-cli

# install apps
# converseen - convert and optimize img
# swappy slurp grim - screenshot
# blueberry - bluetooth
sudo pacman -S --noconfirm \
   zed \
   neovim \
   transmission-gtk \
   ghostty \
   obs-studio \
   discord \
   obsidian \
   mpv \
   converseen \
   wl-clipboard \
   swappy slurp grim \
   blueberry
# gemini

# install gnome apps
sudo pacman -S --noconfirm \
   nautilus \
   nautilus-image-converter \
   gnome-calculator \
   gnome-characters \
   gnome-disk-utility \
   gnome-font-viewer \
   gnome-keyring seahorse

sudo systemctl enable bluetooth.service

