#!/usr/bin/env bash

# mise install github:user/repo # install from github backend
# mise install npm:package-name # install from npm backend

# github:microsoft/TypeScript
# npm:turbo
# npm:@kilocode/cli
mise use -g node@24 node go rust
mise use -g deno bun uv pnpm
# mise use -g firebase graphite dotenvx
mise use -g npm:vercel npm:netlify-cli
# mise use -g npm:skills
# mise use -g npm:@fission-ai/openspec portless

# shell autocompletions
curl -fsSL https://raw.githubusercontent.com/oven-sh/bun/main/completions/bun.zsh | sudo tee /usr/share/zsh/site-functions/_bun >/dev/null

deno completions zsh | sudo tee /usr/share/zsh/site-functions/_deno >/dev/null

uvx --generate-shell-completion zsh | sudo tee /usr/share/zsh/site-functions/_uvx >/dev/null
uv --generate-shell-completion zsh | sudo tee /usr/share/zsh/site-functions/_uv >/dev/null

gt completion | sudo tee /usr/share/zsh/site-functions/_gt >/dev/null
compinit
