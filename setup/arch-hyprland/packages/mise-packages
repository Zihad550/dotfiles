#!/usr/bin/env bash

# mise install github:user/repo # install from github backend
# mise install npm:package-name # install from npm backend

# github:microsoft/TypeScript
# npm:turbo
# npm:@kilocode/cli
mise use -g node@24 node go rust
mise use -g deno bun uv pnpm
# mise use -g firebase graphite dotenvx
mise use -g npm:vercel npm:netlify-cli
# mise use -g npm:skills
# mise use -g npm:@fission-ai/openspec portless

# shell autocompletions (user-owned dir, no sudo; fpath set in .zshrc)
COMP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/site-functions"
mkdir -p "$COMP_DIR"

curl -fsSL https://raw.githubusercontent.com/oven-sh/bun/main/completions/bun.zsh > "$COMP_DIR/_bun"

deno completions zsh > "$COMP_DIR/_deno"

uvx --generate-shell-completion zsh > "$COMP_DIR/_uvx"
uv --generate-shell-completion zsh > "$COMP_DIR/_uv"

gt completion > "$COMP_DIR/_gt"

# Drop the compdump so the next zsh runs a full compinit and picks up the new
# completions immediately (the .zshrc fast path would otherwise reuse a <24h
# cached dump and ignore them).
rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/.zcompdump" "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/.zcompdump.zwc"
