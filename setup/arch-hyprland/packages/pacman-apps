#!/usr/bin/env bash

# arch-hyprland's own pacman set: everything that is NOT in ./pacman-base.
#
# The shared toolkit (CLI tools, fonts, coreutils replacements, gcc) lives in
# ./pacman-base, which init runs first. What's left here is the app layer and
# the handful of core entries arch-devbox deliberately drops — so the diff
# against arch-devbox/packages/pacman-apps is now the *whole* difference
# between the two machines.

#  core, desktop-only
# xournalpp - pdf editor
# dosfstools - fat32 support
# yazi - terminal file browser, resvg - its svg previewer
sudo pacman -S --noconfirm \
    xournalpp \
    dosfstools \
    rclone \
    veracrypt \
    yazi resvg \
    pass

# xorg-xhost \      # needed for running timeshift

# install apps
# converseen - convert and optimize img
# swappy slurp grim - screenshot
# blueberry - bluetooth
# libqalculate, cliphist and wl-clipboard are in ./quickshell-packages --
#   they are quickshell's runtime dependencies (calculator, clipboard provider,
#   wl-copy) and arch-devbox needs the same set.
sudo pacman -S --noconfirm \
    zed \
    neovim \
    transmission-gtk \
    ghostty \
    obs-studio \
    discord \
    obsidian \
    mpv \
    converseen \
    swappy slurp grim
# gemini

# install gnome apps
sudo pacman -S --noconfirm \
    nautilus \
    nautilus-image-converter \
    gnome-disk-utility \
    gnome-font-viewer \
    gnome-keyring seahorse

