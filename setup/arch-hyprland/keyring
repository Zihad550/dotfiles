#!/bin/bash

# Setup passwordless gnome-keyring default keyring
# This allows applications to store credentials securely without a master password

KEYRING_DIR="$HOME/.local/share/keyrings"
KEYRING_FILE="$KEYRING_DIR/Default_keyring.keyring"
DEFAULT_FILE="$KEYRING_DIR/default"

setup_keyring() {
    mkdir -p "$KEYRING_DIR"

    cat <<'EOF' >"$KEYRING_FILE"
[keyring]
display-name=Default keyring
ctime=$(date +%s)
mtime=0
lock-on-idle=false
lock-after=false
EOF

    cat <<'EOF' >"$DEFAULT_FILE"
Default_keyring
EOF

    chmod 700 "$KEYRING_DIR"
    chmod 600 "$KEYRING_FILE"
    chmod 644 "$DEFAULT_FILE"

    echo "Keyring created at $KEYRING_FILE"
    echo "Directory permissions: 700"
    echo "File permissions: 600"
}

if [[ "$1" == "--check" ]]; then
    if [[ -f "$KEYRING_FILE" ]]; then
        echo "Keyring already exists"
        exit 0
    else
        echo "Keyring not configured"
        exit 1
    fi
else
    setup_keyring
fi
