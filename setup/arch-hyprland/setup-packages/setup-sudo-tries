#!/usr/bin/env bash

set -euo pipefail

# Apply Omarchy's system authentication policy to system-auth and SDDM's
# autologin service. The Session Lock uses its own PAM service and tally.

AUTH_ROOT="${DF_AUTH_ROOT:-/}"
MANAGED_SUDOERS='# Managed by dotfiles setup/arch-hyprland/setup-packages/setup-sudo-tries'

root_path() {
	local path="$1"
	if [[ $AUTH_ROOT == / ]]; then
		printf '%s\n' "$path"
	else
		printf '%s%s\n' "${AUTH_ROOT%/}" "$path"
	fi
}

as_root() {
	if [[ $AUTH_ROOT == / ]]; then
		sudo "$@"
	else
		"$@"
	fi
}

die() {
	echo "Authentication policy: $*" >&2
	exit 1
}

pam_kind() {
	local line="$1"
	local -a fields=()
	[[ $line =~ ^[[:space:]]*(#|$) ]] && return 1
	read -r -a fields <<<"$line"
	[[ ${fields[2]:-} == pam_faillock.so ]] || return 1
	[[ ${fields[0]:-} == auth ]] || {
		printf 'unknown\n'
		return
	}

	if [[ ${fields[1]:-} == required && ${fields[3]:-} == preauth ]]; then
		printf 'preauth\n'
	elif [[ ${fields[1]:-} == '[default=die]' && ${fields[3]:-} == authfail ]]; then
		printf 'authfail\n'
	elif [[ ${fields[1]:-} == required && ${fields[3]:-} == authsucc ]]; then
		printf 'authsucc\n'
	else
		printf 'unknown\n'
	fi
}

is_auth_pam_permit() {
	local line="$1"
	local -a fields=()
	[[ $line =~ ^[[:space:]]*(#|$) ]] && return 1
	read -r -a fields <<<"$line"
	[[ ${fields[0]:-} == auth && ${fields[2]:-} == pam_permit.so ]]
}

valid_faillock_value() {
	local line="$1" key="$2"
	[[ $line =~ ^[[:space:]]*${key}[[:space:]]*=[[:space:]]*[0-9]+([[:space:]]*#.*)?$ ]]
}

validate_faillock() {
	local input="$1" line deny=0 unlock_time=0
	while IFS= read -r line || [[ -n $line ]]; do
		[[ $line =~ ^[[:space:]]*(#|$) ]] && continue
		if [[ $line =~ ^[[:space:]]*deny[[:space:]]*= ]]; then
			valid_faillock_value "$line" deny || die "invalid deny setting in $input"
			deny=$((deny + 1))
		elif [[ $line =~ ^[[:space:]]*unlock_time[[:space:]]*= ]]; then
			valid_faillock_value "$line" unlock_time ||
				die "invalid unlock_time setting in $input"
			unlock_time=$((unlock_time + 1))
		fi
	done <"$input"
	(( deny <= 1 )) || die "duplicate deny settings in $input"
	(( unlock_time <= 1 )) || die "duplicate unlock_time settings in $input"
}

validate_system_auth() {
	local input="$1" line kind preauth=0 authfail=0 authsucc=0
	while IFS= read -r line || [[ -n $line ]]; do
		kind="$(pam_kind "$line" || true)"
		case "$kind" in
		preauth) preauth=$((preauth + 1)) ;;
		authfail) authfail=$((authfail + 1)) ;;
		authsucc) authsucc=$((authsucc + 1)) ;;
		unknown) die "unknown pam_faillock structure in $input" ;;
		esac
	done <"$input"
	(( preauth == 1 )) || die "expected one pam_faillock preauth line in $input"
	(( authfail == 1 )) || die "expected one pam_faillock authfail line in $input"
	(( authsucc == 1 )) || die "expected one pam_faillock authsucc line in $input"
}

validate_sddm_autologin() {
	local input="$1" line kind preauth=0 authsucc=0 pam_permit=0
	while IFS= read -r line || [[ -n $line ]]; do
		kind="$(pam_kind "$line" || true)"
		case "$kind" in
		preauth) preauth=$((preauth + 1)) ;;
		authsucc) authsucc=$((authsucc + 1)) ;;
		unknown) die "unknown pam_faillock structure in $input" ;;
		esac
		if is_auth_pam_permit "$line"; then
			pam_permit=$((pam_permit + 1))
		fi
	done <"$input"
	(( preauth <= 1 )) || die "duplicate pam_faillock preauth lines in $input"
	(( authsucc <= 1 )) || die "duplicate pam_faillock authsucc lines in $input"
	(( pam_permit == 1 )) || die "expected one auth pam_permit line in $input"
}

transform_faillock() {
	local input="$1" output="$2" line deny=0 unlock_time=0
	: >"$output"
	while IFS= read -r line || [[ -n $line ]]; do
		if valid_faillock_value "$line" deny; then
			printf 'deny = 10\n' >>"$output"
			deny=1
		elif valid_faillock_value "$line" unlock_time; then
			printf 'unlock_time = 120\n' >>"$output"
			unlock_time=1
		else
			printf '%s\n' "$line" >>"$output"
		fi
	done <"$input"
	(( deny == 1 )) || printf 'deny = 10\n' >>"$output"
	(( unlock_time == 1 )) || printf 'unlock_time = 120\n' >>"$output"
}

transform_system_auth() {
	local input="$1" output="$2" line kind
	: >"$output"
	while IFS= read -r line || [[ -n $line ]]; do
		kind="$(pam_kind "$line" || true)"
		case "$kind" in
		preauth)
			printf 'auth required pam_faillock.so preauth silent deny=10 unlock_time=120\n' >>"$output"
			;;
		authfail)
			printf 'auth [default=die] pam_faillock.so authfail deny=10 unlock_time=120\n' >>"$output"
			;;
		*) printf '%s\n' "$line" >>"$output" ;;
		esac
	done <"$input"
}

transform_sddm_autologin() {
	local input="$1" output="$2" line kind inserted=0
	: >"$output"
	while IFS= read -r line || [[ -n $line ]]; do
		kind="$(pam_kind "$line" || true)"
		case "$kind" in
		preauth|authsucc) continue ;;
		esac
		printf '%s\n' "$line" >>"$output"
		if is_auth_pam_permit "$line"; then
			printf 'auth required pam_faillock.so authsucc\n' >>"$output"
			inserted=1
		fi
	done <"$input"
	(( inserted == 1 )) || die "could not insert pam_faillock authsucc in $input"
}

backup_file() {
	local target="$1" name="$2"
	if [[ -e $target || -L $target ]]; then
		as_root cp -a --no-preserve=ownership "$target" "$BACKUP_DIR/$name"
		printf 'present %s\n' "$name" | as_root tee -a "$BACKUP_DIR/manifest" >/dev/null
	else
		printf 'absent %s\n' "$name" | as_root tee -a "$BACKUP_DIR/manifest" >/dev/null
	fi
}

restore_file() {
	local target="$1" name="$2"
	as_root rm -f -- "$target"
	if [[ -f "$BACKUP_DIR/$name" ]]; then
		as_root cp -a --no-preserve=ownership "$BACKUP_DIR/$name" "$target"
	fi
}

restore_policy() {
	restore_file "$faillock_conf" faillock.conf
	restore_file "$system_auth" system-auth
	restore_file "$sddm_autologin" sddm-autologin
	restore_file "$sudoers_file" passwd-tries
}

faillock_conf="$(root_path /etc/security/faillock.conf)"
system_auth="$(root_path /etc/pam.d/system-auth)"
sddm_autologin="$(root_path /etc/pam.d/sddm-autologin)"
sudoers_file="$(root_path /etc/sudoers.d/passwd-tries)"

for input in "$faillock_conf" "$system_auth" "$sddm_autologin"; do
	[[ -f $input ]] || die "required file is missing: $input"
done
validate_faillock "$faillock_conf"
validate_system_auth "$system_auth"
validate_sddm_autologin "$sddm_autologin"

stage_dir=$(mktemp -d)
trap 'rm -rf "$stage_dir"' EXIT
transform_faillock "$faillock_conf" "$stage_dir/faillock.conf"
transform_system_auth "$system_auth" "$stage_dir/system-auth"
transform_sddm_autologin "$sddm_autologin" "$stage_dir/sddm-autologin"
printf '%s\nDefaults passwd_tries=10\n' "$MANAGED_SUDOERS" >"$stage_dir/passwd-tries"
command -v visudo >/dev/null 2>&1 || die "visudo is required to validate sudoers"
as_root visudo -cf "$stage_dir/passwd-tries" >/dev/null || die "generated sudoers file is invalid"

BACKUP_DIR="$(root_path /var/lib/dotfiles/auth-backups)/$(date +%Y%m%d-%H%M%S-%N)-$$"
as_root install -d -m 755 "$BACKUP_DIR"
as_root install -m 644 /dev/null "$BACKUP_DIR/manifest"
backup_file "$faillock_conf" faillock.conf
backup_file "$system_auth" system-auth
backup_file "$sddm_autologin" sddm-autologin
backup_file "$sudoers_file" passwd-tries

if ! {
	as_root install -Dm 644 "$stage_dir/faillock.conf" "$faillock_conf"
	as_root install -Dm 644 "$stage_dir/system-auth" "$system_auth"
	as_root install -Dm 644 "$stage_dir/sddm-autologin" "$sddm_autologin"
	as_root install -Dm 440 "$stage_dir/passwd-tries" "$sudoers_file"
}; then
	echo "Authentication policy: installation failed; restoring previous files" >&2
	restore_policy
	exit 1
fi

echo "System authentication lockout policy installed; backup: $BACKUP_DIR"
