#!/usr/bin/env bash

# Create an Ubuntu LXC on the Proxmox host.
#
#   ./create-ubuntu-lxc              ask for every value; Enter keeps the default
#   ./create-ubuntu-lxc --defaults   ask nothing; use the defaults below
#
# Every value below can also be overridden by an environment variable, which
# then becomes the default. UBUNTU_VERSION=latest picks the newest Ubuntu
# template in the catalog. Leave CT_ID empty to use the next available ID; set
# it to pin an ID and fail if it is already occupied. See ../README.md.

set -Eeuo pipefail

# ─── configuration ───────────────────────────────────────────────────────────
UBUNTU_VERSION="${UBUNTU_VERSION:-latest}"
ARCH="${ARCH:-amd64}"

CT_ID="${CT_ID:-}"
CT_HOSTNAME="${CT_HOSTNAME:-ubuntu-devbox}"
CT_USERNAME="${CT_USERNAME:-}"

CPU_COUNT="${CPU_COUNT:-1}"
RAM_MIB="${RAM_MIB:-2048}"
SWAP_MIB="${SWAP_MIB:-1024}"
DISK_GIB="${DISK_GIB:-12}"

TEMPLATE_STORAGE="${TEMPLATE_STORAGE:-local}"
ROOTFS_STORAGE="${ROOTFS_STORAGE:-local-lvm}"
BRIDGE="${BRIDGE:-vmbr0}"
IP_CONFIG="${IP_CONFIG:-dhcp}"
GATEWAY="${GATEWAY:-}"
IPV6_CONFIG="${IPV6_CONFIG:-none}"

UNPRIVILEGED="${UNPRIVILEGED:-1}"
NESTING="${NESTING:-1}"
KEYCTL="${KEYCTL:-1}"
TUN="${TUN:-1}"

ONBOOT="${ONBOOT:-0}"
START_AFTER_CREATE="${START_AFTER_CREATE:-0}"
UPDATE_TEMPLATE_CATALOG="${UPDATE_TEMPLATE_CATALOG:-1}"
SSH_AUTHORIZED_KEY_FILE="${SSH_AUTHORIZED_KEY_FILE:-/root/.ssh/authorized_keys}"

die() {
    echo "error: $*" >&2
    exit 1
}

need_command() {
    command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

validate_int() {
    local name="$1" value="$2" minimum="$3"
    [[ "$value" =~ ^[0-9]+$ ]] || die "$name must be an integer: $value"
    (( value >= minimum )) || die "$name must be >= $minimum: $value"
}

validate_bool() {
    local name="$1" value="$2"
    [[ "$value" == 0 || "$value" == 1 ]] || die "$name must be 0 or 1: $value"
}

validate_no_whitespace() {
    local name="$1" value="$2"
    [[ "$value" != *[[:space:]]* ]] || die "$name must not contain whitespace: $value"
}

validate_username() {
    local username="$1"
    [[ -z "$username" ]] && return
    [[ "$username" != root ]] || die "CT_USERNAME must not be root; leave it empty for root-only access"
    [[ "$username" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] ||
        die "CT_USERNAME must be 1-32 lowercase letters, digits, underscores, or hyphens: $username"
}

usage() {
    sed -n '3,6p' "$0" | sed 's/^# \{0,1\}//'
}

# Per-field checks, shared by validate_config and the interactive questions.
check_version() {
    [[ "$1" == latest || "$1" =~ ^[0-9]+\.[0-9]+$ ]] ||
        die "UBUNTU_VERSION must be latest or look like 26.04: $1"
}
check_arch() { [[ "$1" == amd64 || "$1" == arm64 ]] || die "unsupported ARCH: $1"; }
check_ct_id() { [[ -z "$1" ]] || validate_int CT_ID "$1" 100; }
check_hostname() {
    [[ "$1" =~ ^[A-Za-z0-9]$ || "$1" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*[A-Za-z0-9]$ ]] ||
        die "invalid CT_HOSTNAME: $1"
}
check_cpu() { validate_int CPU_COUNT "$1" 1; }
check_ram() { validate_int RAM_MIB "$1" 1; }
check_swap() { validate_int SWAP_MIB "$1" 0; }
check_disk() { validate_int DISK_GIB "$1" 1; }
check_storage() { validate_no_whitespace storage "$1"; [[ -n "$1" ]] || die "storage must not be empty"; }
check_bridge() {
    validate_no_whitespace BRIDGE "$1"
    [[ -d "/sys/class/net/$1" ]] || die "bridge does not exist: $1"
}
# IP_CONFIG, GATEWAY and IPV6_CONFIG are joined into net0 with commas.
check_net_value() {
    validate_no_whitespace "network value" "$1"
    [[ "$1" != *,* ]] || die "network value must not contain commas: $1"
}
check_key_file() {
    [[ -z "$1" || -r "$1" ]] || die "SSH_AUTHORIZED_KEY_FILE is not readable: $1"
}
check_tun() {
    (( $1 == 0 )) || [[ -e /dev/net/tun ]] || die "/dev/net/tun is unavailable on the Proxmox host"
}

# Stricter checks for answers, so a taken ID or missing storage is asked again
# rather than failing after the last question.
check_free_ct_id() {
    check_ct_id "$1"
    [[ -z "$1" ]] || ! container_exists "$1" || die "container $1 already exists"
}
check_template_storage() {
    check_storage "$1"
    require_storage "$1" template
}

# ask VAR LABEL CHECK [EMPTY_HINT]: Enter keeps $VAR. With EMPTY_HINT the
# value is optional, and "none" clears it.
ask() {
    local var="$1" label="$2" check="$3" empty_hint="${4:-}" shown reply error
    while true; do
        shown="${!var:-$empty_hint}"
        read -r -p "$label [$shown]: " reply || die "no answer for: $label"
        [[ -n "$reply" ]] || reply="${!var}"
        [[ -z "$empty_hint" || "$reply" != none ]] || reply=""
        if error="$("$check" "$reply" 2>&1)"; then
            printf -v "$var" '%s' "$reply"
            return 0
        fi
        echo "$error" >&2
    done
}

# ask_bool VAR LABEL [CHECK]: VAR holds 0 or 1.
ask_bool() {
    local var="$1" label="$2" check="${3:-}" hint reply value error
    while true; do
        if (( ${!var} == 1 )); then hint="Y/n"; else hint="y/N"; fi
        read -r -p "$label? [$hint] " reply || die "no answer for: $label"
        case "$reply" in
        "") value="${!var}" ;;
        y | Y | yes) value=1 ;;
        n | N | no) value=0 ;;
        *) echo "answer y or n" >&2; continue ;;
        esac
        if [[ -z "$check" ]] || error="$("$check" "$value" 2>&1)"; then
            printf -v "$var" '%s' "$value"
            return 0
        fi
        echo "$error" >&2
    done
}

ask_config() {
    echo "Press Enter to keep the value in brackets. Type none to clear an optional one."
    ask UBUNTU_VERSION "Ubuntu version (latest, or e.g. 26.04)" check_version
    ask ARCH "Architecture (amd64 or arm64)" check_arch
    ask CT_ID "Container ID" check_free_ct_id "next free"
    ask CT_HOSTNAME "Hostname" check_hostname
    ask CT_USERNAME "Login user" validate_username "root only"
    ask CPU_COUNT "CPU cores" check_cpu
    ask RAM_MIB "RAM in MiB" check_ram
    ask SWAP_MIB "Swap in MiB" check_swap
    ask DISK_GIB "Disk in GiB" check_disk
    ask TEMPLATE_STORAGE "Template storage" check_template_storage
    ask ROOTFS_STORAGE "Root filesystem storage" check_storage
    ask BRIDGE "Network bridge" check_bridge
    ask IP_CONFIG "IPv4 (dhcp, or e.g. 192.0.2.10/24)" check_net_value
    [[ "$IP_CONFIG" == dhcp ]] || ask GATEWAY "IPv4 gateway" check_net_value "none"
    ask IPV6_CONFIG "IPv6 (none, auto, dhcp, or an address/prefix)" check_net_value
    ask SSH_AUTHORIZED_KEY_FILE "SSH public key file" check_key_file "none"
    ask_bool UNPRIVILEGED "Unprivileged container"
    ask_bool NESTING "Nesting (Docker needs it)"
    # keyctl only applies to unprivileged containers.
    (( UNPRIVILEGED == 0 )) || ask_bool KEYCTL "keyctl (Docker needs it)"
    ask_bool TUN "Pass /dev/net/tun through (Tailscale needs it)" check_tun
    ask_bool ONBOOT "Start the container when the host boots"
    ask_bool START_AFTER_CREATE "Start the container after creating it"
    ask_bool UPDATE_TEMPLATE_CATALOG "Refresh the template catalog first"
}

prompt_container_user() {
    local reply confirmation
    CT_USER_PASSWORD=""

    [[ -n "$CT_USERNAME" ]] || return 0

    if [[ ! -t 0 ]]; then
        echo "note: no terminal is available; $CT_USERNAME will have no password"
        return 0
    fi

    # sudo needs a password, so Enter sets one.
    read -r -p "Set a password for $CT_USERNAME? [Y/n] " reply
    [[ "$reply" != n && "$reply" != N ]] || return 0

    read -r -s -p "Password for $CT_USERNAME: " CT_USER_PASSWORD
    echo
    [[ -n "$CT_USER_PASSWORD" ]] || die "password must not be empty"
    [[ "$CT_USER_PASSWORD" != *:* ]] || die "password must not contain a colon"

    read -r -s -p "Confirm password: " confirmation
    echo
    [[ "$CT_USER_PASSWORD" == "$confirmation" ]] || die "passwords do not match"
}

container_exists() {
    pct status "$1" >/dev/null 2>&1
}

resolve_ct_id() {
    if [[ -n "$CT_ID" ]]; then
        validate_int CT_ID "$CT_ID" 100
        container_exists "$CT_ID" && die "container $CT_ID already exists"
        return 0
    fi

    CT_ID="$(pvesh get /cluster/nextid 2>/dev/null | tr -d '[:space:]')"
    [[ "$CT_ID" =~ ^[0-9]+$ ]] || die "Proxmox did not return a usable next container ID"

    while container_exists "$CT_ID"; do
        CT_ID=$((CT_ID + 1))
    done

    validate_int CT_ID "$CT_ID" 100
}

require_storage() {
    local storage="$1" role="$2"
    pvesm status --storage "$storage" >/dev/null 2>&1 ||
        die "$role storage does not exist or is unavailable: $storage"
}

resolve_rootfs_storage() {
    local selection index
    local -a storages=()

    if pvesm status --storage "$ROOTFS_STORAGE" >/dev/null 2>&1; then
        return 0
    fi

    (( USE_DEFAULTS == 0 )) || die "rootfs storage does not exist or is unavailable: $ROOTFS_STORAGE"

    mapfile -t storages < <(
        pvesm status --content rootdir 2>/dev/null |
            awk 'NR > 1 && $3 == "active" { print $1 }'
    )
    ((${#storages[@]} > 0)) || die "no active storage supports container root filesystems"

    echo "rootfs storage is unavailable: $ROOTFS_STORAGE"
    echo "Available rootfs storages:"
    for ((index = 0; index < ${#storages[@]}; index++)); do
        printf '  %d) %s\n' "$((index + 1))" "${storages[index]}"
    done

    read -r -p "Select rootfs storage [1-${#storages[@]}]: " selection
    [[ "$selection" =~ ^[0-9]+$ ]] || die "storage selection must be a number"
    ((selection >= 1 && selection <= ${#storages[@]})) || die "storage selection is out of range"

    ROOTFS_STORAGE="${storages[selection - 1]}"
}

find_template() {
    local available candidate version_pattern='[0-9]+\.[0-9]+'
    local -a candidates=()

    [[ "$UBUNTU_VERSION" == latest ]] ||
        version_pattern="${UBUNTU_VERSION%%.*}\\.${UBUNTU_VERSION#*.}"

    available="$(pveam available --section system 2>/dev/null || true)"
    while IFS= read -r candidate; do
        candidate="${candidate#system/}"
        if [[ "$candidate" =~ ^ubuntu-${version_pattern}-standard_.*_${ARCH}\.tar\. ]]; then
            candidates+=("$candidate")
        fi
    done < <(printf '%s\n' "$available" | awk 'NF {print $NF}')

    ((${#candidates[@]} > 0)) || die "Ubuntu ${UBUNTU_VERSION} ${ARCH} template is unavailable; check: pveam available --section system"

    printf '%s\n' "${candidates[@]}" | sort -V | tail -n 1
}

validate_config() {
    check_version "$UBUNTU_VERSION"
    check_arch "$ARCH"
    check_ct_id "$CT_ID"
    check_hostname "$CT_HOSTNAME"
    validate_username "$CT_USERNAME"

    check_cpu "$CPU_COUNT"
    check_ram "$RAM_MIB"
    check_swap "$SWAP_MIB"
    check_disk "$DISK_GIB"

    validate_bool UNPRIVILEGED "$UNPRIVILEGED"
    validate_bool NESTING "$NESTING"
    validate_bool KEYCTL "$KEYCTL"
    validate_bool TUN "$TUN"
    validate_bool ONBOOT "$ONBOOT"
    validate_bool START_AFTER_CREATE "$START_AFTER_CREATE"
    validate_bool UPDATE_TEMPLATE_CATALOG "$UPDATE_TEMPLATE_CATALOG"

    validate_no_whitespace TEMPLATE_STORAGE "$TEMPLATE_STORAGE"
    validate_no_whitespace ROOTFS_STORAGE "$ROOTFS_STORAGE"
    check_bridge "$BRIDGE"
    check_net_value "$IP_CONFIG"
    check_net_value "$GATEWAY"
    check_net_value "$IPV6_CONFIG"
    check_key_file "$SSH_AUTHORIZED_KEY_FILE"

    check_tun "$TUN"
}

build_net_config() {
    NET_CONFIG="name=eth0,bridge=$BRIDGE,ip=$IP_CONFIG"
    [[ -z "$GATEWAY" ]] || NET_CONFIG+=",gw=$GATEWAY"

    case "$IPV6_CONFIG" in
    none) ;;
    auto | dhcp) NET_CONFIG+=",ip6=$IPV6_CONFIG" ;;
    *) NET_CONFIG+=",ip6=$IPV6_CONFIG" ;;
    esac
}

provision_user() {
    echo "creating container user $CT_USERNAME"
    pct start "$CT_ID"

    if ! pct exec "$CT_ID" -- sh -c \
        'command -v sudo >/dev/null || { apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y sudo; }' ||
        ! pct exec "$CT_ID" -- useradd --create-home --shell /bin/bash --groups sudo "$CT_USERNAME"; then
        pct stop "$CT_ID" || true
        die "failed to create container user $CT_USERNAME"
    fi

    if [[ -n "$CT_USER_PASSWORD" ]]; then
        if ! printf '%s:%s\n' "$CT_USERNAME" "$CT_USER_PASSWORD" | pct exec "$CT_ID" -- chpasswd; then
            pct stop "$CT_ID" || true
            die "failed to set the password for $CT_USERNAME"
        fi
        unset CT_USER_PASSWORD
    fi

    if [[ -n "$SSH_AUTHORIZED_KEY_FILE" ]]; then
        if ! pct exec "$CT_ID" -- install -d -m 0700 -o "$CT_USERNAME" -g "$CT_USERNAME" "/home/$CT_USERNAME/.ssh" ||
            ! pct exec "$CT_ID" -- install -m 0600 -o "$CT_USERNAME" -g "$CT_USERNAME" \
                /root/.ssh/authorized_keys "/home/$CT_USERNAME/.ssh/authorized_keys" ||
            ! pct exec "$CT_ID" -- rm -f /root/.ssh/authorized_keys; then
            pct stop "$CT_ID" || true
            die "failed to install the SSH authorized key for $CT_USERNAME"
        fi
    fi

    (( START_AFTER_CREATE == 1 )) || pct stop "$CT_ID"
}

USE_DEFAULTS=0
case "${1:-}" in
"") ;;
--defaults) USE_DEFAULTS=1 ;;
-h | --help) usage; exit 0 ;;
*) usage >&2; die "unknown argument: $1" ;;
esac
(( $# <= 1 )) || die "expected at most one argument"

need_command pct
need_command pvesh
need_command pvesm
need_command pveam
need_command awk
need_command sort
need_command tail
need_command sed

(( EUID == 0 )) || die "run this on the Proxmox host as root"

if (( USE_DEFAULTS == 0 )); then
    [[ -t 0 ]] || die "no terminal for the questions; pass --defaults to use the defaults"
    ask_config
fi

validate_config
prompt_container_user
require_storage "$TEMPLATE_STORAGE" "template"
resolve_rootfs_storage
resolve_ct_id

if (( UPDATE_TEMPLATE_CATALOG == 1 )); then
    pveam update
fi

TEMPLATE_FILE="$(find_template)"
UBUNTU_VERSION="${TEMPLATE_FILE#ubuntu-}"
UBUNTU_VERSION="${UBUNTU_VERSION%%-standard_*}"
TEMPLATE_VOLUME="${TEMPLATE_STORAGE}:vztmpl/${TEMPLATE_FILE}"

FEATURES=()
(( NESTING == 1 )) && FEATURES+=("nesting=1")
(( UNPRIVILEGED == 1 && KEYCTL == 1 )) && FEATURES+=("keyctl=1")
FEATURES_VALUE=""
if ((${#FEATURES[@]} > 0)); then
    FEATURES_VALUE="$(IFS=,; echo "${FEATURES[*]}")"
fi

build_net_config

PCT_ARGS=(
    "$CT_ID"
    "$TEMPLATE_VOLUME"
    --ostype ubuntu
    --hostname "$CT_HOSTNAME"
    --cores "$CPU_COUNT"
    --memory "$RAM_MIB"
    --swap "$SWAP_MIB"
    --rootfs "${ROOTFS_STORAGE}:${DISK_GIB}"
    --net0 "$NET_CONFIG"
    --unprivileged "$UNPRIVILEGED"
    --onboot "$ONBOOT"
    --start 0
)

[[ -z "$FEATURES_VALUE" ]] || PCT_ARGS+=(--features "$FEATURES_VALUE")
[[ -z "$SSH_AUTHORIZED_KEY_FILE" ]] || PCT_ARGS+=(--ssh-public-keys "$SSH_AUTHORIZED_KEY_FILE")

echo "creating Ubuntu ${UBUNTU_VERSION} LXC"
echo "  template: $TEMPLATE_FILE"
echo "  CT ID:    $CT_ID"
echo "  hostname: $CT_HOSTNAME"
echo "  user:     ${CT_USERNAME:-root}"
echo "  CPU:      $CPU_COUNT"
echo "  RAM:      ${RAM_MIB} MiB"
echo "  swap:     ${SWAP_MIB} MiB"
echo "  disk:     ${DISK_GIB} GiB on ${ROOTFS_STORAGE}"
echo "  network:  $NET_CONFIG"
echo "  features: ${FEATURES_VALUE:-none}"
echo "  ssh key:  ${SSH_AUTHORIZED_KEY_FILE:-none}"

if (( USE_DEFAULTS == 0 )); then
    read -r -p "Create this container? [Y/n] " reply || die "no answer; nothing was created"
    [[ "$reply" != n && "$reply" != N ]] || die "cancelled; nothing was created"
fi

if [[ -z "$(pvesm path "$TEMPLATE_VOLUME" 2>/dev/null || true)" ]]; then
    pveam download "$TEMPLATE_STORAGE" "$TEMPLATE_FILE"
fi

pct create "${PCT_ARGS[@]}"

if (( TUN == 1 )); then
    pct set "$CT_ID" --dev0 /dev/net/tun
fi

if [[ -n "$CT_USERNAME" ]]; then
    provision_user
elif (( START_AFTER_CREATE == 1 )); then
    pct start "$CT_ID"
fi

echo
echo "created container $CT_ID"
echo "status: $(pct status "$CT_ID" | sed 's/^status: //')"
echo "start:  pct start $CT_ID"
echo "enter:  pct enter $CT_ID"
