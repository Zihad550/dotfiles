#!/usr/bin/env bash

# stow
cd ~/dotfiles || exit

stow git
mkdir -p ~/.config/opencode
ln -snf ~/dotfiles/opencode/.config/opencode/agent ~/.config/opencode/agent
ln -snf ~/dotfiles/opencode/.config/opencode/command ~/.config/opencode/command
ln -snf ~/dotfiles/opencode/.config/opencode/plugin ~/.config/opencode/plugin
ln -snf ~/dotfiles/opencode/.config/opencode/AGENTS.md ~/.config/opencode/AGENTS.md
ln -snf ~/dotfiles/opencode/.config/opencode/opencode.jsonc ~/.config/opencode/opencode.jsonc
ln -snf ~/dotfiles/opencode/.config/opencode/tui.json ~/.config/opencode/tui.json
stow tmux
stow zsh # to get the aliasrc file
rm -rf ~/.bashrc
stow bash
stow coi

mkdir -p ~/.config/mise
cp ~/dotfiles/mise/.config/mise/config.toml ~/.config/mise/config.toml

mkdir -p ~/dev-0
mkdir -p ~/.kilocode
ln -snf ~/dotfiles/kilocode/.kilocode/kilo.jsonc ~/.kilocode/kilo.jsonc
ln -snf ~/dotfiles/kilocode/.kilocode/plugin ~/.kilocode/plugin
ln -snf ~/dotfiles/opencode/.config/opencode/agent ~/.kilocode/agent
ln -snf ~/dotfiles/opencode/.config/opencode/command ~/.kilocode/command
ln -snf ~/dotfiles/opencode/.config/opencode/AGENTS.md ~/.kilocode/AGENTS.md

# agents live in separate repo: https://github.com/Zihad550/.agents
[ -d ~/.agents ] || git clone https://github.com/Zihad550/.agents.git ~/.agents

mkdir -p ~/.kilocode/skills
ln -snf ~/.agents/skills/* ~/.kilocode/skills/

# sudo apt install procs -y # available from ubuntu 25.04

# install the latest version of neovim
# sudo add-apt-repository ppa:neovim-ppa/unstable -y
# sudo apt update
sudo apt install make gcc ripgrep unzip xclip neovim -y

# mise use -g neovim
mise use -g usage
# mise use -g fzf@latest
mise use -g bottom

# mise completion zsh >_mise
# sudo mkdir -p /usr/local/share/zsh/site-functions
# sudo mv _mise /usr/local/share/zsh/site-functions

# need neovim 0.10+
# git clone https://github.com/nvim-lua/kickstart.nvim.git "${XDG_CONFIG_HOME:-$HOME/.config}"/nvim

echo "now logout and log back in"
