#!/usr/bin/env bash

sudo apt update -y
sudo apt upgrade -y
# sudo apt install qemu-guest-agent -y
# sudo systemctl enable --now qemu-guest-agent.service

sudo apt install stow -y
~/dotfiles/setup/ubuntu-server/stow

~/dotfiles/setup/ubuntu-server/packages

sudo install -d -m755 -o $(id -u) -g $(id -g) /nix
curl -L https://nixos.org/nix/install | sh
source $HOME/.nix-profile/etc/profile.d/nix.sh

nix-env -iA nixpkgs.procs
nix-env -iA nixpkgs.starship
nix-env -iA nixpkgs.fastfetch
nix-env -iA nixpkgs.fzf
nix-env -iA nixpkgs.bat
nix-env -iA nixpkgs.bottom
# nix-env -iA nixpkgs.zellij

git clone https://github.com/nvim-lua/kickstart.nvim.git "${XDG_CONFIG_HOME:-$HOME/.config}"/nvim

chsh -s $(which zsh)

~/dotfiles/setup/ubuntu-server/rm-snap

echo "now logout and log back in"
