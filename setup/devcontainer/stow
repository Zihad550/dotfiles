#!/usr/bin/env bash

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
cd "$DOTFILES"

mkdir -p ~/.config
ln -snf "$DOTFILES/git/.config/git" ~/.config/git
# ln -snf "$DOTFILES/lazygit/.config/lazygit" ~/.config/lazygit

# stow mise
mkdir -p ~/.config/mise
cp ~/dotfiles/mise/.config/mise/config.toml ~/.config/mise/config.toml

mkdir -p ~/.config/worktrunk
ln -snf "$DOTFILES/worktrunk/.config/worktrunk/config.toml" ~/.config/worktrunk/config.toml
ln -snf "$DOTFILES/worktrunk/.config/worktrunk/approvals.toml" ~/.config/worktrunk/approvals.toml

rm -rf ~/.bashrc
ln -snf ~/dotfiles/bash/.bashrc ~/.bashrc
ln -snf ~/dotfiles/zsh/.config/zsh ~/.config/zsh
ln -snf ~/dotfiles/zsh/.zshenv ~/.zshenv

mkdir -p ~/.config/procs
ln -snf ~/dotfiles/procs/.config/procs ~/.config/procs

# ai tools
scripts/stow/stow-ai
