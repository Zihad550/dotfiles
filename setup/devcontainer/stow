#!/usr/bin/env bash

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
cd "$DOTFILES"

stow git
stow lazygit
stow opencode
stow kilo
stow agents
ln -snf ~/dotfiles/opencode/.config/opencode ~/.kilocode
mkdir -p ~/.kilocode/skills # correct path, after symlink
ln -snf ~/.agents/skills/* ~/.kilocode/skills/

# stow mise
mkdir -p ~/.config/mise
cp ~/dotfiles/mise/.config/mise/config.toml ~/.config/mise/config.toml

mkdir -p ~/.claude
ln -snf ~/dotfiles/.claude/settings.json ~/.claude/settings.json
