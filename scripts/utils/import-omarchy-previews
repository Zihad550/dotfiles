#!/usr/bin/env bash
# Import theme preview images into ~/.config/theme-previews/<theme>.webp.
# Sources, in order:
#   1. resources/omarchy/themes/<theme>/preview.png (upstream omarchy themes)
#   2. ~/.config/themes/<theme>/preview.{png,jpg,jpeg,webp} (user-installed)
# Previews are stored as WebP (q88) to match the rest of the preview/background
# set; an already-webp source is copied as-is to avoid a re-encode.
# Consumed by the Launcher's Themes Provider (lib/themes.js).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$SCRIPT_DIR/../.." && pwd)"
OMARCHY_SRC="$REPO/resources/omarchy/themes"
USER_SRC="$HOME/.config/themes"
DEST="$HOME/.config/theme-previews"

if ! command -v cwebp >/dev/null 2>&1; then
    echo "error: cwebp not found — install libwebp (pacman -S libwebp)" >&2
    exit 1
fi

# Emit a WebP preview from $1 (src) to $2 (.webp dest). Copy if already webp.
emit_webp() {
    local src="$1" dest="$2"
    if [[ ${src##*.} == webp ]]; then
        cp -f -- "$src" "$dest"
    else
        cwebp -q 88 -m 6 -quiet "$src" -o "$dest"
    fi
}

# DEST may be a symlink managed by stow — don't replace it. Just ensure the
# target dir exists.
mkdir -p "$DEST"

copied=0
skipped=0

if [[ -d $OMARCHY_SRC ]]; then
    for theme_dir in "$OMARCHY_SRC"/*/; do
        theme="$(basename "$theme_dir")"
        preview="$theme_dir/preview.png"
        if [[ ! -f $preview ]]; then
            echo "skip: $theme (no preview.png)"
            skipped=$((skipped + 1))
            continue
        fi

        target="$DEST/$theme.webp"
        emit_webp "$preview" "$target"
        echo "imported (omarchy): $target"
        copied=$((copied + 1))
    done
else
    echo "warn: omarchy themes dir not found: $OMARCHY_SRC" >&2
fi

if [[ -d $USER_SRC ]]; then
    for theme_dir in "$USER_SRC"/*/; do
        # Skip symlinked theme dirs (= built-ins, handled via the repo)
        [[ -L "${theme_dir%/}" ]] && continue
        theme="$(basename "${theme_dir%/}")"

        for ext in png jpg jpeg webp; do
            preview="$theme_dir/preview.$ext"
            if [[ -f $preview ]]; then
                target="$DEST/$theme.webp"
                emit_webp "$preview" "$target"
                echo "imported (user): $target"
                copied=$((copied + 1))
                break
            fi
        done
    done
fi

echo
echo "done. copied=$copied skipped=$skipped → $DEST"
