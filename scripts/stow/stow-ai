#!/usr/bin/env bash

# AI tool configs: opencode, kilocode, claude
# Re-used by devcontainer, ubuntu-devbox, ubuntu-server stow scripts.

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
cd "$DOTFILES" || exit

# agents live in separate repo: https://github.com/Zihad550/.agents
[ -d ~/.agents ] || git clone --depth 1 https://github.com/Zihad550/.agents.git ~/.agents

# opencode
stow opencode

# kilocode
# ~/.kilocode must be a real directory, not the single folded symlink `stow
# kilocode` would produce for it — otherwise every ln -snf below (and any
# runtime file kilo itself writes there) lands inside the dotfiles repo.
mkdir -p ~/.kilocode
stow -d kilocode -t ~/.kilocode .kilocode
ln -snf "$DOTFILES/opencode/.config/opencode/agent" ~/.kilocode/agent
ln -snf "$DOTFILES/opencode/.config/opencode/command" ~/.kilocode/command
ln -snf "$DOTFILES/opencode/.config/opencode/AGENTS.md" ~/.kilocode/AGENTS.md
mkdir -p ~/.kilocode/skills
ln -snf ~/.agents/skills/* ~/.kilocode/skills/

# claude
mkdir -p ~/.claude
ln -snf "$DOTFILES/.claude/settings.json" ~/.claude/settings.json
ln -snf "$DOTFILES/.claude/statusline-command.sh" ~/.claude/statusline-command.sh
mkdir -p ~/.claude/skills
find ~/.claude/skills -maxdepth 1 -xtype l -delete
ln -snf ~/.agents/skills/* ~/.claude/skills/
