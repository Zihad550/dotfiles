#!/usr/bin/env bash
set -euo pipefail

# AI tool configs: opencode, claude, codex
# Re-used by devcontainer, ubuntu-devbox, ubuntu-server stow scripts.

DOTFILES="${DOTFILES:-${DOTFILES_DIR:-$HOME/dotfiles}}"
cd "$DOTFILES" || exit

# opencode
# Share a real .config directory; OpenCode alone owns its runtime subdirectory.
mkdir -p "$HOME/.config"
stow --dir "$DOTFILES" --target "$HOME" opencode

# claude
mkdir -p ~/.claude
ln -snf "$DOTFILES/claude/.claude/settings.json" ~/.claude/settings.json
ln -snf "$DOTFILES/claude/.claude/statusline-command.sh" ~/.claude/statusline-command.sh
ln -snf "$DOTFILES/claude/.claude/agents" ~/.claude/agents
ln -snf "$DOTFILES/claude/.claude/mods" ~/.claude/mods
# ~/.claude/skills is owned by setup/common/setup-skills (--agent claude-code).

# codex
mkdir -p ~/.codex
ln -snf "$DOTFILES/codex/.codex/config.toml" ~/.codex/config.toml
