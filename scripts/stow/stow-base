#!/usr/bin/env bash
cd ~/dotfiles

# stow fonts
# stow bottom
stow ghostty
stow git
stow kanata
# stow nushell
# stow nvim
stow zsh
stow zed
mkdir -p ~/.local/share/zed/extensions
ln -snf ~/.config/zed/backup/extensions/index.json ~/.local/share/zed/extensions/index.json
$HOME/.local/share/zed/extensions
# stow zellij
# stow gemini
stow lazygit
stow opencode
stow kilo
stow agents
ln -snf ~/dotfiles/opencode/.config/opencode ~/.kilocode
mkdir -p .kilocode/skills
ln -snf ~/.agents/skills/* ~/.kilocode/skills/

stow themes
stow starship
stow ghostty
stow yazi
stow voxtype
stow tmux
stow gh-dash
# stow mise
mkdir -p ~/.config/mise
cp ~/dotfiles/mise/.config/mise/config.toml ~/.config/mise/config.toml
stow worktrunk
rm -rf ~/.bashrc
stow bash
stow branch-creator

mkdir ~/.claude
ln -snf ~/dotfiles/.claude/settings.json ~/.claude/settings.json
