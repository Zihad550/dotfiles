#!/usr/bin/env bash

set -u

script_dir="$(cd -- "${BASH_SOURCE[0]%/*}" && pwd)"

if command -v claude-desktop >/dev/null 2>&1; then
   exec "$script_dir/df-launch-special-workspace" \
      "com.anthropic.Claude" "ai" claude-desktop
fi

exec "$script_dir/df-launch-special-webapp" \
   "chrome-claude.ai__chat-Profile_2" "https://claude.ai/chat" "ai"
