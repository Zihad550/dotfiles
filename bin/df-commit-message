#!/usr/bin/env bash

set -euo pipefail

export DF_HARNESS_INSTRUCTIONS='Generate a Git commit message from the supplied prompt and diff.
Follow the requested formatting and project guidance.
Use Conventional Commits unless the prompt specifies another format.
Reference an issue only when its ID is supplied. Do not invent details.
Output only the commit message, without explanations or code fences.'
exec df-harness "$@"
