#!/bin/bash

# In lua-config mode `hyprctl dispatch <X>` is evaluated as Lua, so try the
# lua syntax first and fall back to legacy for conf mode.
rename_ws() {
   local id="$1" name="$2"
   hyprctl dispatch "hl.dsp.workspace.rename({ workspace = \"$id\", name = \"$name\" })" >/dev/null 2>&1 \
      || hyprctl dispatch renameworkspace "$id" "$name"
}

ACTIVE_WS=$(hyprctl activeworkspace -j)
WS_ID=$(echo "$ACTIVE_WS" | jq -r '.id')
WS_NAME=$(echo "$ACTIVE_WS" | jq -r '.name')

NEW_NAME=$(echo "" | walker -d -I -p "Rename workspace $WS_ID ($WS_NAME)" --theme default)

if [ -z "$NEW_NAME" ] || [ "$NEW_NAME" = "CNCLD" ]; then
    rename_ws "$WS_ID" "$WS_ID"
    exit 0
fi

rename_ws "$WS_ID" "$WS_ID-($NEW_NAME)"
notify-send "Workspace renamed" "Workspace $WS_ID: '$WS_NAME' → '$NEW_NAME'"
