#!/bin/bash

# Repository-owned NetworkManager seam for per-profile DNS selection.
# NetworkManager and its existing polkit policy own authorization; this helper
# never writes resolver files or changes profiles other than the active target.

set -uo pipefail

usage() {
  echo "Usage: df-network-dns status <interface> | apply <interface> <Automatic|Cloudflare|Google|Custom> [expected-uuid]" >&2
  exit 2
}

fail() {
  echo "df-network-dns: $*" >&2
  exit 1
}

[[ $# -ge 2 ]] || usage
action=$1
interface=$2
[[ -n $interface ]] || usage

provider_from_arg() {
  case "${1:-}" in
  Automatic|automatic|DHCP|dhcp)
    echo "Automatic"
    ;;
  Cloudflare|cloudflare)
    echo "Cloudflare"
    ;;
  Google|google)
    echo "Google"
    ;;
  Custom|custom)
    echo "Custom"
    ;;
  *)
    return 1
    ;;
  esac
}

nm_value() {
  local field=$1
  nmcli -g "$field" connection show uuid "$profile_uuid" 2>/dev/null | head -n 1
}

active_profile() {
  local connection state uuid

  connection=$(nmcli -g GENERAL.CONNECTION device show "$interface" 2>/dev/null | head -n 1)
  [[ -n $connection && $connection != "--" && $connection != "unknown" ]] || {
    echo "No active NetworkManager profile for $interface" >&2
    return 1
  }

  # GENERAL.STATE is advisory here: some NetworkManager versions omit it from
  # terse device output. A named active connection is still the route target.
  state=$(nmcli -g GENERAL.STATE device show "$interface" 2>/dev/null | head -n 1)
  if [[ -n $state && $state != 100* ]]; then
    echo "NetworkManager profile for $interface is not connected" >&2
    return 1
  fi

  uuid=$(nmcli -g connection.uuid connection show "$connection" 2>/dev/null | head -n 1)
  profile_uuid=${uuid:-$connection}
  profile_id=$(nmcli -g connection.id connection show uuid "$profile_uuid" 2>/dev/null | head -n 1)
  profile_id=${profile_id:-$connection}
}

canonical_dns() {
  printf '%s\n' "${1:-}" |
    tr -d '\\' |
    tr ',[:space:]' '\n' |
    sed '/^$/d' |
    sort |
    paste -sd, -
}

provider_for_values() {
  local ignore4=${1:-} dns4=${2:-} ignore6=${3:-} dns6=${4:-}
  local all_dns canonical4 canonical6

  all_dns=$(canonical_dns "$dns4,$dns6")
  if [[ ! $ignore4 =~ ^(1|yes|true|on)$ && ! $ignore6 =~ ^(1|yes|true|on)$ ]] ||
      [[ -z $all_dns ]]; then
    echo "Automatic"
    return
  fi

  canonical4=$(canonical_dns "$dns4")
  canonical6=$(canonical_dns "$dns6")
  if [[ $canonical4 == "1.0.0.1,1.1.1.1" &&
      ( -z $canonical6 || $canonical6 == "2606:4700:4700::1001,2606:4700:4700::1111" ) ]] ||
      [[ -z $canonical4 && $canonical6 == "2606:4700:4700::1001,2606:4700:4700::1111" ]]; then
    echo "Cloudflare"
  elif [[ $canonical4 == "8.8.4.4,8.8.8.8" &&
      ( -z $canonical6 || $canonical6 == "2001:4860:4860::8844,2001:4860:4860::8888" ) ]] ||
      [[ -z $canonical4 && $canonical6 == "2001:4860:4860::8844,2001:4860:4860::8888" ]]; then
    echo "Google"
  else
    echo "Custom"
  fi
}

print_status() {
  local ignore4 dns4 ignore6 dns6 provider
  ignore4=$(nm_value ipv4.ignore-auto-dns)
  dns4=$(nm_value ipv4.dns)
  ignore6=$(nm_value ipv6.ignore-auto-dns)
  dns6=$(nm_value ipv6.dns)
  provider=$(provider_for_values "$ignore4" "$dns4" "$ignore6" "$dns6")

  printf 'iface\t%s\n' "$interface"
  printf 'uuid\t%s\n' "$profile_uuid"
  printf 'profile\t%s\n' "$profile_id"
  printf 'provider\t%s\n' "$provider"
  printf 'ipv4_ignore_auto_dns\t%s\n' "$ignore4"
  printf 'ipv4_dns\t%s\n' "$dns4"
  printf 'ipv6_ignore_auto_dns\t%s\n' "$ignore6"
  printf 'ipv6_dns\t%s\n' "$dns6"
  printf 'dns\t%s\n' "$(canonical_dns "$dns4,$dns6")"
}

is_auth_failure() {
  [[ "$1" =~ [Aa]uthori|[Pp]ermission|[Cc]ancel|[Dd]enied|[Pp]olicy|[Pp]assword ]]
}

nm_modify() {
  local output
  if output=$(nmcli connection modify uuid "$profile_uuid" "$@" 2>&1); then
    return 0
  fi
  if is_auth_failure "$output"; then
    echo "authentication-cancelled: $output" >&2
  else
    echo "profile-update-failed: $output" >&2
  fi
  return 1
}

restore_profile() {
  nmcli connection modify uuid "$profile_uuid" \
    ipv4.ignore-auto-dns "$old_ignore4" \
    ipv4.dns "$old_dns4" \
    ipv6.ignore-auto-dns "$old_ignore6" \
    ipv6.dns "$old_dns6" >/dev/null 2>&1 || return 1
  nmcli device reapply "$interface" >/dev/null 2>&1 ||
    nmcli connection up uuid "$profile_uuid" ifname "$interface" >/dev/null 2>&1 || return 1
}

apply_profile() {
  local provider=$1 expected_uuid=${2:-} servers="${3:-}" dns4="" dns6=""
  local old_ignore4 old_dns4 old_ignore6 old_dns6 changed=false output

  cleanup_apply() {
    local status=$?
    trap - EXIT INT TERM
    if [[ $status -ne 0 && $changed == true ]]; then
      if restore_profile; then
        echo "rollback-complete: previous DNS restored" >&2
      else
        echo "rollback-failed: could not restore previous DNS" >&2
      fi
    fi
    exit "$status"
  }
  trap cleanup_apply EXIT
  trap 'exit 130' INT TERM

  [[ -n $expected_uuid && $profile_uuid != "$expected_uuid" ]] && {
    echo "profile-changed: active profile is $profile_uuid, expected $expected_uuid" >&2
    return 1
  }

  old_ignore4=$(nm_value ipv4.ignore-auto-dns)
  old_dns4=$(nm_value ipv4.dns)
  old_ignore6=$(nm_value ipv6.ignore-auto-dns)
  old_dns6=$(nm_value ipv6.dns)

  case "$provider" in
  Automatic)
    ;;
  Cloudflare)
    dns4="1.1.1.1 1.0.0.1"
    dns6="2606:4700:4700::1111 2606:4700:4700::1001"
    ;;
  Google)
    dns4="8.8.8.8 8.8.4.4"
    dns6="2001:4860:4860::8888 2001:4860:4860::8844"
    ;;
  Custom)
    if [[ -z $servers ]]; then
      IFS= read -r servers || true
    fi
    servers=$(printf '%s\n' "$servers" | tr ',\t' ' ' | xargs)
    [[ -n $servers ]] || {
      echo "custom-validation-failed: at least one DNS server is required" >&2
      return 1
    }
    # A custom server is an IP address, optionally with NetworkManager's
    # dns+transport:// prefix. Hostnames are rejected to keep the profile
    # setting unambiguous and avoid handing shell syntax to nmcli.
    local server clean
    for server in $servers; do
      clean=${server#dns+tls://}
      clean=${clean#dns+udp://}
      clean=${clean%%#*}
      clean=${clean#[}
      clean=${clean%]}
      [[ $clean =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ||
        ( $clean == *:* && $clean != "::" && $clean =~ ^[0-9A-Fa-f:]+$ ) ]] || {
        echo "custom-validation-failed: invalid DNS server $server" >&2
        return 1
      }
      if [[ $clean =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
        IFS=. read -r -a octets <<< "$clean"
        for octet in "${octets[@]}"; do
          (( octet <= 255 )) || {
            echo "custom-validation-failed: invalid DNS server $server" >&2
            return 1
          }
        done
        dns4+="${dns4:+ }$clean"
      else
        dns6+="${dns6:+ }$clean"
      fi
    done
    ;;
  *)
    echo "Unsupported DNS provider" >&2
    return 1
    ;;
  esac

  if [[ "$provider" == Automatic ]]; then
    if ! nm_modify \
      ipv4.ignore-auto-dns no ipv4.dns "" \
      ipv6.ignore-auto-dns no ipv6.dns ""; then
      return 1
    fi
  elif ! nm_modify \
      ipv4.ignore-auto-dns yes ipv4.dns "$dns4" \
      ipv6.ignore-auto-dns yes ipv6.dns "$dns6"; then
    return 1
  fi
  changed=true

  if ! output=$(nmcli connection up uuid "$profile_uuid" ifname "$interface" 2>&1); then
    if restore_profile; then
      if is_auth_failure "$output"; then
        echo "authentication-cancelled: $output; previous DNS restored" >&2
      else
        echo "reconnect-failed: previous DNS restored" >&2
      fi
    else
      echo "rollback-failed: could not restore previous DNS" >&2
    fi
    changed=false
    return 1
  fi

  printf 'reconnection-required\n'
  printf 'profile\t%s\n' "$profile_uuid"
  printf 'provider\t%s\n' "$provider"
  changed=false
}

case "$action" in
status|read|get)
  [[ $# -eq 2 ]] || usage
  active_profile || exit 1
  print_status
  ;;
apply|set)
  [[ $# -eq 3 || $# -eq 4 ]] || usage
  provider=$(provider_from_arg "${3:-}") || {
    echo "Unsupported DNS provider: ${3:-}" >&2
    exit 2
  }
  expected_uuid="${4:-}"
  active_profile || exit 1
  apply_profile "$provider" "$expected_uuid"
  ;;
*)
  usage
  ;;
esac
