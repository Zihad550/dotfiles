#!/usr/bin/env bash

set -u

step() { printf '\n\033[1;34m==>\033[0m %s\n' "$1"; }
ok() { printf '\033[1;32mok:\033[0m %s\n' "$1"; }
warn() { printf '\033[1;33mwarn:\033[0m %s\n' "$1"; }

step "Denying SSH via ufw"
if ! command -v ufw >/dev/null 2>&1; then
    warn "ufw not installed; skipping"
else
    sudo ufw deny SSH && sudo systemctl restart ufw.service && sudo ufw reload && ok "SSH denied"
fi

step "Disabling sshd"
if [ ! -e /usr/lib/systemd/system/sshd.service ]; then
    warn "sshd.service not present; skipping"
elif ! systemctl is-enabled --quiet sshd.service 2>/dev/null && ! systemctl is-active --quiet sshd.service; then
    ok "sshd already disabled"
else
    sudo systemctl disable --now sshd.service && ok "sshd disabled and stopped"
fi

printf '\n\033[1;32mCleanup complete.\033[0m\n'
