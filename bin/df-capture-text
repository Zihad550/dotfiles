#!/usr/bin/env bash

# DF_OCR_LANGS selects installed Tesseract languages and defaults to English.

freeze_pid=""

cleanup_freeze() {
   [[ -n "$freeze_pid" ]] && kill "$freeze_pid" 2>/dev/null
}

trap cleanup_freeze EXIT

hyprpicker -r -z >/dev/null 2>&1 &
freeze_pid=$!
sleep 0.1

selection=$(slurp 2>/dev/null)
[[ -n "$selection" ]] || exit 0

text=$(grim -g "$selection" - |
   tesseract stdin stdout --oem 1 --psm 6 -l "${DF_OCR_LANGS:-eng}" \
      --dpi 300 -c preserve_interword_spaces=1 2>/dev/null) || exit 1
[[ -n "$text" ]] || exit 1

printf '%s' "$text" | wl-copy
notify-send "OCR" "Copied text from selection to clipboard"
