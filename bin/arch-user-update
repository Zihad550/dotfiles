#!/usr/bin/env bash

# setup
# mkdir -p ~/.config/systemd/user && cp ~/dotfiles/setup/systemd/user/arch-user-update.service ~/.config/systemd/user/ && cp ~/dotfiles/setup/systemd/user/arch-user-update.timer ~/.config/systemd/user/
# systemctl --user daemon-reload && systemctl --user enable arch-user-update.timer && systemctl --user start arch-user-update.timer
# mkdir -p $HOME/.cache/arch-user-update

# Arch Linux update script with checks, logging, and notifications

CACHE_DIR="$HOME/.cache/arch-user-update"
LOG_FILE="$HOME/.cache/arch-user-update.log"
NOTIFY_ICON="~/dotfiles/archlinux.svg"

# Function to log messages
log() {
   echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >>"$LOG_FILE"
}

# Function to send notification
notify() {
   if command -v notify-send >/dev/null 2>&1; then
      notify-send -i "$NOTIFY_ICON" "Arch Update" "$1"
   fi
}

# Check if Saturday (1=Monday, 7=Sunday, 6=Saturday)
if [ "$(date +%u)" != "6" ]; then
   notify "Update skipped: Not Saturday"
   exit 0
fi

# Check if time between 06:00 and 21:00
current_hour=$(date +%H)
if [ "$current_hour" -lt 6 ] || [ "$current_hour" -gt 21 ]; then
   notify "Update skipped: Not between 06:00 and 21:00"
   exit 0
fi

# Check daily flag
flag_file="$CACHE_DIR/arch-user-update-ran-$(date +%Y-%m-%d)"
if [ -f "$flag_file" ]; then
   exit 0
fi

# Check internet connectivity
if ! ping -c 1 -W 5 archlinux.org >/dev/null 2>&1; then
   log "No internet connection. Aborting update."
   notify "Update failed: No internet connection."
   exit 1
fi

log "Starting Arch Linux update..."

# Update packages
# Update flatpak if available
if command -v flatpak >/dev/null 2>&1; then
   log "Starting flatpak update..."
   flatpak update -y >>"$LOG_FILE" 2>&1 &
else
   log "Flatpak update failed."
   notify "Flatpak update failed. Check $LOG_FILE for details."
fi

# Update mise if available
if command -v mise >/dev/null 2>&1; then
   log "Starting mise update..."
   mise up >>"$LOG_FILE" 2>&1 &
else
   log "Mise Package update failed."
   notify "Mise update failed. Check $LOG_FILE for details."
   exit 1
fi

touch "$flag_file"

log "Update process completed."
