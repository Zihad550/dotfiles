#!/usr/bin/env bash

# Open the walker/elephant menu to select a background from ~/.config/backgrounds.
# Selecting an entry runs df-theme-bg-set on the chosen file.

set -e

# Ensure elephant is running
if ! pgrep -x elephant >/dev/null; then
  setsid uwsm-app -- elephant &
fi

# Ensure walker service is running
if ! pgrep -f "walker --gapplication-service" >/dev/null; then
  setsid uwsm-app -- walker --gapplication-service &
fi

exec walker -m menus:dotfilesBackgrounds --width 800 --maxheight 500 --minheight 500 "$@"
