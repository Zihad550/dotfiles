#!/usr/bin/env bash

# Toggle a monitor off/on. Re-enabling restores the last-used layout for the
# connected display set, including orientation and relative positions.

monitor=$1
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
DISPLAY_LAYOUT=${DF_HYPR_DISPLAY_LAYOUT:-"$SCRIPT_DIR/df-hypr-display-layout"}

# setsid uwsm-app -- swaybg -i "$HOME/.config/theme/background" -m solid_color
if hyprctl monitors | grep -q "^Monitor $monitor"; then
    # monitor exists → close/disable it
    hyprctl eval "hl.monitor({ output = '$monitor', disabled = true })"
else
    "$DISPLAY_LAYOUT" apply --quiet
fi
