#!/usr/bin/env bash

monitor=$1

# setsid uwsm-app -- swaybg -i "$HOME/.config/theme/background" -m solid_color
if hyprctl monitors | grep -q "^Monitor $monitor"; then
    # monitor exists → close/disable it
    hyprctl eval "hl.monitor({ output = '$monitor', disabled = true })"
else
    # monitor does not exist → start/enable it
    if [ "$monitor" = "eDP-1" ]; then
        hyprctl eval "hl.monitor({ output = '$monitor', mode = 'preferred', position = '1080x860', scale = '1', disabled = false })"
    elif [ "$monitor" = "HDMI-A-1" ]; then
        hyprctl eval "hl.monitor({ output = '$monitor', mode = '1920x1080@75', position = '0x0', scale = '1', transform = 1, reserved = '340 0 40 0', disabled = false })"
    fi
fi
