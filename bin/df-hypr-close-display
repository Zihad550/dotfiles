#!/usr/bin/env bash

# List or toggle connected Hyprland outputs for the Launcher display Provider.

set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
DISPLAY_LAYOUT=${DF_HYPR_DISPLAY_LAYOUT:-"$SCRIPT_DIR/df-hypr-display-layout"}
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/hypr"
MANUAL_DISABLED_FILE="$STATE_DIR/manual-disabled-monitors"

die() {
    echo "error: $*" >&2
    exit 1
}

monitors_json() {
    local output
    output=$(hyprctl monitors all -j 2>/dev/null) || die "Hyprland did not return its displays"
    jq -e 'type == "array"' >/dev/null 2>&1 <<<"$output" ||
        die "Hyprland returned an invalid display list"
    printf '%s' "$output"
}

list_displays() {
    monitors_json | jq '[
        .[]
        | select((.name // "") != "")
        | {
            name,
            description: (.description // ""),
            enabled: (.disabled != true),
            focused: (.focused == true)
        }
    ]'
}

valid_monitor_name() {
    [[ $1 =~ ^[A-Za-z0-9._-]+$ ]]
}

is_manually_disabled() {
    local monitor="${1:-}"
    valid_monitor_name "$monitor" || return 1
    [[ -f $MANUAL_DISABLED_FILE ]] && grep -Fxq -- "$monitor" "$MANUAL_DISABLED_FILE"
}

set_manually_disabled() {
    local monitor="$1" tmp
    mkdir -p "$STATE_DIR"
    tmp=$(mktemp "$STATE_DIR/.manual-disabled-monitors.XXXXXX")
    {
        if [[ -f $MANUAL_DISABLED_FILE ]]; then
            grep -E '^[A-Za-z0-9._-]+$' "$MANUAL_DISABLED_FILE" || true
        fi
        printf '%s\n' "$monitor"
    } | sort -u >"$tmp"
    mv -f "$tmp" "$MANUAL_DISABLED_FILE"
}

clear_manually_disabled() {
    local monitor="$1" tmp
    [[ -f $MANUAL_DISABLED_FILE ]] || return 0
    tmp=$(mktemp "$STATE_DIR/.manual-disabled-monitors.XXXXXX")
    grep -Fvx -- "$monitor" "$MANUAL_DISABLED_FILE" >"$tmp" || true
    if [[ -s $tmp ]]; then
        mv -f "$tmp" "$MANUAL_DISABLED_FILE"
    else
        rm -f "$tmp" "$MANUAL_DISABLED_FILE"
    fi
}

toggle_display() {
    local monitor="${1:-}" monitors enabled active_count

    valid_monitor_name "$monitor" || die "invalid display name: $monitor"
    monitors=$(monitors_json)
    enabled=$(jq -er --arg monitor "$monitor" '
        first(.[] | select(.name == $monitor))
        | if .disabled == true then "false" else "true" end
    ' <<<"$monitors") || die "display not found: $monitor"

    if [[ $enabled == true ]]; then
        active_count=$(jq '[.[] | select(.disabled != true)] | length' <<<"$monitors")
        ((active_count > 1)) || die "cannot turn off the last active display"
        set_manually_disabled "$monitor"
        if ! hyprctl eval "hl.monitor({ output = '$monitor', disabled = true })"; then
            clear_manually_disabled "$monitor"
            return 1
        fi
    else
        clear_manually_disabled "$monitor"
        "$DISPLAY_LAYOUT" apply --quiet
    fi
}

case "${1:-}" in
    list)
        [[ $# == 1 ]] || die "usage: df-hypr-close-display list"
        list_displays
        ;;
    toggle)
        [[ $# == 2 ]] || die "usage: df-hypr-close-display toggle DISPLAY"
        toggle_display "$2"
        ;;
    is-disabled)
        [[ $# == 2 ]] || die "usage: df-hypr-close-display is-disabled DISPLAY"
        is_manually_disabled "$2"
        ;;
    "")
        die "usage: df-hypr-close-display list | toggle DISPLAY"
        ;;
    *)
        [[ $# == 1 ]] || die "usage: df-hypr-close-display list | toggle DISPLAY"
        toggle_display "$1"
        ;;
esac
