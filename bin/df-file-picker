#!/usr/bin/env bash

# Open the walker/elephant menu to pick a file inside a folder.
# Type a folder name -> matching folders, each followed by its contents.
# Default Return → open in Zed.
# Shift+Return → open submenu to choose the app.
#
# No cache of its own: menus/dotfiles_files.lua reads the directory picker's
# folder list and then lists one directory level on demand. df-dir-picker is what
# keeps that list fresh.

set -e

if ! pgrep -x elephant >/dev/null; then
  setsid uwsm-app -- elephant &
fi

if ! pgrep -f "walker --gapplication-service" >/dev/null; then
  setsid uwsm-app -- walker --gapplication-service &
fi

exec walker -m menus:dotfilesFiles --width 800 --maxheight 500 --minheight 500 "$@"
