#!/usr/bin/env bash

# Run the setup steps that must happen AFTER the first reboot, when mise is
# active and tools (go, deno, uv, ...) are on PATH. Idempotent — safe to re-run.
#
#   ~/dotfiles/bin/df-arch-workstation-post-install

set -u

DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
ARCH_WORKSTATION_DIR="$DOTFILES_DIR/setup/arch-workstation"

# Make mise-managed tools available even if this is run from a non-login shell.
export PATH="${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims:$DOTFILES_DIR/bin:$PATH"
if command -v mise >/dev/null 2>&1; then
    eval "$(mise activate bash --shims)" 2>/dev/null || true
fi

step() { printf '\n\033[1;34m==>\033[0m %s\n' "$1"; }
ok() { printf '\033[1;32mok:\033[0m %s\n' "$1"; }
warn() { printf '\033[1;33mwarn:\033[0m %s\n' "$1"; }

# Note: shell completions and go tools now run inline during `init` (they only
# needed mise's shims on PATH, which the setup steps provide). This script is
# kept for the steps that genuinely can't run unattended during setup.

# Go tools (idempotent re-run; also runs during init) ------------------------

# Allow SSH so other machines can connect (idempotent) -----------------------
step "Allowing SSH via ufw"
if ! command -v ufw >/dev/null 2>&1; then
    warn "ufw not installed; skipping"
else
    sudo ufw allow SSH && sudo systemctl restart ufw.service && sudo ufw reload && ok "SSH allowed"

fi

# Enable SSH daemon (idempotent) ---------------------------------------------
step "Enabling sshd"
if ! command -v sshd >/dev/null 2>&1 && [ ! -e /usr/lib/systemd/system/sshd.service ]; then
    warn "openssh not installed; skipping"
elif systemctl is-enabled --quiet sshd.service 2>/dev/null && systemctl is-active --quiet sshd.service; then
    ok "sshd already enabled and running"
else
    sudo systemctl enable --now sshd.service && ok "sshd enabled and started"
fi

# 3. GitHub CLI config (needs an authenticated gh) ---------------------------
step "Configuring GitHub CLI"
if ! command -v gh >/dev/null 2>&1; then
    warn "gh not installed; skipping"
elif gh auth status >/dev/null 2>&1; then
    "$ARCH_WORKSTATION_DIR/setup-packages/setup-github-cli" && ok "gh configured"
else
    warn "gh not authenticated. Run 'gh auth login' first, then re-run this script."
fi

printf '\n\033[1;32mPost-install complete.\033[0m Open a new shell (exec zsh) to pick up changes.\n'
