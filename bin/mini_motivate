#!/usr/bin/env bash

# Script to conditionally open mini-motivate project or YouTube based on time of day

PROJECT_DIR="$HOME/dev/mini-projects/mini-motivate"
SERVER_URL="http://localhost:4173"
YOUTUBE_URL="https://www.youtube.com"
BROWSER="helium-browser --profile-directory='Profile 2'"

# Get current hour (24-hour format)
current_hour=$(date +%H)

# Check if current time is between 1am (01) and 6pm (18)
if [ "$current_hour" -ge 1 ] && [ "$current_hour" -lt 18 ]; then
   # Time is 1am-8pm, open motivate app

   # Check if the project directory exists
   if [ ! -d "$PROJECT_DIR" ]; then
      echo "Error: Project directory $PROJECT_DIR does not exist"
      exit 1
   fi

   # Navigate to the project directory
   cd "$PROJECT_DIR" || exit 1

   # Check if pnpm is available
   if ! command -v pnpm &>/dev/null; then
      echo "Error: pnpm is not installed or not in PATH"
      exit 1
   fi

   # Check if helium-browser is available
   if ! command -v helium-browser &>/dev/null; then
      echo "Error: helium-browser is not installed or not in PATH"
      echo "Please install helium-browser or update the script with your preferred browser command"
      exit 1
   fi

   # Start the preview server in background and open browser
   echo "Starting pnpm preview server for mini-motivate..."
   echo "Opening $SERVER_URL in helium-browser..."

   # Start the server in background and open browser
   (pkill -f "pnpm preview" && pnpm preview) &

   # Wait a moment for server to start
   sleep 3

   # Open the URL in helium-browser
   if command -v helium-browser &>/dev/null; then
      uwsm-app -- helium-browser --profile-directory='Profile 2' --new-window --ozone-platform=wayland --app="$SERVER_URL"
   else
      echo "Error: helium-browser is not installed or not in PATH"
   fi

   echo "Server started at $SERVER_URL"
   echo "Press Ctrl+C to stop the server"
else
   # Time is outside 1am-6pm, open YouTube

   # Check if helium-browser is available
   if ! command -v helium-browser &>/dev/null; then
      echo "Error: helium-browser is not installed or not in PATH"
      echo "Please install helium-browser or update the script with your preferred browser command"
      exit 1
   fi

   echo "Current time is outside 1am-8pm range, opening YouTube instead..."

   # Open YouTube in helium-browser
   if command -v helium-browser &>/dev/null; then
      # helium-browser "$YOUTUBE_URL"
      uwsm-app -- helium-browser --profile-directory='Profile 2' --new-window --ozone-platform=wayland --app="$YOUTUBE_URL"
   else
      echo "Error: helium-browser is not installed"
   fi
fi
