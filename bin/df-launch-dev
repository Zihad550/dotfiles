#!/usr/bin/env bash

# Lua-config dispatches use Lua expressions; the fallback keeps this ordinary
# launch-or-focus helper portable to Hyprland's legacy config mode.

window_pattern="localhost"
workspace="localhost"
url="$1"
window_address=$(hyprctl clients -j | jq -r --arg p "$window_pattern" '.[]|select((.class|test("\\b" + $p + "\\b";"i")) or (.title|test("\\b" + $p + "\\b";"i")))|.address' | head -n1)

current_ws=$(hyprctl activewindow -j | jq -r '.workspace.name')

toggle_special() {
   hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$1\")" >/dev/null 2>&1 \
      || hyprctl dispatch togglespecialworkspace "$1"
}

focus_address() {
   hyprctl dispatch "hl.dsp.focus({ window = \"address:$1\" })" >/dev/null 2>&1 \
      || hyprctl dispatch focuswindow "address:$1"
}

exec_on_special() {
   local ws="$1" cmd="$2"
   hyprctl dispatch "hl.dsp.exec_cmd([=[[workspace special:$ws] $cmd]=])" >/dev/null 2>&1 \
      || hyprctl dispatch exec "[workspace special:$ws] $cmd"
}

if [[ "$current_ws" == "special:$workspace" ]]; then
   toggle_special "$workspace"
elif [[ -n $window_address ]]; then
   focus_address "$window_address"
else
   toggle_special "$workspace"
   exec_on_special "$workspace" "uwsm-app -- helium-browser --profile-directory=Default --new-window --ozone-platform=wayland --ozone-platform-hint=wayland --app=$url"
fi
