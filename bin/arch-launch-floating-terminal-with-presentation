#!/bin/bash

# Launch a floating terminal with the Omarchy logo presentation, then execute the command passed in, and finally end with the omarchy-show-done presentation.
# Used by actions such as Update System.

cmd="$*"
# exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.arch.terminal --title=Arch -e bash -c "arch-show-logo; $cmd; if [ \$? -ne 130 ]; then arch-show-done; fi"
exec setsid uwsm-app -- ghostty --title=Arch -e bash -c "arch-show-logo; $cmd; if [ \$? -ne 130 ]; then arch-show-done; fi"
