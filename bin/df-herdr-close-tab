#!/usr/bin/env bash

set -euo pipefail

herdr=${HERDR_BIN_PATH:-herdr}
workspace=${HERDR_ACTIVE_WORKSPACE_ID:-${HERDR_WORKSPACE_ID:-}}
tab=${HERDR_ACTIVE_TAB_ID:-${HERDR_TAB_ID:-}}
cwd=${HERDR_ACTIVE_PANE_CWD:-${PWD:-$HOME}}

if [[ -z $workspace || -z $tab ]]; then
    printf 'df-herdr-close-tab: active Herdr workspace and tab are required\n' >&2
    exit 1
fi

tabs=$("$herdr" tab list --workspace "$workspace")
tab_count=$(jq -er '.result.tabs | length' <<<"$tabs")
jq -er --arg tab_id "$tab" '.result.tabs[] | select(.tab_id == $tab_id)' <<<"$tabs" >/dev/null

if (( tab_count == 1 )); then
    "$herdr" tab create \
        --workspace "$workspace" \
        --cwd "$cwd" \
        --label empty \
        --no-focus \
        >/dev/null
fi

"$herdr" tab close "$tab" >/dev/null
