#!/bin/bash

set -e

DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

# Ensure sibling helpers (df-theme-set-browser/-gnome/-vscode/-obsidian,
# df-cmd-present) resolve even when df-theme-set is invoked by absolute path
# from the Launcher, which doesn't put ~/dotfiles/bin on PATH.
case ":$PATH:" in
    *":$DOTFILES_DIR/bin:"*) ;;
    *) export PATH="$DOTFILES_DIR/bin:$PATH" ;;
esac
THEMES_DIR="$HOME/.config/themes"
GENERATE_SCRIPT="$DOTFILES_DIR/bin/df-theme-generate"

usage() {
    echo "Usage: $0 [theme-name]"
    echo ""
    echo "Switch to a theme by name, or list available themes if no name provided."
    echo "Use '$0 default' to switch to the default theme (kanagawa)."
    echo ""
    echo "Examples:"
    echo "  $0              # Show current theme or use default"
    echo "  $0 rose-pine    # Switch to rose-pine theme"
    echo "  $0 default      # Switch to default theme"
    exit 1
}

list_themes() {
    echo "Available themes:"
    for theme_dir in "$THEMES_DIR"/*/; do
        theme_name=$(basename "$theme_dir")
        if [[ -f "$theme_dir/colors.toml" ]]; then
            echo "  - $theme_name"
        fi
    done
}

switch_theme() {
    local theme="$1"
    local theme_dir="$THEMES_DIR/$theme"

    if [[ ! -d "$theme_dir" ]]; then
        echo "Error: Theme '$theme' not found"
        exit 1
    fi

    if [[ ! -f "$theme_dir/colors.toml" ]]; then
        echo "Error: colors.toml not found for theme '$theme'"
        exit 1
    fi

    "$GENERATE_SCRIPT" "$theme"

    echo "Switching to theme: $theme"

    rm -f ~/.config/theme
    ln -snf "$HOME/.config/themes/$theme" ~/.config/theme

    if [[ ! -L ~/.config/theme ]]; then
        echo "Error: Failed to create symlink ~/.config/theme"
        exit 1
    fi

    local linked_theme
    linked_theme=$(basename "$(readlink ~/.config/theme)")
    if [[ "$linked_theme" != "$theme" ]]; then
        echo "Error: Symlink verification failed. Expected '$theme' but got '$linked_theme'"
        exit 1
    fi

    echo "Symlink verified: ~/.config/theme -> $(readlink ~/.config/theme)"

    ln -snf ~/.config/theme/neovim.lua ~/.config/nvim/lua/plugins/theme.lua 2>/dev/null || true

    mkdir -p ~/.config/bottom
    ln -snf ~/.config/theme/bottom.toml ~/.config/bottom/bottom.toml

    mkdir -p ~/.config/eza
    ln -snf ~/.config/theme/eza.yml ~/.config/eza/theme.yml

    mkdir -p ~/.config/lazygit
    ln -snf ~/.config/theme/lazygit.yml ~/.config/lazygit/config.yml

    # Background: pick ~/.config/backgrounds/<theme>.<ext>
    BACKGROUND_PATH=""
    shopt -s nullglob
    for bg in "$HOME"/.config/backgrounds/"$theme".*; do
        if [[ -f "$bg" ]]; then
            BACKGROUND_PATH="$bg"
            break
        fi
    done
    shopt -u nullglob
    if [[ -n "$BACKGROUND_PATH" ]]; then
        rm -f ~/.config/theme/background
        ln -snf "$BACKGROUND_PATH" ~/.config/theme/background

        # Restart swaybg with new background
        pkill -x swaybg || true
        setsid uwsm-app -- swaybg -i "$BACKGROUND_PATH" -m fill >/dev/null 2>&1 &
    else
        echo "warn: no background found at ~/.config/backgrounds/$theme.* — run scripts/utils/migrate-theme-backgrounds" >&2
    fi

    # Obsidian style settings
    # Guarded with `command -v` (a builtin, not df-cmd-present) so these
    # integrations are safely skipped during first-run setup, where
    # ~/dotfiles/bin is not yet on PATH (df-theme-set is run by absolute path).
    if command -v df-theme-set-obsidian &>/dev/null; then
        df-theme-set-obsidian
    fi

    # reload apps
    if pgrep -x ghostty >/dev/null; then
        killall -SIGUSR2 ghostty
    fi

    # Quickshell re-reads ~/.config/theme/quickshell.json in place, so the bar
    # restyles without restarting. Guarded like the obsidian call above, since
    # ~/dotfiles/bin is not on PATH during first-run setup.
    #
    # Both long-running configs need this. The watch inside each Theme.qml sees
    # in-place edits from df-theme-generate, but this function retargets the
    # ~/.config/theme symlink, which a file watcher does not necessarily see --
    # so an instance that is not poked here keeps the old palette across a
    # switch.
    #
    # Output is deliberately not silenced: `qs ipc call` exits 0 even when the
    # target is missing, so its stderr is the only signal that this failed.
    if command -v qs &>/dev/null; then
        for config in dotfiles launcher; do
            qs -c "$config" ipc call theme reload || true
        done
    fi

    hyprctl reload >/dev/null 2>&1 || true

    if command -v df-restart-herdr &>/dev/null; then
        df-restart-herdr
    fi

    echo "Theme '$theme' is now active"

    # Apply GNOME theme settings
    if command -v df-theme-set-gnome &>/dev/null; then
        df-theme-set-gnome
    fi

    # Apply VSCode theme
    if command -v df-theme-set-vscode &>/dev/null; then
        df-theme-set-vscode >/dev/null 2>&1
    fi

    # Apply Chromium-family browser theme (Chromium/Helium/Brave)
    if command -v df-theme-set-browser &>/dev/null; then
        df-theme-set-browser >/dev/null 2>&1
    fi
}

DEFAULT_THEME="kanagawa"

if [[ $# -eq 0 ]]; then
    if [[ -L ~/.config/theme && -e ~/.config/theme ]]; then
        current_theme=$(basename "$(readlink ~/.config/theme)")
        echo "Current theme: $current_theme"
        echo ""
        list_themes
    else
        echo "No theme active. Switching to default: $DEFAULT_THEME"
        echo ""
        switch_theme "$DEFAULT_THEME"
    fi
    exit 0
fi

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    usage
fi

if [[ "$1" == "default" ]]; then
    switch_theme "$DEFAULT_THEME"
    exit 0
fi

switch_theme "$1"
