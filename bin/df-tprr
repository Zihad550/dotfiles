#!/usr/bin/env bash
# Print the review bodies on a Forgejo PR. tea has no command for these:
# `tea pr --comments` reads issue comments, `tea pr rc` reads inline code
# comments, and `tea pr <n>` prints only a review's state line, so a reviewer
# who typed their feedback into the review box is invisible to all three.
# Usage: df-tprr <pr> [owner/repo]
set -uo pipefail

die() {
  printf 'df-tprr: %s\n' "$1" >&2
  exit "${2:-1}"
}

pr=${1:-}
slug=${2:-}
cfg=${TEA_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/tea/config.yml}
[ -n "$pr" ] || die "usage: df-tprr <pr> [owner/repo]" 2

remote=$(git remote get-url origin 2>/dev/null) ||
  remote=$(git remote 2>/dev/null | head -1 | xargs -r git remote get-url 2>/dev/null)
[ -n "$remote" ] || die "not in a git repo with a remote"

# scp-style (git@host:owner/repo) and url-style (proto://host/owner/repo) both
# reduce to host + repo once the scheme and any user@ prefix are stripped.
bare=${remote##*://}
bare=${bare#*@}
host=${bare%%[:/]*}
repo=${bare#*[:/]}
repo=${repo%.git}
repo=${repo%/}
# Take the last two segments so an ssh port (:2222/owner/repo) or a subpath
# install (host/gitea/owner/repo) does not end up glued to the owner.
IFS=/ read -ra parts <<<"$repo"
((${#parts[@]} >= 2)) || die "cannot read owner/repo from $remote"
repo="${parts[-2]}/${parts[-1]}"
[ -n "$slug" ] && repo=$slug

# tea keeps the token only in config.yml; `tea login list` knows its host.
IFS=$'\t' read -r login url < <(
  tea login list -o json 2>/dev/null |
    jq -r --arg h "$host" '
      .[] | select((.url | sub("^[a-z]+://";"") | sub("/.*$";"") | sub(":[0-9]+$";"")) == $h
                   or (.ssh_host | sub(":[0-9]+$";"")) == $h)
      | [.name, .url] | @tsv' | head -1
)
[ -n "${login:-}" ] || die "no tea login for host $host"

token=$(awk -v n="$login" '
  $1=="-" && $2=="name:" && $3==n {f=1; next}
  f && $1=="token:" {print $2; exit}' "$cfg")
[ -n "$token" ] || die "no token for login $login in $cfg"

body=$(curl -s -H "Authorization: token $token" "$url/api/v1/repos/$repo/pulls/$pr/reviews")
if ! jq -e 'type == "array"' >/dev/null 2>&1 <<<"$body"; then
  die "$repo!$pr -- $(jq -r '.message // .' 2>/dev/null <<<"$body")"
fi

jq -r '
  [.[] | select(.body != "" and .dismissed == false)] as $r
  | if ($r | length) == 0 then "(no review bodies)"
    else $r[] | "\(.user.login) [\(.state)] \(.submitted_at[0:10]):\n\(.body)\n"
    end' <<<"$body"
