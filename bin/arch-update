#!/usr/bin/env bash

# setup
# mkdir -p ~/.config/systemd/user && cp systemd/user/arch-update.service ~/.config/systemd/user/ && cp systemd/user/arch-update.timer ~/.config/systemd/user/
# systemctl --user daemon-reload && systemctl --user enable arch-update.timer && systemctl --user start arch-update.timer

# Arch Linux update script with checks, logging, and notifications

LOG_FILE="$HOME/.cache/arch-update.log"
NOTIFY_ICON="system-software-update"

# Function to log messages
log() {
   echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >>"$LOG_FILE"
}

# Function to send notification
notify() {
   if command -v notify-send >/dev/null 2>&1; then
      notify-send -i "$NOTIFY_ICON" "Arch Update" "$1"
   fi
}

# Check internet connectivity
if ! ping -c 1 -W 5 archlinux.org >/dev/null 2>&1; then
   log "No internet connection. Aborting update."
   notify "Update failed: No internet connection."
   exit 1
fi

log "Starting Arch Linux update..."

# Update packages
if sudo pacman -Syu --noconfirm >>"$LOG_FILE" 2>&1; then
   log "Package update completed successfully."
   notify "Arch Linux updated successfully."

   # Clean package cache
   sudo pacman -Sc --noconfirm >>"$LOG_FILE" 2>&1

   # Check if reboot is needed (kernel update)
   if pacman -Q linux | grep -q "linux"; then
      if [ -f /var/run/reboot-required ]; then
         notify "Reboot required after kernel update."
      fi
   fi
else
   log "Package update failed."
   notify "Arch Linux update failed. Check $LOG_FILE for details."
   exit 1
fi

log "Update process completed."
