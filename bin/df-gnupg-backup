#!/usr/bin/env bash
# Back up ~/.gnupg to removable media, or restore it. The archive holds private
# keys and revocation certs unencrypted; keep it on encrypted media.
# See scripts/backup/home-dir-backup.sh for media selection and naming.

backup_label=gnupg
backup_dir=.gnupg
# Runtime state (sockets, locks, stale .#lk files) and the CRL cache.
backup_excludes=('.gnupg/S.*' '*.lock' '.#lk*' '.gnupg/crls.d')

before_restore() {
    gpgconf --kill all 2>/dev/null || true
}

# shellcheck source=SCRIPTDIR/../scripts/backup/home-dir-backup.sh
source "$(dirname "${BASH_SOURCE[0]}")/../scripts/backup/home-dir-backup.sh"
home_dir_backup_main "$@"
