#!/usr/bin/env bash

set -euo pipefail

usage() {
    cat >&2 <<'EOF'
Usage:
  df-default-app get [--json] <role>
  df-default-app set <role> <candidate>
  df-default-app list
EOF
    exit 2
}

die() {
    echo "df-default-app: $*" >&2
    exit 1
}

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
REGISTRY="${DF_DEFAULT_APP_REGISTRY:-$CONFIG_HOME/dotfiles/default-apps.json}"
STATE_DIR="${DF_DEFAULT_APP_STATE_DIR:-$STATE_HOME/dotfiles/default-apps}"

[[ -r "$REGISTRY" ]] || die "registry not found: $REGISTRY"
command -v jq >/dev/null 2>&1 || die "jq is required"

if ! jq -e 'type == "object" and (.roles | type == "array") and (.candidates | type == "array")' \
    "$REGISTRY" >/dev/null 2>&1; then
    die "invalid registry: $REGISTRY"
fi

trim() {
    local value="$1"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    printf '%s' "$value"
}

valid_role() {
    jq -e --arg role "$1" '.roles[] | select(.key == $role)' "$REGISTRY" >/dev/null
}

valid_candidate() {
    local role="$1" key="$2"
    jq -e --arg role "$role" --arg key "$key" \
        '.candidates[] | select(.key == $key and ((.roles // []) | index($role)))' \
        "$REGISTRY" >/dev/null
}

candidate_json() {
    local role="$1" key="$2"
    jq -c --arg role "$role" --arg key "$key" \
        '.candidates[] | select(.key == $key and ((.roles // []) | index($role)))' \
        "$REGISTRY"
}

desktop_dirs() {
    local data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
    local dirs="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
    if [[ -n "${DF_DEFAULT_APP_DESKTOP_DIRS:-}" ]]; then
        tr ':' '\n' <<<"$DF_DEFAULT_APP_DESKTOP_DIRS"
        return
    fi
    printf '%s\n' \
        "$data_home/applications" \
        "$data_home/flatpak/exports/share/applications" \
        "$HOME/.local/share/applications" \
        "$HOME/.local/share/flatpak/exports/share/applications" \
        "/var/lib/flatpak/exports/share/applications"
    while IFS= read -r dir; do
        printf '%s/applications\n' "$dir"
    done < <(tr ':' '\n' <<<"$dirs")
}

desktop_available() {
    local desktop="$1" dir
    local -a dirs
    if [[ "$desktop" == */* ]]; then
        [[ -f "$desktop" ]]
        return
    fi
    mapfile -t dirs < <(desktop_dirs)
    for dir in "${dirs[@]}"; do
        [[ -f "$dir/$desktop" ]] && return 0
    done
    return 1
}

candidate_available_json() {
    local candidate="$1"
    local desktop command_name
    desktop=$(jq -r '.check.desktop // .desktop // empty' <<<"$candidate")
    if [[ -n "$desktop" ]]; then
        desktop_available "$desktop"
        return
    fi

    command_name=$(jq -r '.check.command // .command[0] // empty' <<<"$candidate")
    [[ -n "$command_name" ]] && command -v "$command_name" >/dev/null 2>&1
}

candidate_available() {
    local role="$1" key="$2" candidate
    candidate=$(candidate_json "$role" "$key" 2>/dev/null) || return 1
    candidate_available_json "$candidate"
}

selection_for() {
    local role="$1" file value=""
    file="$STATE_DIR/$role"
    if [[ -r "$file" ]]; then
        IFS= read -r value <"$file" || true
        trim "$value"
    fi
}

xdg_default_for() {
    local role="$1" value=""
    case "$role" in
        browser)
            if command -v xdg-settings >/dev/null 2>&1; then
                value=$(xdg-settings get default-web-browser 2>/dev/null || true)
            fi
            ;;
        directory-handler)
            if command -v xdg-mime >/dev/null 2>&1; then
                value=$(xdg-mime query default inode/directory 2>/dev/null || true)
            fi
            ;;
    esac
    trim "$value"
}

candidate_key_for_desktop() {
    local role="$1" desktop="$2"
    [[ -n "$desktop" ]] || return 1
    jq -r --arg role "$role" --arg desktop "$desktop" \
        '.candidates[] | select(.desktop == $desktop and ((.roles // []) | index($role))) | .key' \
        "$REGISTRY" | head -n 1
}

stale_selection_warning() {
    local role="$1" selection="$2"
    [[ -n "$selection" ]] || return
    echo "df-default-app: stale selection for $role: $selection" >&2
}

# Prints the App Candidate key the Role Launcher should use. This is the only
# place that follows the fallback chain.
resolved_key() {
    local role="$1" selection xdg key handler
    selection=$(selection_for "$role")

    if [[ -n "$selection" ]] && candidate_available "$role" "$selection"; then
        printf '%s\n' "$selection"
        return 0
    fi

    if [[ -n "$selection" ]]; then
        stale_selection_warning "$role" "$selection"
    fi

    case "$role" in
        browser|directory-handler)
            xdg=$(xdg_default_for "$role")
            key=$(candidate_key_for_desktop "$role" "$xdg" || true)
            if [[ -n "$key" ]] && candidate_available "$role" "$key"; then
                printf '%s\n' "$key"
                return 0
            fi
            ;;
        file-manager)
            handler=$(resolved_key directory-handler) || true
            if [[ -n "$handler" ]] && candidate_available file-manager "$handler"; then
                printf '%s\n' "$handler"
                return 0
            fi
            ;;
    esac

    echo "df-default-app: no installed candidate resolves role $role" >&2
    return 1
}

role_name() {
    jq -r --arg role "$1" '.roles[] | select(.key == $role) | .name' "$REGISTRY"
}

candidate_label() {
    local key="$1" candidate
    candidate=$(jq -c --arg key "$key" '.candidates[] | select(.key == $key)' "$REGISTRY" 2>/dev/null || true)
    [[ -n "$candidate" ]] && jq -r '.name' <<<"$candidate"
}

role_json() {
    local role="$1" name description xdg selection resolved stale candidates candidate key resolved_candidate
    name=$(role_name "$role")
    description=$(jq -r --arg role "$role" '.roles[] | select(.key == $role) | .description // ""' "$REGISTRY")
    xdg=$(jq -r --arg role "$role" '.roles[] | select(.key == $role) | .xdg // empty' "$REGISTRY")
    selection=$(selection_for "$role")
    stale=false
    if [[ -n "$selection" ]] && ! candidate_available "$role" "$selection"; then
        stale=true
    fi
    resolved=$(resolved_key "$role" || true)
    resolved_candidate='null'
    if [[ -n "$resolved" ]]; then
        resolved_candidate=$(jq -c --arg key "$resolved" '.candidates[] | select(.key == $key)' "$REGISTRY")
    fi

    candidates='[]'
    while IFS= read -r candidate; do
        [[ -n "$candidate" ]] || continue
        key=$(jq -r '.key' <<<"$candidate")
        if candidate_available_json "$candidate"; then
            candidates=$(jq -c --argjson all "$candidates" --argjson next "$candidate" '$all + [$next]' <<<"null")
        fi
    done < <(jq -c --arg role "$role" '[.candidates[] | select((.roles // []) | index($role))][]' "$REGISTRY")

    jq -cn \
        --arg key "$role" \
        --arg name "$name" \
        --arg description "$description" \
        --arg xdg "$xdg" \
        --arg selection "$selection" \
        --arg resolved "$resolved" \
        --argjson stale "$stale" \
        --argjson candidates "$candidates" \
        --argjson candidate "$resolved_candidate" \
        '{key:$key,name:$name,description:$description,xdg:($xdg // ""),selection:($selection // ""),resolved:($resolved // ""),stale:$stale,candidate:$candidate,candidates:$candidates}'
}

list_json() {
    local roles='[]' role data
    while IFS= read -r role; do
        [[ -n "$role" ]] || continue
        data=$(role_json "$role")
        roles=$(jq -c --argjson all "$roles" --argjson next "$data" '$all + [$next]' <<<"null")
    done < <(jq -r '.roles[].key' "$REGISTRY")
    jq -cn --argjson roles "$roles" '{roles:$roles}'
}

set_selection() {
    local role="$1" key="$2" candidate desktop tmp
    valid_role "$role" || die "unknown role: $role"
    valid_candidate "$role" "$key" || die "candidate $key cannot fill role $role"
    candidate=$(candidate_json "$role" "$key")
    candidate_available_json "$candidate" || die "candidate $key is not installed"

    desktop=$(jq -r '.desktop // empty' <<<"$candidate")
    case "$role" in
        browser)
            [[ -n "$desktop" ]] || die "candidate $key has no desktop entry for browser"
            command -v xdg-settings >/dev/null 2>&1 || die "xdg-settings is required"
            xdg-settings set default-web-browser "$desktop"
            ;;
        directory-handler)
            [[ -n "$desktop" ]] || die "candidate $key has no desktop entry for directory-handler"
            command -v xdg-mime >/dev/null 2>&1 || die "xdg-mime is required"
            xdg-mime default "$desktop" inode/directory
            ;;
    esac

    mkdir -p "$STATE_DIR"
    tmp=$(mktemp "$STATE_DIR/.$role.XXXXXX")
    trap 'rm -f "$tmp"' RETURN
    printf '%s\n' "$key" >"$tmp"
    chmod 600 "$tmp"
    mv -f "$tmp" "$STATE_DIR/$role"
    trap - RETURN
    printf '%s\n' "$key"
}

[[ $# -gt 0 ]] || usage
case "$1" in
    get)
        json=false
        shift
        if [[ "${1:-}" == "--json" ]]; then
            json=true
            shift
        fi
        [[ $# == 1 ]] || usage
        valid_role "$1" || die "unknown role: $1"
        if [[ "$json" == true ]]; then
            role_json "$1"
        else
            resolved_key "$1"
        fi
        ;;
    set)
        [[ $# == 3 ]] || usage
        set_selection "$2" "$3"
        ;;
    list)
        [[ $# == 1 ]] || usage
        list_json
        ;;
    *)
        usage
        ;;
esac
