#!/usr/bin/env bash

set -u

if (($# < 3)); then
   echo "usage: df-launch-special-webapp <initialClass> <url> <workspace> [browser args ...]" >&2
   exit 64
fi

initial_class="$1"
url="$2"
workspace="$3"
shift 3
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

exec "$script_dir/df-launch-special-workspace" "$initial_class" "$workspace" \
   helium-browser \
   "--profile-directory=Profile 2" \
   --new-window \
   --ozone-platform=wayland \
   --ozone-platform-hint=wayland \
   "--app=$url" \
   "$@"
