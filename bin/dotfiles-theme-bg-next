#!/bin/bash

set -e

THEME_DIR="$HOME/.config/theme"
BACKGROUNDS_PATH="$THEME_DIR/backgrounds/"
CURRENT_BACKGROUND_LINK="$THEME_DIR/background"

if [[ ! -d "$BACKGROUNDS_PATH" ]]; then
  echo "No backgrounds directory found: $BACKGROUNDS_PATH"
  exit 1
fi

mapfile -d '' -t BACKGROUNDS < <(find -L "$BACKGROUNDS_PATH" -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) -print0 2>/dev/null | sort -z)
TOTAL=${#BACKGROUNDS[@]}

if (( TOTAL == 0 )); then
  echo "No backgrounds found in $BACKGROUNDS_PATH"
  exit 1
fi

if [[ -L $CURRENT_BACKGROUND_LINK ]]; then
  CURRENT_BACKGROUND=$(readlink "$CURRENT_BACKGROUND_LINK")
else
  CURRENT_BACKGROUND=""
fi

INDEX=-1
for i in "${!BACKGROUNDS[@]}"; do
  if [[ ${BACKGROUNDS[$i]} == $CURRENT_BACKGROUND ]]; then
    INDEX=$i
    break
  fi
done

if (( INDEX == -1 )); then
  NEW_BACKGROUND="${BACKGROUNDS[0]}"
else
  NEXT_INDEX=$(((INDEX + 1) % TOTAL))
  NEW_BACKGROUND="${BACKGROUNDS[$NEXT_INDEX]}"
fi

ln -nsf "$NEW_BACKGROUND" "$CURRENT_BACKGROUND_LINK"

echo "Background changed to: $(basename "$NEW_BACKGROUND")"

if command -v swaybg >/dev/null 2>&1; then
  pkill -x swaybg
  setsid uwsm-app -- swaybg -i "$CURRENT_BACKGROUND_LINK" -m fill >/dev/null 2>&1 &
fi
