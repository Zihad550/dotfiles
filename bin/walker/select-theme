#!/usr/bin/env bash

THEME_DIR="$HOME/.config/themes"
DOTFILES_BIN="$HOME/.dotfiles/bin"
THEME_SCRIPT="$DOTFILES_BIN/theme"

# Determine current theme
current_theme=$(basename "$(readlink ~/.config/theme 2>/dev/null)" 2>/dev/null || echo "")

# Build options (skip dirs without colors.toml)
options=""
for theme in "$THEME_DIR"/*; do
   basename_theme="$(basename "$theme")"
   [[ ! -f "$theme/colors.toml" ]] && continue
   if [ "$basename_theme" = "$current_theme" ]; then
      options+="$basename_theme (current)\n"
   else
      options+="$basename_theme\n"
   fi
done

# Launch walker and get selection
selected=$(echo -e "$options" | walker --dmenu --theme default -p "Select theme…")

# If something selected
if [ -n "$selected" ]; then
   # Remove " (current)" suffix if present
   selected="${selected% (current)}"

   # Use new theme script (generates configs + symlinks)
   "$THEME_SCRIPT" "$selected"

   # Restart applications
   killall -SIGUSR2 ghostty
   systemctl --user restart waybar.service
   systemctl --user restart mako.service
   hyprctl reload >/dev/null 2>&1

   # Obsidian style settings
   rm -f ~/.obsidian-vault/.obsidian/plugins/obsidian-style-settings/data.json
   cp ~/.config/theme/obsidian-border-theme.json ~/.obsidian-vault/.obsidian/plugins/obsidian-style-settings/data.json 2>/dev/null || true

   # Change gnome, browser, vscode themes
   dotfiles-set-gnome-theme >/dev/null 2>&1
   dotfiles-set-vscode-theme >/dev/null 2>&1
fi
