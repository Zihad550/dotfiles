#!/usr/bin/env bash

set -e

THEME_DIR="$HOME/.config/themes"

current_theme=$(basename "$(readlink ~/.config/theme 2>/dev/null)" 2>/dev/null || echo "")

options=""
for theme in "$THEME_DIR"/*; do
   basename_theme="$(basename "$theme")"
   [[ ! -f "$theme/colors.toml" ]] && continue
   if [ "$basename_theme" = "$current_theme" ]; then
      options+="$basename_theme (current)\n"
   else
      options+="$basename_theme\n"
   fi
done

selected=$(echo -e "$options" | walker --dmenu --theme default -p "Select theme…")

if [ -n "$selected" ]; then
   selected="${selected% (current)}"
   df-theme-set "$selected"
fi
