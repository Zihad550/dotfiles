#!/usr/bin/env bash

servers=(
   "https://localhost:5175"
   "http://localhost:3000"
   "http://localhost:8000"
)

options=$(printf "%s\n" "${servers[@]}")

# Show the options in walker and store the selected value
selection=$(echo -e "$options" | walker -d --theme default -p "dev servers" "${args[@]}")

# If a selection was made
if [ -n "$selection" ]; then
   ~/dotfiles/bin/df-launch-dev "$selection" >/dev/null 2>&1
   exit 0
fi
