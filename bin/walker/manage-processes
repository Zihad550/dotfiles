#!/usr/bin/env bash

options=$(ps -eo pid,comm,cmd,%cpu --sort=-%cpu |
   awk '{pid=$1; name=$2; $1=""; $2=""; cpu=$NF; $NF=""; sub(/^ +/, ""); path=$0; print pid " " name " " path " (" cpu "% CPU)"}')

# Show the options in walker and store the selected value
selection=$(echo -e "$options" | walker -d --theme default -p "processes")

# If a selection was made
if [ -n "$selection" ]; then
   PID=$(echo "$selection" | awk '{print $1}')
   echo $PID
   kill -9 "$PID" 2>/dev/null
   exit 0
fi
