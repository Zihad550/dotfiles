#!/usr/bin/env bash

menu() {
   local prompt="$1"
   local options="$2"
   local extra="$3"
   local preselect="$4"

   read -r -a args <<<"$extra"

   if [[ -n "$preselect" ]]; then
      local index
      index=$(echo -e "$options" | grep -nxF "$preselect" | cut -d: -f1)
      if [[ -n "$index" ]]; then
         args+=("-a" "$index")
      fi
   fi

   echo -e "$options" | walker --dmenu --theme dmenu_250 -p "$prompt…" "${args[@]}"
}

show_system_menu() {
   case $(menu "System" "  Lock\n󰤄  Suspend\n  Relaunch\n󰜉  Restart\n󰐥  Shutdown") in
   *Lock*) hyprlock ;;
   *Suspend*) systemctl suspend ;;
   *Relaunch*) uwsm stop ;;
   *Restart*) systemctl reboot ;;
   *Shutdown*) systemctl poweroff ;;
   *) back_to ;;
   esac
}

# Main entry point
show_system_menu
