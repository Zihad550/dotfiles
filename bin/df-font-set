#!/bin/bash

# Switch monospace font across configs (ghostty, quickshell, zed)
# and restart the visual daemons so the change is live.

set -e

restart_shell=1
if [[ ${1:-} == "--no-shell-restart" ]]; then
   restart_shell=0
   shift
fi
font="${1:-}"

usage() {
   echo "Usage: df-font-set [--no-shell-restart] <font-name>"
   echo "       df-font-set                  # show current"
   echo "       df-font-list                 # available families"
   exit 1
}

if [[ -z $font ]]; then
   df-font-current
   exit 0
fi

if [[ $font == "-h" || $font == "--help" ]]; then
   usage
fi

if df-cmd-present fc-list; then
   if ! df-font-list | grep -qxF -- "$font"; then
      echo "Error: font '$font' not found among installed monospace families" >&2
      echo "Run df-font-list to see available." >&2
      exit 1
   fi
fi

REPO="$HOME/dotfiles"
font_json=$(python3 -c 'import json, sys; print(json.dumps(sys.argv[1], ensure_ascii=False))' "$font")
"$REPO/bin/df-settings-control" check appearance.fontFamily "$font_json"
font_replacement=$(printf '%s\n' "$font_json" | sed 's/[\\&|]/\\&/g')

# ghostty
sed -i 's|^font-family[[:space:]]*=.*|font-family = '"$font_replacement"'|' \
   "$REPO/ghostty/.config/ghostty/config"

# Update each module's metrics without replacing the probe's symlink.
for theme in "$REPO"/quickshell/.config/quickshell/{*,dotfiles/*}/Theme.qml; do
   # Skipped rather than followed: lock-probe/Theme.qml is a symlink to the
   # lock's, and `sed -i` would replace it with a regular copy.
   [[ -f $theme && ! -L $theme ]] || continue
   sed -i 's|^\([[:space:]]*\)readonly property string defaultFontFamily:.*|\1readonly property string defaultFontFamily: '"$font_replacement"'|' \
      "$theme"
done

# zed
if [[ -f "$REPO/zed/.config/zed/settings.json" ]]; then
   sed -i 's|"buffer_font_family":[[:space:]]*"[^"]*"|"buffer_font_family": '"$font_replacement"'|' \
      "$REPO/zed/.config/zed/settings.json"
fi

# Notify the running shell without closing the Settings window.
"$REPO/bin/df-settings-control" set appearance.fontFamily "$font_json"

if (( restart_shell )) && command -v df-qs-restart >/dev/null 2>&1; then
   df-qs-restart --if-running
fi
if df-cmd-present ghostty && pgrep -x ghostty >/dev/null; then
   killall -SIGUSR2 ghostty
fi

echo "Font set to: $font"
