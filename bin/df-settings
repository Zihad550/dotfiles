#!/bin/bash

set -euo pipefail

case "${1:-}" in
    "") exec qs -c dotfiles ipc call settings open ;;
    appearance|windows|input|displays|defaults|tailscale|panels)
        # Without --, qs parses `show` as its own `ipc show` subcommand.
        exec qs -c dotfiles ipc call settings -- show "$1" ;;
    *) echo "Usage: df-settings [appearance|windows|input|displays|defaults|tailscale|panels]" >&2; exit 2 ;;
esac
