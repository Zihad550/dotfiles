#!/usr/bin/env bash

# Open a directory in tmux, routing into the devcontainer when the toggle
# says to -- see docs/adr/0002-devcontainer-routing-toggle.md and
# .scratch/devcontainer-routing-toggle/spec.md.
#
# Called by the Launcher's Tmux entry and directly by SUPER+U (ticket 03) --
# neither hands in a routing decision, so this re-derives it itself. Args
# are argv, never shell-words.

set -euo pipefail

name="$1"
path="$2"

STATE_DIR="$HOME/.local/state/dotfiles"
ENABLED_FLAG="$STATE_DIR/toggles/devcontainer-routing"
HOST_FILE="$STATE_DIR/devcontainer-host"

# Fallback host, mirroring directories.js's SSH_HOST -- see spec.
DEFAULT_SSH_HOST="devcontainer.devpod"

# Duplicated from directories.js's MIRRORED, deliberately -- see spec.
MIRRORED=("dev" "dotfiles" ".agents")

routing_enabled() {
    [ -e "$ENABLED_FLAG" ]
}

is_mirrored() {
    local candidate="$1" root
    for root in "${MIRRORED[@]}"; do
        case "$candidate" in
            "$HOME/$root" | "$HOME/$root"/*) return 0 ;;
        esac
    done
    return 1
}

# Blank, missing, or unreadable falls back to DEFAULT_SSH_HOST.
resolved_host() {
    local line=""
    if [ -r "$HOST_FILE" ]; then
        IFS= read -r line <"$HOST_FILE" || true
    fi
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    printf '%s' "${line:-$DEFAULT_SSH_HOST}"
}

routed=false
if routing_enabled && is_mirrored "$path"; then
    routed=true
fi

# Single-quote-doubling, the module's shellEscape rule: wrap in single
# quotes, doubling any quote inside so it survives a shell parse whole.
sq() {
    printf "'%s'" "${1//\'/\'\\\'\'}"
}

if tmux has-session -t "$name" 2>/dev/null; then
    exec tmux attach -t "$name"
fi

if [ "$routed" = true ]; then
    ssh_host="$(resolved_host)"
    # The command window one runs. Quoted for two shells: the pane shell
    # tmux runs the command through (sq applied again) and the remote shell
    # that parses `cd '...'`. `$SHELL` is left to the remote shell to
    # expand -- the container's shell, not this machine's.
    remote="cd $(sq "$path") 2>/dev/null; exec \$SHELL"
    command="ssh -t $(sq "$ssh_host") $(sq "$remote")"

    tmux new-session -d -s "$name" -c "$path" "$command"
    tmux new-window -t "$name" -c "$path"
else
    tmux new-session -d -s "$name" -c "$path"
fi

exec tmux attach -t "$name"
