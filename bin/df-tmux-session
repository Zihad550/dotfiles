#!/usr/bin/env bash

# Open a directory in tmux: window one an ssh shell into the devcontainer at
# the same path (a missing remote directory is tolerated, per scd), window
# two the local directory. Choosing the same directory again attaches to the
# running session without spawning anything new.
#
# Called by the directories Launcher's Tmux entry as
# `ghostty -e <this script> <session name> <path>` (ticket 03). The session
# name and path are argv, never shell-words -- a path with spaces or quotes
# must survive whole.

set -euo pipefail

name="$1"
path="$2"

# devcontainer.devpod, the devcontainer's ssh alias -- the same SSH_HOST the
# directories module names. Kept in sync with
# quickshell/.config/quickshell/launcher/lib/directories.js.
SSH_HOST="devcontainer.devpod"

# Single-quote-doubling, the module's shellEscape rule: wrap in single
# quotes, doubling any quote inside so it survives a shell parse whole.
sq() {
    printf "'%s'" "${1//\'/\'\\\'\'}"
}

# The command window one runs. Quoted for two shells: the pane shell tmux
# runs the command through (sq applied again) and the remote shell that
# parses `cd '...'`. `$SHELL` is left to the remote shell to expand -- the
# container's shell, not this machine's.
remote="cd $(sq "$path") 2>/dev/null; exec \$SHELL"
command="ssh -t $SSH_HOST $(sq "$remote")"

if tmux has-session -t "$name" 2>/dev/null; then
    exec tmux attach -t "$name"
fi

tmux new-session -d -s "$name" -c "$path" "$command"
tmux new-window -t "$name" -c "$path"
exec tmux attach -t "$name"
