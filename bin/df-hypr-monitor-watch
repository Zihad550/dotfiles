#!/usr/bin/env bash

# Recovery backstop for monitor events the lid binding can miss.

set -uo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export PATH="$PATH:$SCRIPT_DIR"

SOCKET="${XDG_RUNTIME_DIR:-/run/user/$UID}/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"
LOCK="${XDG_RUNTIME_DIR:-/tmp}/df-hypr-monitor-clamshell.lock"
LAYOUT_LOCK="${XDG_RUNTIME_DIR:-/tmp}/df-hypr-monitor-layout.lock"

sync_clamshell() {
    (
        flock -n 9 || exit 0
        timeout --kill-after=0.1s 0.4s df-hypr-clamshell >/dev/null 2>&1 || true
    ) 9>"$LOCK"
}

sync_clamshell_after_monitor_change() {
    sync_clamshell

    (
        for delay in 1 3 7; do
            sleep "$delay"
            sync_clamshell
        done
    ) &
}

sync_display_layout() {
    (
        flock -n 9 || exit 0
        timeout --kill-after=0.2s 2s df-hypr-display-layout apply --quiet >/dev/null 2>&1 || true
    ) 9>"$LAYOUT_LOCK"
}

# Runs on ANY monitoradded (internal or external) so re-enabling eDP-1 while an
# external is on also reclaims workspace 1, not just the initial hotplug.
sync_external_workspaces() {
    local internal monitors_json external internal_enabled=false

    internal=$(df-hypr-monitor-laptop 2>/dev/null) || true
    [[ -n $internal && $internal =~ ^[A-Za-z0-9._-]+$ ]] || return 0

    monitors_json=$(hyprctl monitors -j 2>/dev/null) || return 0

    external=$(jq -er --arg internal "$internal" '
        first(.[] | select(.disabled == false and .name != $internal)).name
    ' <<<"$monitors_json") || return 0
    [[ $external =~ ^[A-Za-z0-9._-]+$ ]] || return 0

    jq -e --arg internal "$internal" '
        any(.[]; .name == $internal and .disabled == false)
    ' <<<"$monitors_json" >/dev/null 2>&1 && internal_enabled=true

    # monitors.lua contract: 1 -> internal (when enabled), 2 -> external
    # (shown), 3-10 -> external. One eval chunk applies it atomically.
    local rules="" i
    if [[ $internal_enabled == true ]]; then
        rules+="hl.workspace_rule({ workspace = \"1\", monitor = \"$internal\", default = true })"$'\n'
    fi
    rules+="hl.workspace_rule({ workspace = \"2\", monitor = \"$external\", default = true })"
    for i in 3 4 5 6 7 8 9 10; do
        rules+=$'\n'"hl.workspace_rule({ workspace = \"$i\", monitor = \"$external\" })"
    done
    hyprctl eval "$rules" >/dev/null 2>&1 || return 0

    local moves ws target
    moves=$(hyprctl workspaces -j 2>/dev/null | jq -r --arg external "$external" \
        --arg internal "$internal" --argjson internal_enabled "$internal_enabled" '
        .[] |
        if .id == 1 then
            (if $internal_enabled and .monitor != $internal then "1 \($internal)" else empty end)
        elif .id >= 2 and .id <= 10 then
            (if .monitor != $external then "\(.id) \($external)" else empty end)
        else empty end
    ') || true
    if [[ -n $moves ]]; then
        while read -r ws target; do
            [[ -n $ws && -n $target ]] || continue
            hyprctl dispatch "hl.dsp.workspace.move({ workspace = \"$ws\", monitor = \"$target\" })" \
                >/dev/null 2>&1 || true
        done <<<"$moves"
    fi

    hyprctl dispatch "hl.dsp.focus({ monitor = \"$external\" })" >/dev/null 2>&1 || true
    hyprctl dispatch "hl.dsp.focus({ workspace = \"2\" })" >/dev/null 2>&1 || true
}

poll_clamshell_state() {
    while true; do
        sleep 2
        sync_clamshell
    done
}

poll_pid=""
sync_poll_state() {
    if df-hw-clamshell && df-hypr-monitor-external-active; then
        if [[ -z $poll_pid ]] || ! kill -0 "$poll_pid" 2>/dev/null; then
            poll_clamshell_state &
            poll_pid=$!
        fi
    elif [[ -n $poll_pid ]]; then
        kill "$poll_pid" 2>/dev/null || true
        poll_pid=""
    fi
}

sync_clamshell_after_monitor_change
sync_poll_state

while read -r event; do
    case "$event" in
        monitoradded\>\>*|monitoraddedv2\>\>*)
            sync_display_layout
            sync_external_workspaces
            sync_clamshell_after_monitor_change
            sync_poll_state
            ;;
        monitorremoved\>\>*|monitorremovedv2\>\>*)
            sync_clamshell_after_monitor_change
            sync_poll_state
            ;;
        configreloaded\>\>*)
            sync_clamshell
            ;;
    esac
done < <(socat -U - "UNIX-CONNECT:$SOCKET")
