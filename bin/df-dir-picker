#!/usr/bin/env bash

# Open the walker/elephant menu to pick a directory under $HOME.
# Default Return → open in Zed.
# Shift+Return → open submenu to choose the app.
#
# Caching strategy:
#   - First run: scan $HOME synchronously and write the cache file.
#   - Subsequent runs: launch walker immediately against the existing cache,
#     and refresh the cache in the background for next time.

set -e

CACHE_DIR="$HOME/.cache/df-dir-picker"
CACHE_FILE="$CACHE_DIR/folders.list"
TMP_FILE="$CACHE_DIR/folders.list.tmp"

PRUNE_NAMES=(
  .local node_modules .git .obsidian-vault .var Cache cache .npm .nuget
  .cache Kiro .kiro .cursor Cypress cypress discord go obs-studio mpv transmission
)

# "dotfiles", not ".dotfiles": the repo lives at ~/dotfiles. Missing roots are
# dropped below. Keep in sync with menus/dotfiles_dirs.lua.
ROOTS=("$HOME/dotfiles" "$HOME/dev-0" "$HOME/dev")

build_cache() {
  local prune_args=()
  for name in "${PRUNE_NAMES[@]}"; do
    prune_args+=(-o -name "$name")
  done
  # Drop the leading -o from the first entry
  prune_args=("${prune_args[@]:1}")

  local existing=()
  for r in "${ROOTS[@]}"; do
    [[ -d $r ]] && existing+=("$r")
  done

  mkdir -p "$CACHE_DIR"
  {
    # $HOME one level deep so plain folders (Downloads, Pictures, ...) are
    # reachable; hidden entries skipped to keep the list readable.
    printf '%s\n' "$HOME"
    find "$HOME" -mindepth 1 -maxdepth 1 \
      \( "${prune_args[@]}" -o -name '.*' \) -prune -o -type d -print
    # Then the dev roots, deep.
    if [[ ${#existing[@]} -gt 0 ]]; then
      find "${existing[@]}" -maxdepth 6 -type d \( "${prune_args[@]}" \) -prune \
        -o -type d -print
    fi
  } 2>/dev/null | sort -u >"$TMP_FILE"
  mv "$TMP_FILE" "$CACHE_FILE"
}

if [[ ! -f $CACHE_FILE ]]; then
  build_cache
else
  # Refresh in background; ignore failures, never block the picker.
  ( build_cache >/dev/null 2>&1 ) &
  disown
fi

if ! pgrep -x elephant >/dev/null; then
  setsid uwsm-app -- elephant &
fi

if ! pgrep -f "walker --gapplication-service" >/dev/null; then
  setsid uwsm-app -- walker --gapplication-service &
fi

exec walker -m menus:dotfilesDirs --width 800 --maxheight 500 --minheight 500 "$@"
