#!/usr/bin/env bash

# Reconcile the laptop output and its workspaces when a lid switch changes.
# A closed lid with an external output is clamshell mode: keep the session on
# the external output and disable the internal panel. A closed lid without an
# external output follows logind's normal lock-then-suspend path.

set -uo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
LID_STATE_DIR="${DF_HYPR_LID_STATE_DIR:-/proc/acpi/button/lid}"
DISPLAY_LAYOUT="${DF_HYPR_DISPLAY_LAYOUT:-$SCRIPT_DIR/df-hypr-display-layout}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/hypr"
STATE_FILE="$STATE_DIR/clamshell-workspaces"

lid_is_closed() {
    local state

    for state in "$LID_STATE_DIR"/*/state; do
        [[ -r $state ]] || continue
        [[ $(<"$state") == *closed* ]] && return 0
    done

    return 1
}

monitor_snapshot() {
    # Only active outputs count here. `monitors all` can retain disabled
    # connectors and make a disconnected output look like a dock.
    hyprctl monitors -j 2>/dev/null
}

internal_monitor() {
    jq -r '[.[] | select((.name // "") | test("^(eDP|LVDS|DSI)-")) | .name] | first // empty'
}

external_monitor() {
    local internal="$1"

    jq -r --arg internal "$internal" '
        [.[]
         | select((.name // "") != $internal)
         | select((.disabled // false) != true)
         | select((.mirrorOf // "") == "")]
        | sort_by(if .focused == true then 0 else 1 end)
        | .[0].name // empty
    '
}

external_monitor_with_retry() {
    local internal="$1"
    local monitors external delay

    # The switch event can beat Hyprland's monitor-added event by a few
    # hundred milliseconds. Give the compositor a short, bounded window to
    # publish the external output before falling back to the normal lid path.
    for delay in 0 0.1 0.3 0.7 1.2; do
        if [[ $delay != 0 ]]; then
            sleep "$delay"
        fi

        monitors=$(monitor_snapshot)
        external=$(external_monitor "$internal" <<<"$monitors")
        if [[ -n $external ]]; then
            printf '%s\n' "$external"
            return 0
        fi
    done

    return 1
}

valid_monitor_name() {
    [[ $1 =~ ^[A-Za-z0-9._-]+$ ]]
}

move_internal_workspaces() {
    local internal="$1"
    local external="$2"
    local workspace
    local -a moved=()

    # A state file makes repeated lid-switch events harmless and lets the open
    # path restore exactly the workspaces this close path moved.
    [[ -f $STATE_FILE ]] && return 0

    while IFS= read -r workspace; do
        [[ -n $workspace ]] || continue
        if hyprctl dispatch moveworkspacetomonitor "$workspace" "$external" \
            >/dev/null 2>&1; then
            moved+=("$workspace")
        fi
    done < <(
        hyprctl workspaces -j 2>/dev/null |
            jq -r --arg internal "$internal" '
                .[]
                | select(.monitor == $internal)
                | select((.id // 0) > 0)
                | .id
            '
    )

    ((${#moved[@]})) || return 0

    mkdir -p "$STATE_DIR" || return 0
    local temporary
    temporary=$(mktemp "$STATE_FILE.XXXXXX") || return 0
    printf '%s\n' "${moved[@]}" >"$temporary" || {
        rm -f "$temporary"
        return 0
    }
    mv -f "$temporary" "$STATE_FILE"
}

restore_workspaces() {
    local internal="$1"
    local workspace
    local failed=0

    [[ -f $STATE_FILE ]] || return 0

    while IFS= read -r workspace; do
        [[ $workspace =~ ^[0-9]+$ ]] || continue
        if ! hyprctl dispatch moveworkspacetomonitor "$workspace" "$internal" \
            >/dev/null 2>&1; then
            failed=1
        fi
    done <"$STATE_FILE"

    ((failed)) || rm -f "$STATE_FILE"
}

restore_layout() {
    if [[ -x "$DISPLAY_LAYOUT" ]]; then
        "$DISPLAY_LAYOUT" apply --quiet >/dev/null 2>&1 && return 0
    fi

    hyprctl reload >/dev/null 2>&1 || true
}

reconcile_closed() {
    local monitors="$1"
    local internal external

    internal=$(internal_monitor <<<"$monitors")
    [[ -n $internal ]] || return 0
    valid_monitor_name "$internal" || return 0

    external=$(external_monitor_with_retry "$internal") || external=""
    if [[ -z $external ]]; then
        # Start the lock before logind's sleep path. The Session Lock's own
        # inhibitor still decides when suspend may continue.
        qs -c lock ipc call lock lock >/dev/null 2>&1 || true
        return 0
    fi
    valid_monitor_name "$external" || return 0

    move_internal_workspaces "$internal" "$external"
    hyprctl eval "hl.monitor({ output = \"$internal\", disabled = true })" \
        >/dev/null 2>&1 || true
}

reconcile_open() {
    local monitors="$1"
    local internal

    restore_layout
    monitors=$(monitor_snapshot) || return 0
    internal=$(internal_monitor <<<"$monitors")
    [[ -n $internal ]] || return 0
    valid_monitor_name "$internal" || return 0
    restore_workspaces "$internal"
}

monitors=$(monitor_snapshot) || exit 0
if lid_is_closed; then
    reconcile_closed "$monitors"
else
    reconcile_open "$monitors"
fi
