#!/usr/bin/env bash

# Apply Omarchy's clamshell model: disable the internal output through a
# temporary Hyprland monitor rule and let Hyprland evacuate its workspaces.

set -uo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export PATH="$PATH:$SCRIPT_DIR"

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/hypr"
CLAMSHELL_FLAG="$STATE_DIR/internal-monitor-clamshell.lua"
DISPLAY_LAYOUT="${DF_HYPR_DISPLAY_LAYOUT:-$SCRIPT_DIR/df-hypr-display-layout}"

valid_monitor_name() {
    [[ $1 =~ ^[A-Za-z0-9._-]+$ ]]
}

enable_internal() {
    local changed=0

    if [[ -f $CLAMSHELL_FLAG ]]; then
        rm -f "$CLAMSHELL_FLAG"
        changed=1
    fi

    ((changed)) || return 0

    if [[ -x $DISPLAY_LAYOUT ]]; then
        "$DISPLAY_LAYOUT" apply --quiet >/dev/null 2>&1 && return 0
    fi

    hyprctl reload >/dev/null 2>&1 || true
}

disable_internal() {
    local internal="$1"
    local layout config desired

    [[ -n $internal ]] || return 0
    valid_monitor_name "$internal" || return 1

    mkdir -p "$STATE_DIR" || return 1
    config="hl.monitor({ output = \"$internal\", disabled = true })"
    layout=""
    if [[ -x "$DISPLAY_LAYOUT" ]]; then
        layout=$("$DISPLAY_LAYOUT" show --raw 2>/dev/null) || layout=""
    fi

    if [[ -n $layout ]]; then
        desired=$(printf '%s\n%s' "$layout" "$config")
    else
        desired=$config
    fi

    if [[ ! -f $CLAMSHELL_FLAG ]] || [[ $(<"$CLAMSHELL_FLAG") != "$desired" ]]; then
        printf '%s\n' "$desired" >"$CLAMSHELL_FLAG" || return 1
        hyprctl reload >/dev/null 2>&1 || true
    fi
}

internal=$(df-hypr-monitor-laptop)
if [[ -z $internal ]]; then
    exit 0
fi

if df-hw-clamshell && df-hypr-monitor-external-active; then
    disable_internal "$internal"
else
    enable_internal
fi
