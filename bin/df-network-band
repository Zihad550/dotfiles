#!/bin/bash

# Show or pin the Wi-Fi band for one active connection.
# The optional interface selects a connected adapter; without it the helper
# prefers the default-route adapter and then NetworkManager's highest priority.

set -euo pipefail

usage() {
  echo "Usage: df-network-band [--interface <interface>] [auto|2.4|5|6]" >&2
  exit 2
}

nm_get() {
  LC_ALL=C nmcli -e no -g "$@" 2>/dev/null
}

band_for_freq() {
  local mhz=${1%%[!0-9]*}
  [[ -n $mhz ]] || return 1

  if ((mhz >= 2400 && mhz < 2500)); then
    echo "2.4"
  elif ((mhz >= 4900 && mhz < 5925)); then
    echo "5"
  elif ((mhz >= 5925 && mhz < 7125)); then
    echo "6"
  else
    return 1
  fi
}

band_from_nm() {
  case "$1" in
    bg) echo "2.4" ;;
    a) echo "5" ;;
    6GHz|6ghz) echo "6" ;;
    *) echo "auto" ;;
  esac
}

nm_band_for() {
  case "$1" in
    2.4) echo "bg" ;;
    5) echo "a" ;;
    6) echo "6GHz" ;;
    *) return 1 ;;
  esac
}

route_device() {
  command -v ip >/dev/null 2>&1 || return 0
  ip route get 1.1.1.1 2>/dev/null |
    awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }'
}

active_wifi_rows() {
  nm_get DEVICE,TYPE,STATE device status || true
}

is_active_wifi() {
  local wanted=$1 iface type state

  while IFS=: read -r iface type state _; do
    [[ $iface == "$wanted" && $type == "wifi" && $state == connected* ]] && return 0
  done < <(active_wifi_rows)
  return 1
}

wifi_profile() {
  nm_get GENERAL.CONNECTION device show "$1"
}

profile_priority() {
  local profile=$1 priority
  priority=$(nm_get connection.autoconnect-priority connection show "$profile" || true)
  [[ $priority =~ ^-?[0-9]+$ ]] && echo "$priority" || echo 0
}

wifi_devices() {
  local iface type state

  while IFS=: read -r iface type state _; do
    if [[ $type == "wifi" && $state == connected* ]]; then
      printf '%s\n' "$iface"
    fi
  done < <(active_wifi_rows)
}

wifi_device() {
  local requested=${1:-} route candidate best="" best_priority=-2147483648
  local iface priority profile

  if [[ -n $requested ]]; then
    is_active_wifi "$requested" || return 1
    printf '%s\n' "$requested"
    return 0
  fi

  route=$(route_device)
  if [[ -n $route ]] && is_active_wifi "$route"; then
    printf '%s\n' "$route"
    return 0
  fi

  while IFS= read -r candidate; do
    [[ -n $candidate ]] || continue
    profile=$(wifi_profile "$candidate" || true)
    priority=$(profile_priority "$profile")
    if [[ -z $best || $priority -gt $best_priority ]]; then
      best=$candidate
      best_priority=$priority
    fi
  done < <(wifi_devices)

  [[ -n $best ]] && printf '%s\n' "$best"
}

read_link() {
  local link
  link=$(iw dev "$1" link 2>/dev/null || true)
  ssid=$(awk '/SSID:/ { sub(/.*SSID: /, ""); print; exit }' <<<"$link")
  freq=$(awk '/freq:/ { print $2; exit }' <<<"$link")
}

available_bands() {
  local device=$1 ssid=$2 current=$3

  {
    if [[ -n $current ]]; then
      printf '%s\n' "$current"
    fi

    # Keep the SSID in an environment variable. Passing it with awk -v would
    # reinterpret backslash escapes, while rebuilding fields preserves colons.
    nm_get FREQ,SSID dev wifi list ifname "$device" --rescan no |
      want="$ssid" awk -F: '
        BEGIN { want = ENVIRON["want"] }
        {
          name = $2
          for (i = 3; i <= NF; i++) name = name ":" $i
          if (name == want) print $1
        }' |
      while IFS= read -r network_frequency; do
        band_for_freq "$network_frequency" || true
      done
  } | sort -u -g | tr '\n' ' ' | sed 's/ $//'
}

print_status() {
  local requested=$1 device profile band available devices

  device=$(wifi_device "$requested" || true)
  [[ -n $device ]] || return 0

  read_link "$device"
  [[ -n $ssid ]] || return 0

  band=$(band_for_freq "$freq" || true)
  available=$(available_bands "$device" "$ssid" "$band")
  profile=$(wifi_profile "$device" || true)
  devices=$(wifi_devices | paste -sd' ' -)

  printf 'device\t%s\n' "$device"
  printf 'devices\t%s\n' "$devices"
  printf 'band\t%s\n' "$band"
  printf 'available\t%s\n' "$available"
  if [[ -n $profile ]]; then
    printf 'selected\t%s\n' "$(band_from_nm "$(nm_get 802-11-wireless.band connection show "$profile" || true)")"
  else
    printf 'selected\tauto\n'
  fi
}

set_band() {
  local target=$1 requested=$2 device profile previous desired

  device=$(wifi_device "$requested" || true)
  if [[ -z $device ]]; then
    echo "Error: no connected Wi-Fi device." >&2
    exit 1
  fi

  profile=$(wifi_profile "$device" || true)
  if [[ -z $profile ]]; then
    echo "Error: no active Wi-Fi connection profile." >&2
    exit 1
  fi

  if [[ $target == "auto" ]]; then
    desired=""
  else
    read_link "$device"
    if [[ " $(available_bands "$device" "$ssid" "$(band_for_freq "$freq" || true)") " != *" $target "* ]]; then
      echo "Error: ${target}GHz is not available on this network." >&2
      exit 1
    fi
    desired=$(nm_band_for "$target")
  fi

  previous=$(nm_get 802-11-wireless.band connection show "$profile" || true)
  [[ $previous == "$desired" ]] && exit 0

  nmcli connection modify "$profile" 802-11-wireless.band "$desired" >/dev/null

  # Reassociation can fail after the profile was modified. Restore both the
  # profile property and its connection before returning the error.
  if ! nmcli connection up "$profile" >/dev/null 2>&1; then
    nmcli connection modify "$profile" 802-11-wireless.band "$previous" >/dev/null 2>&1 || true
    nmcli connection up "$profile" >/dev/null 2>&1 || true
    echo "Error: could not connect on ${target}; reverted to previous band." >&2
    exit 1
  fi
}

requested_interface=""
if [[ ${1:-} == "--interface" ]]; then
  [[ $# -ge 2 && -n ${2:-} ]] || usage
  requested_interface=$2
  shift 2
fi

if (($# > 1)); then
  usage
fi

if (($# == 0)); then
  print_status "$requested_interface"
  exit 0
fi

case "$1" in
  auto|2.4|5|6)
    set_band "$1" "$requested_interface"
    ;;
  *)
    usage
    ;;
esac
