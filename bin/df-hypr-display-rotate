#!/bin/bash

# Switch HDMI-A-1 between vertical (transform 1) and horizontal (transform 0).
# eDP-1 sits physically below HDMI-A-1, so it stacks under it either way; only
# the y offset changes with HDMI's height (1920 rotated, 1080 flat). Vertical
# also restores the reserved area from monitors.lua (340 top, 40 bottom).
# Usage: df-hypr-display-rotate [toggle|horizontal|vertical]

MONITOR="HDMI-A-1"
mode="${1:-toggle}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Tell df-hypr-display-layout which variant the user actually chose, so a later
# `apply` (on boot or hotplug) restores this orientation instead of snapping back
# to the default one. Saved layouts named "vertical"/"horizontal" mirror the two
# branches below; if they don't exist this is a harmless no-op.
remember_variant() {
    [ -x "$SCRIPT_DIR/df-hypr-display-layout" ] || return 0
    "$SCRIPT_DIR/df-hypr-display-layout" remember "$1" >/dev/null 2>&1 || true
}

current=$(hyprctl monitors -j | jq -r ".[] | select(.name == \"$MONITOR\") | .transform")
if [ -z "$current" ]; then
    notify-send "Display" "$MONITOR is not connected"
    exit 1
fi

case "$mode" in
horizontal) target=0 ;;
vertical) target=1 ;;
toggle) [ "$current" = "0" ] && target=1 || target=0 ;;
*)
    echo "usage: $(basename "$0") [toggle|horizontal|vertical]" >&2
    exit 1
    ;;
esac

# Workaround for the rotate regression in Hyprland 0.56.0 (fixed upstream in
# 566ff8fa, 2026-07-24 — not in the v0.56.0 tag).
#
# CMonitorRule::compare() treats transform and reserved_area as "soft" props, so
# a transform-only change takes applyMonitorRuleSoft() instead of a full
# applyMonitorRule(). Commit 0aa7a843 split that soft path out and dropped
# `m_size = (xfmd / m_scale).round()` from it, so the monitor's logical box keeps
# whatever size it had at boot. Rotating then lays windows and layer surfaces out
# for the *old* orientation — half the screen unusable.
#
# Making the two orientations differ in requested refresh rate makes compare()
# return NO_MATCH instead of SOFT_MISMATCH, so the rule goes through the full
# applyMonitorRule(), which does recompute m_size — and ensureMonitorStatus()
# then re-arranges layers and re-tiles windows for the new geometry.
#
# 75 and 75.2 select the same physical mode: mode matching sorts by closeness and
# only falls back to a custom modeline when the best mode is off by 1Hz or more
# (DELTALESSTHAN(..., 1)), so 0.2Hz stays well inside tolerance. The rate differs
# only in the rule, never on the wire.
#
# Once the installed Hyprland includes 566ff8fa, both branches can go back to
# plain '1920x1080@75'.
VERTICAL_MODE="1920x1080@75"
HORIZONTAL_MODE="1920x1080@75.2"

# Apply in an order that never overlaps. Since eDP-1 stacks below, whichever
# monitor ends up higher on the y axis has to move first: going vertical, eDP-1
# drops to 1920 while HDMI is still only 1080 tall; going horizontal, HDMI
# shrinks back to 1080 tall before eDP-1 comes up to meet it.
if [ "$target" = "1" ]; then
    hyprctl eval "hl.monitor({ output = 'eDP-1', mode = 'preferred', position = '0x1920', scale = '1' })"
    hyprctl eval "hl.monitor({ output = '$MONITOR', mode = '$VERTICAL_MODE', position = '0x0', scale = '1', transform = 1, reserved_area = { top = 340, bottom = 40, left = 0, right = 0 } })"
    remember_variant vertical
    notify-send "Display" "$MONITOR set to vertical"
else
    hyprctl eval "hl.monitor({ output = '$MONITOR', mode = '$HORIZONTAL_MODE', position = '0x0', scale = '1', transform = 0, reserved_area = { top = 0, bottom = 0, left = 0, right = 0 } })"
    hyprctl eval "hl.monitor({ output = 'eDP-1', mode = 'preferred', position = '0x1080', scale = '1' })"
    remember_variant horizontal
    notify-send "Display" "$MONITOR set to horizontal"
fi
