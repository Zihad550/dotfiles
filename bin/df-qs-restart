#!/bin/bash

# Restart the Shared Shell. Legacy launcher/lock names are aliases.
#   --if-running  restart only when the Shared Shell is already running
set -e

BIN_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
SHOW_LOG=0
IF_RUNNING=0
for arg in "$@"; do
    case "$arg" in
        -l|--log) SHOW_LOG=1 ;;
        --if-running) IF_RUNNING=1 ;;
        -h|--help)
            echo "Usage: df-qs-restart [dotfiles|launcher|lock] [--log] [--if-running]"
            echo "  Restart the shared bar, launcher, and lock process."
            exit 0
            ;;
        -*) echo "Unknown arg: $arg" >&2; exit 1 ;;
        dotfiles | launcher | lock) ;;
        *) echo "Error: use df-qs-test for scratch configs" >&2; exit 1 ;;
    esac
done

if ! command -v quickshell >/dev/null 2>&1; then
    echo "Error: quickshell not found" >&2
    exit 1
fi
if (( IF_RUNNING )) && [[ -z $("$BIN_DIR/df-qs-instances" dotfiles) ]]; then
    exit 0
fi
if [[ ! -f "$HOME/.config/quickshell/dotfiles/shell.qml" ]]; then
    echo "Error: Shared Shell is not stowed" >&2
    exit 1
fi

# Callable from outside the session, such as over SSH.
if [[ -z ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
    hypr_dir=$(find "${XDG_RUNTIME_DIR:-/run/user/$UID}/hypr" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' 2>/dev/null |
        sort -n | tail -n 1 | cut -d' ' -f2-)
    [[ -n $hypr_dir ]] && export HYPRLAND_INSTANCE_SIGNATURE=${hypr_dir##*/}
fi

wait_until_stopped() {
    local name="$1"
    for _ in {1..30}; do
        [[ -z $("$BIN_DIR/df-qs-instances" "$name") ]] && return 0
        sleep 0.1
    done
    return 1
}

# `kill -i` only finds instances on the caller's display, and takes no
# --any-display, so it borrows the instance's own.
instance_display() {
    tr '\0' '\n' <"/proc/$1/environ" 2>/dev/null | sed -n 's/^WAYLAND_DISPLAY=//p'
}

stop_config() {
    local name="$1" id pid display
    [[ $name == "dotfiles" ]] && pkill -USR1 -x df-qs-launch || true
    while read -r id pid; do
        [[ -n $id ]] || continue
        display=$(instance_display "$pid")
        WAYLAND_DISPLAY=${display:-${WAYLAND_DISPLAY:-}} timeout 30 quickshell kill -i "$id" >/dev/null 2>&1 || true
    done < <("$BIN_DIR/df-qs-instances" "$name")
    wait_until_stopped "$name" && return 0

    # A supervisor would relaunch a shell that exits on a signal.
    echo "'$name' did not exit on request; sending SIGTERM"
    [[ $name == "dotfiles" ]] && pkill -TERM -x df-qs-launch || true
    while read -r id pid; do
        [[ -n $pid ]] && kill -TERM "$pid" 2>/dev/null || true
    done < <("$BIN_DIR/df-qs-instances" "$name")
    wait_until_stopped "$name" && return 0

    echo "Error: '$name' would not exit; refusing a duplicate Shared Shell" >&2
    return 1
}

# Checked before anything stops: the new shell is launched through Hyprland.
if ! hyprctl -j monitors >/dev/null 2>&1; then
    echo "Error: Hyprland is unreachable; leaving the running shell alone" >&2
    exit 1
fi

# Clear pre-consolidation instances too; stop the old lock last.
for old_config in launcher dotfiles lock; do
    stop_config "$old_config"
done

echo "Starting the Shared Shell"
# Through Hyprland, so the shell gets the session's environment, not this
# caller's. hyprctl reports a rejected dispatch on stdout, not its exit status.
reply=$(hyprctl dispatch "hl.dsp.exec_cmd(\"uwsm-app -- $BIN_DIR/df-qs-launch\")" 2>&1 || true)
if [[ $reply != "ok" ]]; then
    echo "Error: Hyprland did not accept the launch: $reply" >&2
    echo "Start it with: uwsm-app -- $BIN_DIR/df-qs-launch" >&2
    exit 1
fi

# Ready once the config has loaded far enough to register the lock's IPC target.
ready=0
for _ in {1..300}; do
    if quickshell ipc -c dotfiles --any-display show 2>/dev/null | grep -qx "target lock"; then
        ready=1
        break
    fi
    sleep 0.1
done
if (( ! ready )); then
    echo "Error: the Shared Shell did not become ready" >&2
    exit 1
fi

count=$("$BIN_DIR/df-qs-instances" dotfiles | wc -l)
if (( count != 1 )); then
    echo "Error: expected one Shared Shell, found $count" >&2
    exit 1
fi
if (( SHOW_LOG )); then
    sleep 1
    quickshell -c dotfiles log
fi
