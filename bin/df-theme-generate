#!/bin/bash

set -e

DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
TEMPLATE_DIR="$DOTFILES_DIR/themes/templates"

usage() {
   echo "Usage: $0 <theme-name>"
   echo "Generate theme config files from templates"
   exit 1
}

if [[ $# -ne 1 ]]; then
   usage
fi

THEME_NAME="$1"
if ! OUTPUT_DIR=$("$DOTFILES_DIR/bin/df-theme-dir" "$THEME_NAME"); then
   echo "Error: colors.toml not found for theme '$THEME_NAME'"
   exit 1
fi
COLORS_FILE="$OUTPUT_DIR/colors.toml"

echo "Generating theme: $THEME_NAME"

declare -A COLORS
while IFS='= ' read -r key value; do
   if [[ -n "$key" && ! "$key" =~ ^\[ && "$key" =~ ^[a-z_0-9]+$ ]]; then
      value="${value//\"/}"
      COLORS["$key"]="$value"
   fi
done <"$COLORS_FILE"

set_default() {
   [[ -n ${COLORS[$1]:-} ]] || COLORS[$1]="$2"
}

# Omarchy themes name colours semantically (red, bright_blue, muted, ...); the
# templates use the ANSI names. Same mapping as Omarchy's omarchy-theme-color.
add_ansi_aliases() {
   local -A semantic=(
      [color0]=background [color1]=red [color2]=green [color3]=yellow
      [color4]=blue [color5]=magenta [color6]=cyan [color7]=foreground
      [color8]=muted [color9]=bright_red [color10]=bright_green
      [color11]=bright_yellow [color12]=bright_blue [color13]=bright_magenta
      [color14]=bright_cyan [color15]=bright_foreground
   )
   local key i

   set_default magenta "${COLORS[purple]:-}"
   set_default bright_magenta "${COLORS[bright_purple]:-}"
   for key in "${!semantic[@]}"; do
      set_default "$key" "${COLORS[${semantic[$key]}]:-}"
   done
   for i in 1 2 3 4 5 6; do
      set_default "color$((i + 8))" "${COLORS[color$i]}"
   done
   set_default background "${COLORS[color0]}"
   set_default foreground "${COLORS[color7]}"
   set_default color8 "${COLORS[dark_foreground]:-${COLORS[color0]}}"
   set_default color15 "${COLORS[foreground]}"
   set_default accent "${COLORS[color4]}"
   set_default cursor "${COLORS[bright_foreground]:-${COLORS[foreground]}}"
   set_default selection_background "${COLORS[selection]:-${COLORS[color8]}}"
   set_default selection_foreground "${COLORS[foreground]}"
}

add_ansi_aliases

add_derived_colors() {
   local bg="${COLORS[background]}"
   local fg="${COLORS[foreground]}"
   local accent="${COLORS[accent]}"

   COLORS[background_rgb]="${bg#\#}"
   COLORS[foreground_rgb]="${fg#\#}"
   COLORS[accent_rgb]="${accent#\#}"

   local accent_hex="${accent#\#}"
   local r=$((16#${accent_hex:0:2}))
   local g=$((16#${accent_hex:2:2}))
   local b=$((16#${accent_hex:4:2}))
   COLORS[accent_strip]="${accent_hex}"

   local background_hex="${bg#\#}"
   COLORS[background_rgb_csv]="$((16#${background_hex:0:2})),$((16#${background_hex:2:2})),$((16#${background_hex:4:2}))"
}

add_derived_colors

process_template() {
   local template_file="$1"
   local output_file="$2"
   local template_name=$(basename "$template_file" .tpl)

   echo "  Processing: $template_name"

   content=$(cat "$template_file")

   for key in "${!COLORS[@]}"; do
      content="${content//\{\{ $key \}\}/${COLORS[$key]}}"
   done

   echo "$content" >"$OUTPUT_DIR/$output_file"
}

echo "Templates:"
for template in "$TEMPLATE_DIR"/*.tpl; do
   if [[ -f "$template" ]]; then
      template_name=$(basename "$template" .tpl)
      process_template "$template" "$template_name"
   fi
done

case "${COLORS[mode]:-}" in
   light) touch "$OUTPUT_DIR/light.mode" ;;
   dark) rm -f "$OUTPUT_DIR/light.mode" ;;
esac

echo "Done! Theme generated at: $OUTPUT_DIR"
