#!/usr/bin/env bash

# Toggle wifi power_save on all wireless interfaces.
# Invoked from /etc/udev/rules.d/99-wifi-powersave.rules on AC state change.
# Usage: df-wifi-powersave on|off

mode="${1:-off}"
[[ "$mode" == "on" || "$mode" == "off" ]] || { echo "usage: $0 on|off" >&2; exit 1; }

command -v iw >/dev/null || exit 0

while read -r iface; do
    [[ -n "$iface" ]] && iw dev "$iface" set power_save "$mode" 2>/dev/null || true
done < <(iw dev 2>/dev/null | awk '/Interface/ {print $2}')
