#!/usr/bin/env bash

# In Hyprland's lua-config mode, `hyprctl dispatch <X>` evaluates <X> as a Lua
# expression (HyprCtl.cpp:1102-1116). The legacy dispatcher names below only
# work in conf mode, so try the lua syntax first and fall back to legacy —
# this keeps the script portable across both modes. Pattern borrowed from
# resources/omarchy/bin/omarchy-launch-or-focus.

WINDOW_PATTERN="$1"
app="$2"
workspace="$3"

# An exact class match wins outright -- a caller that launches its window
# with --class=$WINDOW_PATTERN gets a collision-proof identity that survives
# title changes (e.g. a tmux client's title tracking whatever it's attached
# to). Only when nothing has that exact class do we fall back to the old
# fuzzy word-boundary match against class or title, for callers that never
# pinned a class (e.g. Electron apps whose WM_CLASS is already stable).
WINDOW_ADDRESS=$(hyprctl clients -j | jq -r --arg p "$WINDOW_PATTERN" '
   [.[] | select(.class == $p)] as $exact
   | if ($exact | length) > 0
     then $exact[0].address
     else ([.[] | select((.class|test("\\b" + $p + "\\b";"i")) or (.title|test("\\b" + $p + "\\b";"i")))] | .[0].address // empty)
     end
')

CURRENT_WS=$(hyprctl activewindow -j | jq -r '.workspace.name')

toggle_special() {
   hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$1\")" >/dev/null 2>&1 \
      || hyprctl dispatch togglespecialworkspace "$1"
}

focus_address() {
   hyprctl dispatch "hl.dsp.focus({ window = \"address:$1\" })" >/dev/null 2>&1 \
      || hyprctl dispatch focuswindow "address:$1"
}

exec_on_special() {
   local ws="$1" cmd="$2"
   hyprctl dispatch "hl.dsp.exec_cmd([=[[workspace special:$ws] $cmd]=])" >/dev/null 2>&1 \
      || hyprctl dispatch exec "[workspace special:$ws] $cmd"
}

if [[ "$CURRENT_WS" == "special:$workspace" ]]; then
   toggle_special "$workspace"
elif [[ -n $WINDOW_ADDRESS ]]; then
   focus_address "$WINDOW_ADDRESS"
else
   toggle_special "$workspace"
   exec_on_special "$workspace" "uwsm-app -- $app"
fi
