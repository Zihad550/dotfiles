#!/bin/bash

# Remove a third-party theme, or drop a pack theme from the sparse checkout
# (it stays available to fetch again). Refuses built-in themes and the active
# theme.

set -e

DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
BG_DIR="$HOME/.config/backgrounds"
PREVIEW_DIR="$HOME/.config/theme-previews"
THEME_LINK="$HOME/.config/theme"

usage() {
   echo "Usage: df-theme-remove [theme-name] [--force]"
   echo "  Prompts for confirmation unless --force is passed."
   echo "  With no theme-name, lists removable themes."
   exit 1
}

FORCE=0
NAME=""
for arg in "$@"; do
   case "$arg" in
      --force) FORCE=1 ;;
      -h|--help) usage ;;
      *)
         if [[ -n $NAME ]]; then
            echo "Error: too many arguments" >&2
            usage
         fi
         NAME="$arg"
         ;;
   esac
done

list_removable() {
   "$DOTFILES_DIR/bin/df-theme-list" --installed | while IFS=$'\t' read -r _ name _ kind; do
      if [[ $kind != builtin ]]; then
         echo "$name"
      fi
   done
}

if [[ -z $NAME ]]; then
   echo "Removable themes:"
   themes="$(list_removable)"
   if [[ -z $themes ]]; then
      echo "  (none — only built-in themes present)"
      exit 0
   fi
   echo "$themes" | sed 's/^/  - /'
   echo
   echo "Run: df-theme-remove <name>"
   exit 0
fi

KIND=""
while IFS=$'\t' read -r _ name dir kind; do
   if [[ $name == "$NAME" ]]; then
      THEME_PATH="$dir"
      KIND="$kind"
   fi
done < <("$DOTFILES_DIR/bin/df-theme-list" --installed)

if [[ -z $KIND ]]; then
   echo "Error: theme '$NAME' is not installed" >&2
   exit 1
fi

if [[ $KIND == builtin ]]; then
   echo "Error: '$NAME' is a built-in theme." >&2
   echo "       Edit themes/builtin/$NAME in the repo instead." >&2
   exit 1
fi

# Refuse to remove the active theme
if [[ -L $THEME_LINK ]]; then
   current="$(basename "$(readlink "$THEME_LINK")")"
   if [[ $current == "$NAME" ]]; then
      echo "Error: '$NAME' is the active theme." >&2
      echo "       Switch first:  df-theme-set default" >&2
      exit 1
   fi
fi

if (( !FORCE )); then
   read -r -p "Remove theme '$NAME'? [y/N] " ans
   case "$ans" in
      y|Y|yes|YES) ;;
      *) echo "Aborted."; exit 0 ;;
   esac
fi

if [[ $KIND == pack ]]; then
   "$DOTFILES_DIR/bin/df-theme-fetch" --drop "$NAME"
else
   rm -rf "$THEME_PATH"
   # Copied in by df-theme-install. A pack theme's images belong to the
   # backgrounds repo instead.
   rm -f "$BG_DIR/$NAME".* "$BG_DIR/$NAME"-*.* 2>/dev/null || true
   rm -f "$PREVIEW_DIR/$NAME".* 2>/dev/null || true
fi

echo "Removed: $NAME"
