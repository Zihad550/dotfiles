#!/bin/bash

# Quickshell config launches are single-instance; legacy names select dotfiles.

set -e

if ! command -v quickshell &>/dev/null; then
   echo "Error: quickshell not found" >&2
   exit 1
fi

canonical_config() {
   case "$1" in
      launcher | lock) echo dotfiles ;;
      *) echo "$1" ;;
   esac
}

args=("$@")
prev=""
LAUNCH_CONFIG=""
for index in "${!args[@]}"; do
   arg="${args[$index]}"
   if [[ "$prev" == -c || "$prev" == --config ]]; then
      arg=$(canonical_config "$arg")
      LAUNCH_CONFIG="$arg"
   elif [[ "$arg" == --config=* ]]; then
      LAUNCH_CONFIG=$(canonical_config "${arg#--config=}")
      arg="--config=$LAUNCH_CONFIG"
   fi
   args[index]="$arg"
   prev="$arg"
done
set -- "${args[@]}"

CONFIG_SELECTED=0
NO_DUPLICATE=0
prev=""
for arg in "$@"; do
   case "$arg" in
      log | list | kill | msg | ipc)
         # Quickshell 0.3.0's full subcommand set. Each addresses an instance
         # that is already running, so -n is meaningless for them. A config
         # name is passed as the value of -c and may itself be one of these
         # words, so only a bare positional counts.
         if [ "$prev" != "-c" ] && [ "$prev" != "--config" ]; then
            exec quickshell "$@"
         fi
         ;;
      -n | --no-duplicate)
         NO_DUPLICATE=1
         ;;
      -c | --config | --config=*)
         CONFIG_SELECTED=1
         ;;
   esac
   prev="$arg"
done

# Without a config there is nothing to be a duplicate of -- `qs -p file.qml`,
# `qs --help`, `qs -V` all pass through unchanged.
if (( ! CONFIG_SELECTED )); then
   exec quickshell "$@"
fi

# df-qs-launch owns the Shared Shell's launch, with supervision and its environment.
if [[ "$LAUNCH_CONFIG" == dotfiles ]]; then
   echo "Start the Shared Shell with df-qs-restart" >&2
   exit 1
fi

if (( NO_DUPLICATE )); then
   exec quickshell "$@"
fi
exec quickshell "$@" -n
